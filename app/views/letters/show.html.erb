<div class="max-w-7xl mx-auto py-4 font-ui animate-fade-in text-base-content">
  <% if @countdown %>
    <div class="max-w-xl mx-auto py-8">
      <div class="paper-sheet rounded-xs p-8 sm:p-12 text-center space-y-7 border border-[#D8D2C2] dark:border-[#2D3340]">
        <div class="wax-seal w-24 h-24 rounded-full mx-auto flex items-center justify-center text-[#F8F7F2] select-none">
          <%= tabler_icon("lock", size: 36) %>
        </div>

        <div class="space-y-2">
          <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight"><%= t('letters.show_locked_title') %></h1>
          <p class="text-xs font-letter text-base-content/60 max-w-sm mx-auto leading-relaxed">
            <%= t('letters.show_locked_desc', email: @letter.email) %>
          </p>
        </div>

        <div class="space-y-3">
          <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-widest block font-letter"><%= t('letters.show_time_remaining') %></span>
          <div class="postmark-stamp text-2xl font-letter py-2.5 px-6">
            <%= @letter.days_left_text %>
          </div>
          <p class="text-xs font-letter text-base-content/50">
            <%= t('letters.deliver_date_prefix') %> <%= @letter.formatted_deliver_at %>
          </p>
        </div>

        <div class="pt-4 border-t border-[#D8D2C2] dark:border-[#2D3340] flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="<%= dashboard_path %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs px-5 text-xs font-medium uppercase tracking-wider font-letter inline-flex items-center gap-1.5 min-h-[38px]">
            <%= tabler_icon("arrow-left", size: 14) %>
            <span><%= t('letters.back_to_vault') %></span>
          </a>
          <%= button_to letter_path(@letter),
              method: :delete,
              class: "btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content/65 hover:text-[#2C485E] dark:hover:text-[#77A3C4] hover:border-[#2C485E]/40 dark:hover:border-[#77A3C4]/40 hover:bg-[#2C485E]/5 rounded-xs px-4 text-xs font-medium uppercase tracking-wider font-letter inline-flex items-center gap-1.5 min-h-[38px] transition-colors cursor-pointer",
              data: { turbo_confirm: t('letters.confirm_archive') },
              aria: { label: t('letters.btn_archive') } do %>
            <%= tabler_icon("archive", size: 14) %>
            <span><%= t('letters.btn_archive') %></span>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <% if @letter.reveal_happiness.nil? && user_signed_in? && @letter.email == current_user_email %>
      <%= form_with url: update_predictions_letter_path(@letter), method: :post, local: true, class: "space-y-8" do |f| %>
        <div style="display: none;"><%= @letter.content %></div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

          <div class="lg:col-span-4 paper-sheet rounded-xs p-6 sm:p-8 text-center space-y-6 border border-[#D8D2C2] dark:border-[#2D3340]">
            <div class="space-y-2">
              <span class="postmark-stamp text-[10px] py-0.5 px-2.5">
                <%= t('letters.unlocked_badge') %>
              </span>
              <h2 class="font-serif-editorial text-2xl font-semibold text-base-content leading-snug">
                <%= t('letters.show_unlocked_title') %>
              </h2>
              <p class="text-xs font-letter text-base-content/60 leading-relaxed">
                <%= t('letters.show_unlocked_desc') %>
              </p>
            </div>

            <div class="my-6 relative select-none flex items-center justify-center h-32">
              <div class="relative flex items-center justify-center">
                <div class="wax-seal w-20 h-20 rounded-full flex items-center justify-center text-[#F8F7F2] animate-seal-left">
                  <%= tabler_icon("lock-open", size: 28) %>
                </div>
                <div class="wax-seal w-20 h-20 rounded-full flex items-center justify-center text-[#F8F7F2] -ml-6 animate-seal-right">
                  <%= tabler_icon("sparkles", size: 28) %>
                </div>
              </div>
            </div>

            <div class="archival-folder rounded-xs p-4 text-xs font-letter text-base-content/70 space-y-1 text-left">
              <p class="font-semibold uppercase tracking-wider text-[10px] text-base-content/90"><%= t('letters.reflection_tip') %></p>
              <p class="leading-relaxed"><%= t('letters.reflection_tip_text') %></p>
            </div>
          </div>

          <div id="questions_section" class="lg:col-span-5 archival-folder rounded-xs p-6 sm:p-8 space-y-6 border border-[#D5CEBD] dark:border-[#2D3342]">
            <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-3">
              <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('letters.fact_matching') %></span>
              <h3 class="font-serif-editorial text-xl font-semibold text-base-content mt-0.5"><%= t('letters.tell_reality_title') %></h3>
              <p class="text-xs font-letter text-base-content/60 mt-1"><%= t('letters.tell_reality_desc') %></p>
            </div>

            <div class="space-y-4">
              <% @letter.predictions.each do |pred| %>
                <div class="paper-sheet rounded-xs p-4 space-y-3 border border-[#D8D2C2] dark:border-[#2D3340]">
                  <label class="text-xs font-semibold text-base-content/85 flex items-center gap-2 font-letter">
                    <% case pred.category %>
                    <% when 'city' %>
                      <span><%= t('letters.question_where_do_you_live') %></span>
                    <% when 'career' %>
                      <span><%= t('letters.question_what_do_you_do') %></span>
                    <% when 'salary' %>
                      <span><%= t('letters.question_how_much_do_you_earn') %></span>
                    <% when 'relationship' %>
                      <span><%= t('letters.question_how_is_your_relationship') %></span>
                    <% when 'achievement' %>
                      <span><%= t('letters.question_what_was_your_achievement') %></span>
                    <% when 'happiness' %>
                      <span><%= t('letters.question_how_happy_are_you') %></span>
                    <% else %>
                      <span><%= t('letters.question_what_happened_with', category: pred.category.titleize) %></span>
                    <% end %>
                  </label>

                  <div class="text-xs text-base-content/60 italic font-letter bg-base-200/40 px-3 py-1.5 rounded-xs border border-[#D8D2C2]/50 dark:border-[#2D3340]">
                    <%= t('letters.your_past_prediction', text: pred.prediction) %>
                  </div>

                  <% if pred.category == 'happiness' %>
                    <div class="space-y-2 pt-1 font-letter text-xs">
                      <div class="flex justify-between font-semibold text-base-content/80">
                        <span><%= t('letters.your_current_level') %></span>
                        <span id="reality_happiness_pred_lbl">7 / 10</span>
                      </div>
                      <%= range_field_tag "predictions[#{pred.id}][reality]", 7, min: 1, max: 10, class: "range range-xs cursor-pointer w-full accent-[#8E2818]", oninput: "document.getElementById('reality_happiness_pred_lbl').innerText = this.value + ' / 10'" %>
                      <%= hidden_field_tag "predictions[#{pred.id}][matched]", "1" %>
                    </div>
                  <% else %>
                    <div class="space-y-2.5 font-letter text-xs">
                      <%= text_field_tag "predictions[#{pred.id}][reality]", nil, placeholder: t('letters.placeholder_reality'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/30 focus:border-[#8E2818] focus:outline-none", required: true %>

                      <div class="space-y-1.5">
                        <label class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wider block"><%= t('letters.did_prediction_come_true') %></label>
                        <div class="grid grid-cols-2 gap-2">
                          <label class="cursor-pointer flex">
                            <%= radio_button_tag "predictions[#{pred.id}][matched]", "1", true, class: "peer sr-only" %>
                            <div class="w-full text-center py-2 px-3 rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] bg-base-200/30 text-xs font-semibold text-base-content/70 peer-checked:bg-[#2C485E] peer-checked:text-[#FAF9F5] peer-checked:border-[#2C485E] transition-all font-letter inline-flex items-center justify-center gap-1.5">
                              <%= tabler_icon("check", size: 13) %>
                              <span><%= t('letters.yes_i_did_it') %></span>
                            </div>
                          </label>
                          <label class="cursor-pointer flex">
                            <%= radio_button_tag "predictions[#{pred.id}][matched]", "0", false, class: "peer sr-only" %>
                            <div class="w-full text-center py-2 px-3 rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] bg-base-200/30 text-xs font-semibold text-base-content/70 peer-checked:bg-[#8E2818] peer-checked:text-[#FAF9F5] peer-checked:border-[#8E2818] transition-all font-letter inline-flex items-center justify-center gap-1.5">
                              <%= tabler_icon("x", size: 13) %>
                              <span><%= t('letters.not_exactly') %></span>
                            </div>
                          </label>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="lg:col-span-3 space-y-6">
            <div class="archival-folder rounded-xs p-6 space-y-5 border border-[#D5CEBD] dark:border-[#2D3342]">
              <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-3">
                <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('letters.current_state_badge') %></span>
                <h3 class="font-serif-editorial text-lg font-semibold text-base-content mt-0.5"><%= t('letters.emotional_snapshot_heading') %></h3>
                <p class="text-xs font-letter text-base-content/60 mt-1"><%= t('letters.feeling_now_short') %></p>
              </div>

              <div class="space-y-4 font-letter text-xs">
                <div class="space-y-1">
                  <div class="flex justify-between items-center font-semibold text-base-content/80">
                    <span><%= t('letters.emotion_happiness') %></span>
                    <span id="reveal_happiness_lbl">5 / 10</span>
                  </div>
                  <%= f.range_field :reveal_happiness, min: 1, max: 10, value: 5, class: "range range-xs cursor-pointer w-full accent-[#8E2818]", oninput: "document.getElementById('reveal_happiness_lbl').innerText = this.value + ' / 10'" %>
                </div>

                <div class="space-y-1">
                  <div class="flex justify-between items-center font-semibold text-base-content/80">
                    <span><%= t('letters.emotion_anxiety') %></span>
                    <span id="reveal_anxiety_lbl">5 / 10</span>
                  </div>
                  <%= f.range_field :reveal_anxiety, min: 1, max: 10, value: 5, class: "range range-xs cursor-pointer w-full accent-[#8E2818]", oninput: "document.getElementById('reveal_anxiety_lbl').innerText = this.value + ' / 10'" %>
                </div>

                <div class="space-y-1">
                  <div class="flex justify-between items-center font-semibold text-base-content/80">
                    <span><%= t('letters.emotion_motivation') %></span>
                    <span id="reveal_motivation_lbl">5 / 10</span>
                  </div>
                  <%= f.range_field :reveal_motivation, min: 1, max: 10, value: 5, class: "range range-xs cursor-pointer w-full accent-[#8E2818]", oninput: "document.getElementById('reveal_motivation_lbl').innerText = this.value + ' / 10'" %>
                </div>
              </div>
            </div>

            <%= f.button class: "btn w-full bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase border-none cursor-pointer min-h-[46px] shadow-xs font-letter inline-flex items-center justify-center gap-2" do %>
              <%= tabler_icon("lock-open", size: 16) %>
              <span><%= t('letters.save_and_view') %></span>
            <% end %>
          </div>

        </div>
      <% end %>

    <% else %>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <div class="lg:col-span-8 space-y-6">
          <div class="paper-sheet rounded-xs p-6 sm:p-10 space-y-6 border border-[#D8D2C2] dark:border-[#2D3340]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-4 text-xs font-letter">
              <div>
                <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/50"><%= t('letters.show_written') %></p>
                <p class="font-semibold text-base-content text-xs"><%= @letter.formatted_created_at %></p>
              </div>
              <div class="text-center">
                <span class="postmark-stamp text-[10px] py-0.5 px-2.5"><%= t('letters.past_letter') %></span>
              </div>
              <div class="sm:text-right">
                <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/50"><%= t('letters.show_delivered') %></p>
                <p class="font-semibold text-base-content text-xs"><%= @letter.formatted_delivered_at %></p>
              </div>
            </div>

            <article class="p-5 sm:p-6 border border-[#D8D2C2] dark:border-[#2D3340] rounded-xs bg-transparent text-base-content/90 min-h-[300px] whitespace-pre-wrap select-text font-letter text-sm leading-loose shadow-inner">
              <%= @letter.content %>
            </article>

            <div class="pt-4 border-t border-[#D8D2C2] dark:border-[#2D3340] flex justify-between items-center text-xs font-letter">
              <a href="<%= dashboard_path %>" class="hover:text-base-content text-base-content/60 transition-colors flex items-center gap-1.5 font-semibold uppercase tracking-wider">
                <%= tabler_icon("arrow-left", size: 14) %>
                <span><%= t('letters.back_to_vault') %></span>
              </a>
            </div>
          </div>

          <% if @letter.predictions.any? %>
            <div class="archival-folder rounded-xs p-6 sm:p-8 space-y-5 border border-[#D5CEBD] dark:border-[#2D3342]">
              <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-3">
                <h2 class="font-serif-editorial text-xl font-semibold text-base-content"><%= t('letters.predictions_vs_reality') %></h2>
                <p class="text-xs font-letter text-base-content/60 mt-1"><%= t('letters.predictions_vs_reality_desc') %></p>
              </div>

              <div class="space-y-4">
                <% @letter.decorated_predictions.each do |pred| %>
                  <div class="paper-sheet rounded-xs overflow-hidden border border-[#D8D2C2] dark:border-[#2D3340]">
                    <div class="bg-base-200/40 px-4 py-2.5 flex justify-between items-center border-b border-[#D8D2C2] dark:border-[#2D3340] font-letter">
                      <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/80">
                        <%= pred.category_label %>
                      </span>

                      <span class="<%= pred.result_badge_class %> py-0.5 px-2 text-[10px] font-semibold uppercase tracking-wider rounded-xs inline-flex items-center gap-1">
                        <% if pred.matched? %>
                          <%= tabler_icon("check", size: 12) %>
                        <% else %>
                          <%= tabler_icon("x", size: 12) %>
                        <% end %>
                        <span><%= pred.result_badge %></span>
                      </span>
                    </div>

                    <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[#D8D2C2] dark:divide-[#2D3340] font-letter text-xs">
                      <div class="p-4 space-y-1">
                        <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wider block"><%= t('letters.past_prediction_label') %></span>
                        <p class="text-base-content/80 leading-relaxed italic">
                          "<%= pred.prediction %>"
                        </p>
                      </div>

                      <div class="p-4 space-y-1 bg-base-200/10">
                        <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wider block"><%= t('letters.reality_today_label') %></span>
                        <p class="text-base-content/90 leading-relaxed font-semibold">
                          "<%= pred.reality %>"
                        </p>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="lg:col-span-4 space-y-6">

          <div class="paper-sheet rounded-xs p-6 space-y-4 text-center border border-[#D8D2C2] dark:border-[#2D3340]">
            <div class="border-b border-[#D8D2C2] dark:border-[#2D3340] pb-2.5">
              <h3 class="font-serif-editorial text-lg font-semibold text-base-content"><%= t('letters.prediction_score_title') %></h3>
            </div>

            <% if @letter.predictions.any? %>
              <% matched = @letter.predictions.matched.count %>
              <% total = @letter.predictions.count %>
              <% pct = ((matched.to_f / total) * 100).round %>

              <div class="relative w-32 h-32 mx-auto flex items-center justify-center my-2">
                <div class="radial-progress text-[#2C485E] dark:text-[#77A3C4] font-letter text-2xl font-bold"
                     style="--value:<%= pct %>; --size:8rem; --thickness: 8px;"
                     role="progressbar"
                     aria-valuenow="<%= pct %>"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-label="<%= t('letters.prediction_score_title') %>: <%= pct %>%">
                  <%= pct %>%
                </div>
              </div>

              <div class="space-y-1 text-xs font-letter">
                <p class="font-semibold text-base-content"><%= t('letters.matched_predictions_count', matched: matched, total: total, pct: pct) %></p>
                <p class="text-base-content/60 leading-relaxed max-w-xs mx-auto">
                  <% if pct >= 70 %>
                    <%= t('letters.score_message_high') %>
                  <% elsif pct >= 40 %>
                    <%= t('letters.score_message_medium') %>
                  <% else %>
                    <%= t('letters.score_message_low') %>
                  <% end %>
                </p>
              </div>
            <% else %>
              <p class="text-xs font-letter text-base-content/50 py-3"><%= t('letters.no_predictions_registered') %></p>
            <% end %>
          </div>

          <div class="archival-folder rounded-xs p-6 space-y-5 border border-[#D5CEBD] dark:border-[#2D3342]">
            <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-2.5">
              <h3 class="font-serif-editorial text-lg font-semibold text-base-content"><%= t('letters.emotional_evolution') %></h3>
              <p class="text-[10px] font-letter text-base-content/50 uppercase tracking-wider mt-0.5"><%= t('letters.internal_wellbeing_change') %></p>
            </div>

            <% if @letter.emotional_snapshot.present? %>
              <div class="space-y-4 font-letter text-xs">
                <div class="paper-sheet p-3 rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-base-content"><%= t('letters.emotion_happiness') %></span>
                    <% hap_shift = @letter.reveal_happiness.to_i - @letter.emotional_snapshot.happiness_level.to_i %>
                    <% if hap_shift > 0 %>
                      <span class="text-[10px] font-semibold text-[#2C485E] dark:text-[#77A3C4]">+<%= hap_shift %> <%= t('letters.growth') %></span>
                    <% elsif hap_shift < 0 %>
                      <span class="text-[10px] font-semibold text-[#8E2818]"><%= hap_shift %> <%= t('letters.decline_label') %></span>
                    <% else %>
                      <span class="text-[10px] text-base-content/50"><%= t('letters.steady_status') %></span>
                    <% end %>
                  </div>
                  <div class="flex justify-between text-[11px] text-base-content/60">
                    <span><%= t('letters.past_label') %> <strong><%= @letter.emotional_snapshot.happiness_level %></strong></span>
                    <span>&rarr;</span>
                    <span><%= t('letters.today_label') %> <strong><%= @letter.reveal_happiness %></strong></span>
                  </div>
                </div>

                <div class="paper-sheet p-3 rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-base-content"><%= t('letters.emotion_anxiety') %></span>
                    <% anx_shift = @letter.reveal_anxiety.to_i - @letter.emotional_snapshot.anxiety_level.to_i %>
                    <% if anx_shift < 0 %>
                      <span class="text-[10px] font-semibold text-[#2C485E] dark:text-[#77A3C4]"><%= anx_shift %> <%= t('letters.calm_label') %></span>
                    <% elsif anx_shift > 0 %>
                      <span class="text-[10px] font-semibold text-[#8E2818]">+<%= anx_shift %> <%= t('letters.stress_label') %></span>
                    <% else %>
                      <span class="text-[10px] text-base-content/50"><%= t('letters.steady_label') %></span>
                    <% end %>
                  </div>
                  <div class="flex justify-between text-[11px] text-base-content/60">
                    <span><%= t('letters.past_label') %> <strong><%= @letter.emotional_snapshot.anxiety_level %></strong></span>
                    <span>&rarr;</span>
                    <span><%= t('letters.today_label') %> <strong><%= @letter.reveal_anxiety %></strong></span>
                  </div>
                </div>

                <div class="paper-sheet p-3 rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-base-content"><%= t('letters.emotion_motivation') %></span>
                    <% mot_shift = @letter.reveal_motivation.to_i - @letter.emotional_snapshot.motivation_level.to_i %>
                    <% if mot_shift > 0 %>
                      <span class="text-[10px] font-semibold text-[#2C485E] dark:text-[#77A3C4]">+<%= mot_shift %> <%= t('letters.inspired_label') %></span>
                    <% elsif mot_shift < 0 %>
                      <span class="text-[10px] font-semibold text-[#8E2818]"><%= mot_shift %> <%= t('letters.decline_label') %></span>
                    <% else %>
                      <span class="text-[10px] text-base-content/50"><%= t('letters.steady_label') %></span>
                    <% end %>
                  </div>
                  <div class="flex justify-between text-[11px] text-base-content/60">
                    <span><%= t('letters.past_label') %> <strong><%= @letter.emotional_snapshot.motivation_level %></strong></span>
                    <span>&rarr;</span>
                    <span><%= t('letters.today_label') %> <strong><%= @letter.reveal_motivation %></strong></span>
                  </div>
                </div>
              </div>
            <% else %>
              <span class="text-xs font-letter text-base-content/50"><%= t('letters.no_emotional_data') %></span>
            <% end %>
          </div>

          <div class="paper-sheet rounded-xs p-5 space-y-3 border border-[#D8D2C2] dark:border-[#2D3340] text-center">
            <h4 class="font-serif-editorial text-base font-semibold text-base-content"><%= t('letters.whats_next') %></h4>
            <p class="text-xs font-letter text-base-content/60 leading-relaxed"><%= t('letters.whats_next_desc') %></p>
