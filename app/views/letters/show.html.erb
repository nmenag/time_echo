<div class="max-w-3xl mx-auto py-6">
  <% if @countdown %>
    <!-- Locked Capsule / Countdown View using DaisyUI components -->
    <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-12 rounded-box text-center space-y-8 shadow-xs animate-fade-in">
      <div class="relative w-24 h-24 mx-auto select-none">
        <div class="absolute inset-0 bg-secondary rounded-full border border-accent flex items-center justify-center text-4xl shadow-inner">
          🔒
        </div>
        <div class="absolute -bottom-1 -right-1 bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 border-white animate-bounce">
          ⌛
        </div>
      </div>

      <div class="space-y-3">
        <h1 class="font-serif italic text-3xl text-primary font-normal"><%= t('letters.show_locked_title') %></h1>
        <p class="text-sm text-base-content/60 max-w-sm mx-auto leading-relaxed font-sans">
          <%= t('letters.show_locked_desc', email: @letter.email) %>
        </p>
      </div>

      <% days_left = (@letter.deliver_at.to_date - Date.current).to_i %>
      <div class="space-y-2">
        <span class="text-[10px] font-semibold text-base-content/40 uppercase tracking-wider block"><%= t('letters.show_opening_in') %></span>
        <div class="inline-block px-6 py-3 bg-secondary/50 border border-accent text-primary rounded-2xl font-serif italic text-3xl font-semibold tracking-wide">
          <%= days_left == 1 ? "1 día" : "#{days_left} días" %>
        </div>
        <p class="text-xs text-base-content/40 pt-1"><%= t('letters.show_target_date', date: @letter.deliver_at.strftime('%B %d, %Y')) %></p>
      </div>

      <div class="pt-6 border-t border-base-200">
        <a href="<%= root_path %>" class="btn btn-primary rounded-xl px-6 text-xs font-semibold uppercase tracking-wider shadow-xs">
          <%= t('letters.show_btn_dashboard') %>
        </a>
      </div>
    </div>

  <% else %>
    <!-- Unlocked / Delivered Letter View using DaisyUI components -->
    <div class="space-y-8">
      <div class="card card-bordered border-base-200 bg-base-100 rounded-box p-8 sm:p-12 shadow-xs space-y-8 animate-fade-in">
        <!-- Letter Header with dual timestamps and Title -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-base-200 pb-6 text-xs text-base-content/50">
          <div class="space-y-1">
            <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/40"><%= t('letters.show_written') %></p>
            <p class="font-serif italic text-sm text-primary font-normal"><%= @letter.created_at.strftime('%B %d, %Y') %></p>
          </div>
          <div class="space-y-1 text-center">
            <h1 class="font-serif text-2xl text-primary font-normal italic"><%= @letter.title %></h1>
          </div>
          <div class="space-y-1 sm:text-right">
            <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/40"><%= t('letters.show_delivered') %></p>
            <p class="font-serif italic text-sm text-primary font-normal"><%= @letter.delivered_at.strftime('%B %d, %Y') %></p>
          </div>
        </div>

        <!-- Letter Body with the high-fidelity writing-canvas font styling -->
        <article class="font-serif text-lg text-primary leading-relaxed whitespace-pre-wrap select-text writing-canvas">
          <%= @letter.content %>
        </article>

        <!-- Letter Actions / Footer -->
        <div class="pt-8 border-t border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-base-content/50">
          <div>
            <span>👁️ <%= @letter.open_count == 1 ? t('letters.show_read_count', count: 1) : t('letters.show_read_count_plural', count: @letter.open_count) %></span>
          </div>

          <div class="flex gap-4 font-sans">
            <% if user_signed_in? && @letter.email == current_user_email %>
              <a href="<%= dashboard_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral p-0 font-semibold no-underline flex items-center gap-1">
                <%= t('letters.show_back_timeline').html_safe %>
              </a>
            <% else %>
              <a href="<%= public_feed_letters_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral p-0 font-semibold no-underline flex items-center gap-1">
                <%= t('letters.show_back_public').html_safe %>
              </a>
            <% end %>
          </div>
        </div>
      </div>

      <!-- MAIN MVP DIFFERENTIATOR SECTION -->
      <% if user_signed_in? && @letter.email == current_user_email %>
        <% if @letter.reveal_happiness.nil? %>
          <!-- Interactive Reveal Form if reality hasn't been completed yet -->
          <div class="card card-bordered border-base-200 bg-base-100 rounded-box p-8 sm:p-10 shadow-xs space-y-6 border-l-4 border-accent animate-fade-in">
            <div class="border-b border-base-200 pb-4 space-y-1">
              <span class="badge badge-accent py-2 px-3 text-[10px] font-bold tracking-wider uppercase"><%= t('letters.future_integration') %></span>
              <h2 class="font-serif italic text-2xl text-primary font-normal"><%= t('letters.bridge_past_present') %></h2>
              <p class="text-xs text-base-content/50"><%= t('letters.future_integration_help') %></p>
            </div>

            <%= form_with url: update_predictions_letter_path(@letter), method: :post, local: true, class: "space-y-8" do |f| %>
              <!-- TODAY'S EMOTIONAL SNAPSHOT -->
              <div class="space-y-5">
                <h3 class="font-serif italic text-lg text-primary flex items-center gap-2"><%= t('letters.feel_today') %></h3>
                <p class="text-xs text-base-content/50"><%= t('letters.feel_today_help') %></p>
                
                <div class="grid sm:grid-cols-3 gap-6">
                  <!-- Happiness Level -->
                  <div class="bg-base-200/30 p-4 rounded-xl border border-base-200/50 space-y-2">
                    <div class="flex justify-between items-center">
                      <span class="text-[10px] font-bold text-primary uppercase tracking-wider"><%= t('letters.happiness') %></span>
                      <span id="reveal_happiness_val" class="badge badge-primary font-bold text-[10px] py-1.5 px-2">5/10</span>
                    </div>
                    <%= f.range_field :reveal_happiness, min: 1, max: 10, value: 5, class: "range range-primary range-xs", oninput: "document.getElementById('reveal_happiness_val').innerText = this.value + '/10'" %>
                  </div>

                  <!-- Anxiety Level -->
                  <div class="bg-base-200/30 p-4 rounded-xl border border-base-200/50 space-y-2">
                    <div class="flex justify-between items-center">
                      <span class="text-[10px] font-bold text-primary uppercase tracking-wider"><%= t('letters.anxiety') %></span>
                      <span id="reveal_anxiety_val" class="badge badge-secondary font-bold text-[10px] py-1.5 px-2">5/10</span>
                    </div>
                    <%= f.range_field :reveal_anxiety, min: 1, max: 10, value: 5, class: "range range-secondary range-xs", oninput: "document.getElementById('reveal_anxiety_val').innerText = this.value + '/10'" %>
                  </div>

                  <!-- Motivation Level -->
                  <div class="bg-base-200/30 p-4 rounded-xl border border-base-200/50 space-y-2">
                    <div class="flex justify-between items-center">
                      <span class="text-[10px] font-bold text-primary uppercase tracking-wider"><%= t('letters.motivation') %></span>
                      <span id="reveal_motivation_val" class="badge badge-accent font-bold text-[10px] py-1.5 px-2">5/10</span>
                    </div>
                    <%= f.range_field :reveal_motivation, min: 1, max: 10, value: 5, class: "range range-accent range-xs", oninput: "document.getElementById('reveal_motivation_val').innerText = this.value + '/10'" %>
                  </div>
                </div>
              </div>

              <!-- PREDICTIONS VS REALITY UPDATE -->
              <% if @letter.predictions.any? %>
                <div class="space-y-5 pt-6 border-t border-base-200">
                  <h3 class="font-serif italic text-lg text-primary flex items-center gap-2"><%= t('letters.what_happened_predictions') %></h3>
                  <p class="text-xs text-base-content/50"><%= t('letters.what_happened_predictions_help') %></p>
                  
                  <div class="space-y-4">
                    <% @letter.predictions.each do |pred| %>
                      <div class="p-5 bg-base-200/20 border border-base-200 rounded-2xl space-y-4">
                        <div class="flex items-center justify-between border-b border-base-200 pb-2">
                          <span class="badge badge-outline py-2 px-3 text-[10px] font-mono font-bold uppercase tracking-wider text-base-content/50"><%= pred.category %></span>
                          <span class="text-xs text-base-content/60 italic font-serif">"<%= pred.prediction %>"</span>
                        </div>
                        
                        <div class="grid sm:grid-cols-3 gap-4 items-center">
                          <div class="sm:col-span-2">
                            <%= text_field_tag "predictions[#{pred.id}][reality]", nil, placeholder: t('letters.placeholder_reality'), class: "input input-bordered input-sm w-full rounded-xl focus:border-neutral/30 focus:outline-none bg-white text-sm", required: true %>
                          </div>
                          <div class="form-control">
                            <label class="label cursor-pointer justify-start gap-2.5 p-0">
                              <%= checkbox_tag "predictions[#{pred.id}][matched]", "1", false, class: "checkbox checkbox-primary checkbox-xs rounded-md" %>
                              <span class="label-text text-xs font-semibold text-primary"><%= t('letters.prediction_came_true') %></span>
                            </label>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <div class="pt-6 border-t border-base-200 flex justify-end">
                <%= f.submit t('letters.btn_reveal_dashboard'), class: "btn btn-primary btn-md rounded-xl text-xs font-semibold uppercase tracking-wider shadow-xs px-6" %>
              </div>
            <% end %>
          </div>

        <% else %>
          <!-- Comparison Dashboard once reality is updated -->
          <div class="card card-bordered border-base-200 bg-base-100 rounded-box p-8 sm:p-10 shadow-xs space-y-10 animate-fade-in">
            <div class="border-b border-base-200 pb-4 space-y-1">
              <span class="badge badge-primary py-2 px-3 text-[10px] font-bold tracking-wider uppercase"><%= t('letters.reflection_matrix') %></span>
              <h2 class="font-serif italic text-2xl text-primary font-normal"><%= t('letters.personal_evolution') %></h2>
              <p class="text-xs text-base-content/50"><%= t('letters.personal_evolution_help', date: I18n.l(@letter.created_at, format: :long)) %></p>
            </div>

            <!-- Emotional Evolution Widgets -->
            <div class="space-y-6">
              <h3 class="font-serif italic text-lg text-primary flex items-center gap-2"><%= t('letters.emotional_snapshot_shifts') %></h3>
              
              <div class="grid md:grid-cols-3 gap-6">
                <!-- Happiness Card -->
                <div class="card card-bordered border-base-200 bg-base-50/50 p-5 rounded-2xl shadow-2xs space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-primary uppercase tracking-wider"><%= t('letters.happiness') %></span>
                    <% happiness_delta = @letter.reveal_happiness.to_i - @letter.emotional_snapshot.happiness_level.to_i %>
                    <% if happiness_delta > 0 %>
                      <span class="badge badge-success font-bold text-[9px] py-1.5 px-2">+<%= happiness_delta %> <%= t('letters.growth') %></span>
                    <% elsif happiness_delta < 0 %>
                      <span class="badge badge-error font-bold text-[9px] py-1.5 px-2"><%= happiness_delta %> <%= t('letters.shift') %></span>
                    <% else %>
                      <span class="badge badge-outline font-bold text-[9px] py-1.5 px-2 text-base-content/50 font-sans"><%= t('letters.steady_status') %></span>
                    <% end %>
                  </div>

                  <div class="space-y-3 font-sans">
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.past_self') %></span>
                        <span class="font-bold"><%= @letter.emotional_snapshot.happiness_level %>/10</span>
                      </div>
                      <progress class="progress progress-primary w-full h-1.5" value="<%= @letter.emotional_snapshot.happiness_level %>" max="10"></progress>
                    </div>
                    
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.present_self') %></span>
                        <span class="font-bold"><%= @letter.reveal_happiness %>/10</span>
                      </div>
                      <progress class="progress progress-accent w-full h-1.5" value="<%= @letter.reveal_happiness %>" max="10"></progress>
                    </div>
                  </div>
                </div>

                <!-- Anxiety Card -->
                <div class="card card-bordered border-base-200 bg-base-50/50 p-5 rounded-2xl shadow-2xs space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-primary uppercase tracking-wider"><%= t('letters.anxiety') %></span>
                    <% anxiety_delta = @letter.reveal_anxiety.to_i - @letter.emotional_snapshot.anxiety_level.to_i %>
                    <% if anxiety_delta < 0 %>
                      <span class="badge badge-success font-bold text-[9px] py-1.5 px-2"><%= anxiety_delta %> <%= t('letters.calmer') %></span>
                    <% elsif anxiety_delta > 0 %>
                      <span class="badge badge-warning font-bold text-[9px] py-1.5 px-2">+<%= anxiety_delta %> <%= t('letters.stress') %></span>
                    <% else %>
                      <span class="badge badge-outline font-bold text-[9px] py-1.5 px-2 text-base-content/50 font-sans"><%= t('letters.steady_status') %></span>
                    <% end %>
                  </div>

                  <div class="space-y-3 font-sans">
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.past_self') %></span>
                        <span class="font-bold"><%= @letter.emotional_snapshot.anxiety_level %>/10</span>
                      </div>
                      <progress class="progress progress-secondary w-full h-1.5" value="<%= @letter.emotional_snapshot.anxiety_level %>" max="10"></progress>
                    </div>
                    
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.present_self') %></span>
                        <span class="font-bold"><%= @letter.reveal_anxiety %>/10</span>
                      </div>
                      <progress class="progress progress-accent w-full h-1.5" value="<%= @letter.reveal_anxiety %>" max="10"></progress>
                    </div>
                  </div>
                </div>

                <!-- Motivation Card -->
                <div class="card card-bordered border-base-200 bg-base-50/50 p-5 rounded-2xl shadow-2xs space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-primary uppercase tracking-wider"><%= t('letters.motivation') %></span>
                    <% motivation_delta = @letter.reveal_motivation.to_i - @letter.emotional_snapshot.motivation_level.to_i %>
                    <% if motivation_delta > 0 %>
                      <span class="badge badge-success font-bold text-[9px] py-1.5 px-2">+<%= motivation_delta %> <%= t('letters.inspired') %></span>
                    <% elsif motivation_delta < 0 %>
                      <span class="badge badge-error font-bold text-[9px] py-1.5 px-2"><%= motivation_delta %> <%= t('letters.shift') %></span>
                    <% else %>
                      <span class="badge badge-outline font-bold text-[9px] py-1.5 px-2 text-base-content/50 font-sans"><%= t('letters.steady_status') %></span>
                    <% end %>
                  </div>

                  <div class="space-y-3 font-sans">
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.past_self') %></span>
                        <span class="font-bold"><%= @letter.emotional_snapshot.motivation_level %>/10</span>
                      </div>
                      <progress class="progress progress-accent w-full h-1.5" value="<%= @letter.emotional_snapshot.motivation_level %>" max="10"></progress>
                    </div>
                    
                    <div>
                      <div class="flex justify-between text-[10px] text-base-content/40 mb-1">
                        <span><%= t('letters.present_self') %></span>
                        <span class="font-bold"><%= @letter.reveal_motivation %>/10</span>
                      </div>
                      <progress class="progress progress-primary w-full h-1.5" value="<%= @letter.reveal_motivation %>" max="10"></progress>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Predictions vs Reality Cards -->
            <% if @letter.predictions.any? %>
              <div class="space-y-6 pt-6 border-t border-base-200">
                <h3 class="font-serif italic text-lg text-primary flex items-center gap-2"><%= t('letters.predictions_vs_reality_grid') %></h3>
                
                <div class="grid gap-6">
                  <% @letter.predictions.each do |pred| %>
                    <div class="card card-bordered border-base-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300">
                      <!-- Category Header -->
                      <div class="bg-base-200/50 px-5 py-3 flex justify-between items-center border-b border-base-200/50">
                        <span class="badge badge-outline py-2 px-3 text-[10px] font-bold font-mono uppercase tracking-wider text-base-content/50"><%= pred.category %></span>
                        <% if pred.matched? %>
                          <span class="badge badge-success font-bold text-[9px] py-2 px-3 uppercase tracking-wider">🟢 <%= t('letters.matched') %></span>
                        <% else %>
                          <span class="badge badge-secondary font-bold text-[9px] py-2 px-3 uppercase tracking-wider">🦋 <%= t('letters.evolved') %></span>
                        <% end %>
                      </div>
                      
                      <!-- Comparison side-by-side -->
                      <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-base-200 bg-base-100">
                        <div class="p-6 space-y-1.5">
                          <span class="text-[9px] font-bold text-base-content/40 uppercase tracking-wider font-sans"><%= t('letters.then_you_imagined') %></span>
                          <p class="font-serif italic text-base text-primary leading-relaxed">"<%= pred.prediction %>"</p>
                        </div>
                        <div class="p-6 space-y-1.5 bg-neutral/[0.02]">
                          <span class="text-[9px] font-bold text-base-content/40 uppercase tracking-wider font-sans"><%= t('letters.now_living_reality') %></span>
                          <p class="font-serif italic text-base text-primary leading-relaxed">"<%= pred.reality %>"</p>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
