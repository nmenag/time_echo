<div class="max-w-2xl mx-auto py-4">
  <% if @countdown %>
    <!-- Locked Capsule / Countdown View using DaisyUI components -->
    <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-12 rounded-box text-center space-y-8 shadow-xs animate-fade-in">
      <div class="relative w-24 h-24 mx-auto select-none">
        <div class="absolute inset-0 bg-secondary rounded-full border border-accent flex items-center justify-center text-4xl shadow-inner">
          🔒
        </div>
        <div class="absolute -bottom-1 -right-1 bg-primary text-white w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 border-white animate-bounce">
          ⌛
        </div>
      </div>

      <div class="space-y-3">
        <h1 class="font-serif italic text-3xl text-primary font-normal"><%= t('letters.show_locked_title') %></h1>
        <p class="text-sm text-base-content/60 max-w-sm mx-auto leading-relaxed font-sans">
          <%= t('letters.show_locked_desc', email: @letter.email) %>
        </p>
      </div>

      <% days_left = (@letter.deliver_at.to_date - Date.current).to_i %>
      <div class="space-y-2">
        <span class="text-[10px] font-semibold text-base-content/40 uppercase tracking-wider block"><%= t('letters.show_opening_in') %></span>
        <div class="inline-block px-6 py-3 bg-secondary/50 border border-accent text-primary rounded-2xl font-serif italic text-3xl font-semibold tracking-wide">
          <%= pluralize(days_left, "day") %>
        </div>
        <p class="text-xs text-base-content/40 pt-1"><%= t('letters.show_target_date', date: @letter.deliver_at.strftime('%B %d, %Y')) %></p>
      </div>

      <div class="pt-6 border-t border-base-200">
        <a href="<%= root_path %>" class="btn btn-primary rounded-xl px-6 text-xs font-semibold uppercase tracking-wider shadow-xs">
          <%= t('letters.show_btn_dashboard') %>
        </a>
      </div>
    </div>

  <% else %>
    <!-- Unlocked / Delivered Letter View using DaisyUI components -->
    <div class="card card-bordered border-base-200 bg-base-100 rounded-box p-8 sm:p-12 shadow-xs space-y-8 animate-fade-in">
      <!-- Letter Header with dual timestamps -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-base-200 pb-6 text-xs text-base-content/50">
        <div class="space-y-1">
          <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/40"><%= t('letters.show_written') %></p>
          <p class="font-serif italic text-sm text-primary font-normal"><%= @letter.created_at.strftime('%B %d, %Y') %></p>
        </div>
        <div class="space-y-1 sm:text-right">
          <p class="uppercase tracking-wider font-semibold text-[10px] text-base-content/40"><%= t('letters.show_delivered') %></p>
          <p class="font-serif italic text-sm text-primary font-normal"><%= @letter.delivered_at.strftime('%B %d, %Y') %></p>
        </div>
      </div>

      <!-- Letter Body with the high-fidelity writing-canvas font styling -->
      <article class="font-serif text-lg text-primary leading-relaxed whitespace-pre-wrap select-text writing-canvas">
        <%= @letter.content %>
      </article>

      <!-- Attachments Section (Active Storage) -->
      <% if @letter.attachments.attached? %>
        <div class="pt-8 border-t border-base-200 space-y-4">
          <h3 class="text-xs font-semibold text-primary uppercase tracking-wider"><%= t('letters.show_attachments_title') %></h3>
          
          <div class="grid sm:grid-cols-2 gap-4">
            <% @letter.attachments.each do |attachment| %>
              <div class="card card-bordered border-base-200 bg-base-200/20 p-4 rounded-xl flex flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3 overflow-hidden">
                  <% if attachment.image? %>
                    <div class="w-12 h-12 rounded-lg bg-cover bg-center border border-base-200/60 shrink-0" style="background-image: url('<%= rails_blob_path(attachment) %>')"></div>
                  <% else %>
                    <div class="w-12 h-12 rounded-lg bg-base-200 flex items-center justify-center text-xl shrink-0 border border-base-200">📄</div>
                  <% end %>
                  <div class="overflow-hidden">
                    <p class="text-xs font-semibold text-primary truncate"><%= attachment.filename %></p>
                    <p class="text-[10px] text-base-content/50"><%= number_to_human_size(attachment.byte_size) %></p>
                  </div>
                </div>

                <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "btn btn-outline btn-xs border-base-300 hover:bg-base-200 hover:text-primary rounded-lg text-xs font-semibold px-3 shadow-xs shrink-0", download: true do %>
                  <%= t('letters.show_download') %>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Inline Image Previews -->
          <div class="space-y-6 pt-4">
            <% @letter.attachments.select(&:image?).each do |image_attachment| %>
              <div class="space-y-2">
                <%= image_tag image_attachment, class: "w-full max-h-[450px] object-cover rounded-xl border border-base-200 shadow-xs" %>
                <span class="text-[10px] text-base-content/40 block text-center font-sans"><%= image_attachment.filename %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Letter Actions / Footer -->
      <div class="pt-8 border-t border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-base-content/50">
        <div>
          <span>👁️ <%= @letter.open_count == 1 ? t('letters.show_read_count', count: 1) : t('letters.show_read_count_plural', count: @letter.open_count) %></span>
        </div>
        
        <div class="flex gap-4 font-sans">
          <% if user_signed_in? && @letter.email == current_user_email %>
            <a href="<%= dashboard_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral p-0 font-semibold">
              <%= t('letters.show_back_timeline').html_safe %>
            </a>
          <% else %>
            <a href="<%= public_feed_letters_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral p-0 font-semibold">
              <%= t('letters.show_back_public').html_safe %>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
