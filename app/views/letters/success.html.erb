<div class="max-w-md mx-auto py-12 font-sans select-none animate-fade-in text-center">
  <div class="bg-white border border-base-200/80 p-8 sm:p-12 rounded-3xl shadow-sm space-y-8 relative overflow-hidden">
    <!-- Dynamic subtle backing glow -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-[#5b21b6]/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-[#2dd4bf]/5 rounded-full blur-2xl pointer-events-none"></div>

    <div class="w-20 h-20 bg-[#5b21b6]/5 text-[#5b21b6] rounded-full flex items-center justify-center text-4xl mx-auto border border-[#5b21b6]/10 select-none shadow-3xs">
      🔒
    </div>

    <div class="space-y-3 relative">
      <h1 class="font-serif text-3xl font-normal text-primary leading-tight"><%= t('letters.success_header') %></h1>
      <p class="text-xs text-base-content/60 leading-relaxed font-medium">
        <%= t('letters.success_sub').html_safe %>
      </p>
      <div class="inline-block px-4 py-2 bg-[#5b21b6]/5 border border-[#5b21b6]/10 text-[#5b21b6] rounded-2xl font-serif text-base italic tracking-wide font-semibold mt-2 shadow-3xs">
        <%= @deliver_at&.strftime('%B %d, %Y') || t('letters.success_date_fallback') %>
      </div>
    </div>

    <div class="p-4 bg-base-200/30 rounded-2xl space-y-2 border border-base-200/50 text-left font-sans shadow-3xs">
      <p class="text-[9px] font-bold text-[#5b21b6] uppercase tracking-wider"><%= t('letters.success_next_title') %></p>
      <p class="text-xs text-base-content/60 leading-relaxed font-semibold">
        <%= t('letters.success_next_desc', email: @email) %>
      </p>
    </div>

    <div class="pt-6 border-t border-base-200/80 space-y-4 font-sans relative">
      <% if user_signed_in? %>
        <a href="<%= dashboard_path %>" class="btn w-full bg-[#5b21b6] hover:bg-[#4c1d95] text-white rounded-2xl py-3.5 px-6 text-xs font-bold tracking-wider uppercase shadow-md transition-all duration-300 cursor-pointer border-none flex items-center justify-center">
          <%= t('letters.success_btn_dashboard') %>
        </a>
      <% else %>
        <a href="<%= login_path %>" class="btn w-full bg-[#5b21b6] hover:bg-[#4c1d95] text-white rounded-2xl py-3.5 px-6 text-xs font-bold tracking-wider uppercase shadow-md transition-all duration-300 cursor-pointer border-none flex items-center justify-center">
          <%= t('letters.success_btn_signin') %>
        </a>
        <p class="text-[9px] text-base-content/40 font-semibold"><%= t('letters.success_signin_help') %></p>
      <% end %>
      
      <a href="<%= root_path %>" class="text-[10px] font-bold text-base-content/40 hover:text-[#5b21b6] transition-colors duration-200 uppercase tracking-widest flex items-center justify-center gap-1 pt-2">
        <span>&larr;</span> <%= t('letters.success_btn_home') || "Volver al inicio" %>
      </a>
    </div>
  </div>
</div>
