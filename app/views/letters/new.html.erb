<div class="relative max-w-7xl mx-auto py-4 font-ui animate-fade-in text-base-content">
  <%= form_with model: @letter_form, url: letters_path, local: true, class: "space-y-6" do |f| %>

    <% if @letter_form.errors.any? %>
      <div class="paper-sheet rounded-xs p-5 border-l-4 border-l-error max-w-7xl mx-auto text-base-content animate-fade-in" role="alert" aria-live="polite">
        <div class="flex flex-col gap-2">
          <span class="font-serif-editorial text-lg font-semibold flex items-center gap-2 text-error">
            <%= tabler_icon("alert-triangle", size: 18) %> <%= t('flash.errors_title') %>
          </span>
          <ul class="list-disc list-inside pl-1 space-y-1 text-xs leading-relaxed text-base-content/80 font-letter">
            <% @letter_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-6">
      <div class="space-y-1">
        <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight"><%= t('letters.form_step_title') %></h1>
        <p class="text-xs font-letter text-base-content/60 tracking-wider"><%= t('letters.form_step_subtitle') %></p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <%= f.hidden_field :timezone, id: "user_timezone_input", value: @letter_form.timezone %>
        <span class="text-xs font-letter text-base-content/60 uppercase tracking-wider"><%= t('letters.deliver_date_prefix') %></span>
        <div class="postmark-stamp flex items-center gap-2 px-3 py-1.5 bg-transparent">
          <%= f.text_field :deliver_at,
              id: "deliver_at_new_form",
              value: @letter_form.deliver_at&.strftime("%Y-%m-%d"),
              min: (Date.current + 1.day).to_s,
              class: "bg-transparent text-xs font-letter font-semibold text-base-content border-none outline-none focus:ring-0 p-0 cursor-pointer w-32 uppercase tracking-wider",
              required: true,
              onchange: "updateSummaryInfo()",
              data: { controller: "date-picker", date_picker_locale_value: I18n.locale } %>
          <span class="text-base-content/50"><%= tabler_icon("calendar", size: 15) %></span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <div class="lg:col-span-7 paper-sheet rounded-xs p-6 sm:p-10 space-y-6 border border-[#D8D2C2] dark:border-[#2D3340]">
        <div class="flex items-center justify-between border-b border-[#D8D2C2] dark:border-[#2D3340] pb-4">
          <div>
            <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('brand') %> · <%= t('letters.form_letter_heading') %></span>
            <h2 class="font-serif-editorial text-2xl font-semibold text-base-content mt-0.5"><%= t('letters.form_letter_heading') %></h2>
          </div>
          <span class="postmark-stamp text-[10px] py-0.5 px-2.5">
            <%= I18n.l(Date.current, format: :long) %>
          </span>
        </div>

        <div class="space-y-2">
          <%= f.label :title, t('letters.title_label'), class: "text-xs font-letter uppercase tracking-wider font-semibold text-base-content/70 block" %>
          <%= f.text_field :title,
              placeholder: t('letters.title_placeholder'),
              class: "w-full border-b-2 border-[#D8D2C2] dark:border-[#2D3340] rounded-none bg-transparent px-1 py-2 font-serif-editorial text-xl font-semibold text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none transition-colors",
              required: true,
              "aria-required": "true" %>
        </div>

        <div class="space-y-2 relative">
          <%= f.label :content, t('letters.content_label'), class: "text-xs font-letter uppercase tracking-wider font-semibold text-base-content/70 block" %>
          <%= f.text_area :content,
              id: "letter_content_area",
              placeholder: t('letters.content_placeholder_form'),
              rows: 15,
              maxlength: 2000,
              class: "w-full p-5 sm:p-6 rounded-xs bg-transparent border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-sm leading-loose text-base-content/90 placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none transition-all shadow-inner",
              required: true,
              "aria-required": "true",
              "aria-describedby": "char_counter" %>
          <div class="flex justify-between items-center text-[11px] font-letter text-base-content/50 pt-1" aria-live="polite" aria-atomic="true">
            <span class="italic"><%= t('letters.only_you_can_see') %></span>
            <span id="char_counter">0 / 2000</span>
          </div>
        </div>

        <% unless user_signed_in? %>
          <div class="space-y-2 border-t border-[#D8D2C2] dark:border-[#2D3340] pt-5">
            <%= f.label :email, t('letters.label_email'), class: "text-xs font-letter uppercase tracking-wider font-semibold text-base-content/70 block" %>
            <%= f.email_field :email,
                placeholder: t('letters.email_placeholder_form'),
                class: "w-full border border-[#D8D2C2] dark:border-[#2D3340] rounded-xs bg-transparent text-base-content placeholder:text-base-content/40 text-xs px-3 py-2.5 font-letter focus:border-[#8E2818] focus:outline-none transition-colors",
                required: true,
                "aria-required": "true" %>
            <p class="text-[11px] font-letter text-base-content/50"><%= t('letters.label_email_help') %></p>
          </div>
        <% else %>
          <%= f.hidden_field :email, value: current_user_email %>
        <% end %>
      </div>

      <div class="lg:col-span-5 space-y-6">

        <div class="archival-folder rounded-xs p-6 space-y-5 border border-[#D5CEBD] dark:border-[#2D3342]">
          <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-3">
            <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('letters.annex_1') %></span>
            <h2 class="font-serif-editorial text-xl font-semibold text-base-content mt-0.5"><%= t('letters.predictions_heading') %></h2>
            <p class="text-xs font-letter text-base-content/60 mt-1"><%= t('letters.predictions_subtitle_form') %></p>
          </div>

          <div class="space-y-3.5 text-xs font-letter">
            <div class="space-y-1">
              <label class="font-semibold text-base-content/80 flex items-center gap-1.5">
                <span class="text-base-content/40">01.</span>
                <span><%= t('letters.prediction_city_label') %></span>
              </label>
              <%= f.text_field :prediction_city,
                  placeholder: t('letters.prediction_placeholder'),
                  class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="font-semibold text-base-content/80 flex items-center gap-1.5">
                <span class="text-base-content/40">02.</span>
                <span><%= t('letters.prediction_work_label') %></span>
              </label>
              <%= f.text_field :prediction_career,
                  placeholder: t('letters.prediction_placeholder'),
                  class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="font-semibold text-base-content/80 flex items-center gap-1.5">
                <span class="text-base-content/40">03.</span>
                <span><%= t('letters.prediction_income_label_form') %></span>
              </label>
              <%= f.text_field :prediction_salary,
                  placeholder: t('letters.prediction_placeholder'),
                  class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="font-semibold text-base-content/80 flex items-center gap-1.5">
                <span class="text-base-content/40">04.</span>
                <span><%= t('letters.prediction_relationship_label_form') %></span>
              </label>
              <%= f.text_field :prediction_relationship,
                  placeholder: t('letters.prediction_placeholder'),
                  class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="font-semibold text-base-content/80 flex items-center gap-1.5">
                <span class="text-base-content/40">05.</span>
                <span><%= t('letters.prediction_achievement_label_form') %></span>
              </label>
              <%= f.text_field :prediction_achievement,
                  placeholder: t('letters.prediction_placeholder'),
                  class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] text-base-content font-letter placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1 pt-1">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span class="flex items-center gap-1.5">
                  <span class="text-base-content/40">06.</span>
                  <span><%= t('letters.prediction_happiness_label_form') %></span>
                </span>
                <span id="pred_happiness_val" class="text-xs font-letter text-base-content/70" aria-live="polite">7 / 10</span>
              </div>
              <%= f.range_field :prediction_happiness,
                  min: 1, max: 10, value: 7,
                  class: "range range-xs cursor-pointer w-full accent-[#8E2818]",
                  aria: { label: t('letters.prediction_happiness_label_form'), valuemin: 1, valuemax: 10, valuenow: 7 },
                  oninput: "document.getElementById('pred_happiness_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);" %>
            </div>
          </div>
        </div>

        <div class="archival-folder rounded-xs p-6 space-y-5 border border-[#D5CEBD] dark:border-[#2D3342]">
          <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-3">
            <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('letters.annex_2') %></span>
            <h2 class="font-serif-editorial text-xl font-semibold text-base-content mt-0.5"><%= t('letters.emotional_snapshot_heading') %></h2>
            <p class="text-xs font-letter text-base-content/60 mt-1"><%= t('letters.feeling_now_short') %></p>
          </div>

          <div class="space-y-4 font-letter text-xs">
            <div class="space-y-1">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('letters.emotion_happiness') %></span>
                <span id="happiness_val" class="text-base-content/70" aria-live="polite">6 / 10</span>
              </div>
              <%= f.range_field :happiness_level,
                  min: 1, max: 10, value: 6,
                  class: "range range-xs cursor-pointer w-full accent-[#8E2818]",
                  aria: { label: t('letters.emotion_happiness'), valuemin: 1, valuemax: 10, valuenow: 6 },
                  oninput: "document.getElementById('happiness_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);" %>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('letters.emotion_anxiety') %></span>
                <span id="anxiety_val" class="text-base-content/70" aria-live="polite">4 / 10</span>
              </div>
              <%= f.range_field :anxiety_level,
                  min: 1, max: 10, value: 4,
                  class: "range range-xs cursor-pointer w-full accent-[#8E2818]",
                  aria: { label: t('letters.emotion_anxiety'), valuemin: 1, valuemax: 10, valuenow: 4 },
                  oninput: "document.getElementById('anxiety_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);" %>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('letters.emotion_motivation') %></span>
                <span id="motivation_val" class="text-base-content/70" aria-live="polite">7 / 10</span>
              </div>
              <%= f.range_field :motivation_level,
                  min: 1, max: 10, value: 7,
                  class: "range range-xs cursor-pointer w-full accent-[#8E2818]",
                  aria: { label: t('letters.emotion_motivation'), valuemin: 1, valuemax: 10, valuenow: 7 },
                  oninput: "document.getElementById('motivation_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);" %>
            </div>
          </div>
        </div>

        <div class="paper-sheet rounded-xs p-5 space-y-3 text-xs font-letter border border-[#D8D2C2] dark:border-[#2D3340]">
          <span class="text-[10px] font-semibold text-base-content/50 uppercase tracking-widest block"><%= t('letters.summary_heading') %></span>

          <div class="space-y-2 border-t border-[#D8D2C2] dark:border-[#2D3340] pt-2 text-base-content/80">
            <div class="flex justify-between items-center">
              <span class="text-base-content/60"><%= t('letters.summary_opening_label') %>:</span>
              <span id="summary_delivery_date" class="font-semibold text-base-content truncate"><%= t('letters.summary_loading') %></span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-base-content/60"><%= t('letters.summary_time_label') %>:</span>
              <span id="summary_countdown" class="font-semibold text-base-content truncate"><%= t('letters.summary_loading') %></span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-base-content/60"><%= t('letters.summary_privacy_label') %>:</span>
              <span class="font-semibold text-base-content"><%= t('letters.only_you_can_see') %></span>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <%= f.button class: "btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase border-none cursor-pointer w-full min-h-[46px] shadow-xs font-letter inline-flex items-center justify-center gap-2" do %>
            <%= tabler_icon("mail", size: 16) %>
            <span><%= t('letters.btn_save_letter') %></span>
          <% end %>
        </div>

      </div>

    </div>
  <% end %>
</div>

<script>
  function initCharCounter() {
    const textarea = document.getElementById("letter_content_area");
    const counter  = document.getElementById("char_counter");
    if (textarea && counter) {
      const updateCounter = () => {
        counter.innerText = `${textarea.value.length} / 2000`;
      };
      textarea.removeEventListener("input", updateCounter);
      textarea.addEventListener("input", updateCounter);
      updateCounter();
    }
  }

  function initTimezone() {
    const tzInput = document.getElementById("user_timezone_input");
    if (tzInput) {
      const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (userTz) tzInput.value = userTz;
    }
  }
  document.addEventListener("turbo:load", () => { initCharCounter(); initTimezone(); updateSummaryInfo(); });
  window.addEventListener("pageshow", () => { initCharCounter(); initTimezone(); updateSummaryInfo(); });
  document.addEventListener("DOMContentLoaded", () => { initCharCounter(); initTimezone(); updateSummaryInfo(); });
  initTimezone();
  initCharCounter();

  function updateSummaryInfo() {
    const dateInput       = document.getElementById("deliver_at_new_form");
    const summaryDate     = document.getElementById("summary_delivery_date");
    const summaryCountdown = document.getElementById("summary_countdown");

    if (dateInput && summaryDate && summaryCountdown) {
      if (!dateInput.value) {
        summaryDate.innerText     = "<%= j t('letters.summary_not_configured') %>";
        summaryCountdown.innerText = "<%= j t('letters.summary_na') %>";
        return;
      }

      const selected = new Date(dateInput.value);
      selected.setHours(0, 0, 0, 0);
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      summaryDate.innerText     = selected.toLocaleDateString("<%= j I18n.locale.to_s %>", { day: "numeric", month: "long", year: "numeric" });
      const diffDays            = Math.ceil((selected - today) / (1000 * 60 * 60 * 24));
      summaryCountdown.innerText = diffDays <= 0 ? "<%= j t('letters.summary_tomorrow') %>" : `${diffDays} <%= j t('letters.days_word') %>`;
    }
  }
</script>
