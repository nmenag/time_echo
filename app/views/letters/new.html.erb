<div class="relative max-w-7xl mx-auto py-6 group font-sans animate-fade-in">
  <%= form_with model: @letter_form, url: letters_path, local: true, class: "space-y-6" do |f| %>

    <%# Validation errors %>
    <% if @letter_form.errors.any? %>
      <div class="bg-error/5 border border-error/20 rounded-2xl p-5 max-w-7xl mx-auto text-base-content animate-fade-in shadow-2xs" role="alert" aria-live="polite">
        <div class="flex flex-col gap-2">
          <span class="font-serif italic text-lg font-semibold flex items-center gap-2 text-error">
            <span aria-hidden="true">⚠️</span> <%= t('flash.errors_title') || "Por favor corrige los siguientes errores:" %>
          </span>
          <ul class="list-disc list-inside pl-1 space-y-1 text-xs leading-relaxed text-base-content/80 font-sans">
            <% @letter_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%# ── Header Section ── %>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6">
      <div class="space-y-1">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">1. Cuando escribes tu carta</h1>
        <p class="text-sm text-slate-500">Estás creando una carta para tu yo del futuro.</p>
      </div>

      <%# Header Date Picker aligned to the right %>
      <div class="flex items-center gap-3 shrink-0">
        <span class="text-xs font-semibold text-slate-500">Se abrirá el</span>
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-xl shadow-2xs hover:border-slate-300 transition-colors">
          <%= f.date_field :deliver_at,
              id: "deliver_at_new_form",
              min: (Date.current + 1.day).to_s,
              class: "bg-transparent text-sm font-bold text-slate-800 border-none outline-none focus:ring-0 p-0 cursor-pointer w-38",
              required: true,
              onchange: "updateSummaryInfo()" %>
          <span class="text-slate-400">📅</span>
        </div>
      </div>
    </div>

    <% # ── Main 3-Column Layout ── %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <%# Column 1: Tu carta (span 4) %>
      <div class="lg:col-span-4 bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
        <h2 class="text-xl font-bold text-slate-900">Tu carta</h2>

        <%# Title %>
        <div class="space-y-2">
          <%= f.label :title, "Título", class: "text-sm font-bold text-slate-800 block" %>
          <%= f.text_field :title,
              placeholder: "Ej: Para mi yo del futuro",
              class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]",
              required: true,
              "aria-required": "true" %>
        </div>

        <%# Content %>
        <div class="space-y-2 relative">
          <%= f.label :content, "Contenido", class: "text-sm font-bold text-slate-800 block" %>
          <%= f.text_area :content,
              id: "letter_content_area",
              placeholder: "Escribe aquí todo lo que quieras contarle a tu yo del futuro...",
              rows: 14,
              class: "textarea textarea-bordered w-full p-6 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 focus:outline-none rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 transition-all shadow-inner",
              required: true,
              "aria-required": "true",
              "aria-describedby": "char_counter" %>
          <div class="flex justify-end text-[10px] text-slate-400 font-mono mt-1" aria-live="polite" aria-atomic="true">
            <span id="char_counter">0 / 2000</span>
          </div>
        </div>

        <%# Email field for visitors %>
        <% unless user_signed_in? %>
          <div class="space-y-2 border-t border-slate-100 pt-5">
            <%= f.label :email, "Tu correo electrónico", class: "text-sm font-bold text-slate-800 block" %>
            <%= f.email_field :email,
                placeholder: "tu@correo.com",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]",
                required: true,
                "aria-required": "true" %>
          </div>
        <% else %>
          <%= f.hidden_field :email, value: current_user_email %>
        <% end %>
      </div>

      <%# Column 2: Tus predicciones (span 5) %>
      <div class="lg:col-span-5 bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-900">Tus predicciones</h2>
          <p class="text-xs text-slate-500">¿Cómo crees que será tu vida cuando abras esta carta?</p>
        </div>

        <div class="space-y-4">
          <%# 1. City %>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                🏠
              </div>
              <%= f.label :prediction_city, "¿Dónde vivirás?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <%= f.text_field :prediction_city,
                placeholder: "Escribe tu predicción...",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]" %>
          </div>

          <%# 2. Career %>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                💼
              </div>
              <%= f.label :prediction_career, "¿En qué trabajarás?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <%= f.text_field :prediction_career,
                placeholder: "Escribe tu predicción...",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]" %>
          </div>

          <%# 3. Salary %>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                💵
              </div>
              <%= f.label :prediction_salary, "¿Cuánto ganarás al mes?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <%= f.text_field :prediction_salary,
                placeholder: "Escribe tu predicción...",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]" %>
          </div>

          <%# 4. Relationship %>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                💖
              </div>
              <%= f.label :prediction_relationship, "¿Cómo estará tu relación sentimental?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <%= f.text_field :prediction_relationship,
                placeholder: "Escribe tu predicción...",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]" %>
          </div>

          <%# 5. Achievement %>
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                🏆
              </div>
              <%= f.label :prediction_achievement, "¿Cuál será tu mayor logro?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <%= f.text_field :prediction_achievement,
                placeholder: "Escribe tu predicción...",
                class: "input input-bordered w-full rounded-2xl bg-white text-slate-800 border-slate-200 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all px-4 min-h-[44px]" %>
          </div>

          <%# 6. Happiness slider %>
          <div class="space-y-2 pt-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 font-sans text-sm">
                😆
              </div>
              <%= f.label :prediction_happiness, "¿Qué tan feliz crees que serás?", class: "text-sm font-bold text-slate-800" %>
            </div>
            <div class="flex items-center gap-4">
              <%= f.range_field :prediction_happiness,
                  min: 1, max: 10,
                  class: "range range-xs cursor-pointer w-full accent-violet-600",
                  oninput: "document.getElementById('pred_happiness_val').innerText = this.value + ' / 10'" %>
              <span id="pred_happiness_val" class="text-xs font-bold text-slate-600 w-12 text-right font-sans" aria-live="polite">7 / 10</span>
            </div>
          </div>
        </div>
      </div>

      <%# Column 3: Estado emocional + Resumen (span 3) %>
      <div class="lg:col-span-3 space-y-6">

        <%# Emotional snapshot card %>
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-2xs space-y-6">
          <div class="space-y-1">
            <h2 class="text-xl font-bold text-slate-900">Estado emocional hoy</h2>
            <p class="text-xs text-slate-500">¿Cómo te sientes en este momento?</p>
          </div>

          <div class="space-y-5">
            <%# Happiness %>
            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">😆</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-slate-700 block">Felicidad</span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :happiness_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-violet-600",
                      oninput: "document.getElementById('happiness_val').innerText = this.value + ' / 10'" %>
                  <span id="happiness_val" class="text-xs font-bold text-slate-600 font-sans shrink-0 w-8 text-right" aria-live="polite">6 / 10</span>
                </div>
              </div>
            </div>

            <%# Anxiety %>
            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">🥺</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-slate-700 block">Ansiedad</span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :anxiety_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-violet-600",
                      oninput: "document.getElementById('anxiety_val').innerText = this.value + ' / 10'" %>
                  <span id="anxiety_val" class="text-xs font-bold text-slate-600 font-sans shrink-0 w-8 text-right" aria-live="polite">4 / 10</span>
                </div>
              </div>
            </div>

            <%# Motivation %>
            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">⭐</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-slate-700 block">Motivación</span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :motivation_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-violet-600",
                      oninput: "document.getElementById('motivation_val').innerText = this.value + ' / 10'" %>
                  <span id="motivation_val" class="text-xs font-bold text-slate-600 font-sans shrink-0 w-8 text-right" aria-live="polite">7 / 10</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# Resumen Card (Tinted Violet) %>
        <div class="bg-[#f5f1ff] border border-violet-100/50 rounded-3xl p-6 space-y-4 shadow-2xs text-xs">
          <h3 class="font-extrabold text-slate-800 text-sm">Resumen</h3>

          <div class="space-y-3 pt-1">
            <div class="flex items-center gap-3 text-slate-700">
              <span class="text-base" aria-hidden="true">📅</span>
              <div class="min-w-0">
                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Se abrirá el</span>
                <p id="summary_delivery_date" class="font-bold text-slate-800 truncate">Cargando...</p>
              </div>
            </div>

            <div class="flex items-center gap-3 text-slate-700">
              <span class="text-base" aria-hidden="true">🕒</span>
              <div class="min-w-0">
                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Dentro de</span>
                <p id="summary_countdown" class="font-bold text-slate-800 truncate">Cargando...</p>
              </div>
            </div>

            <div class="flex items-center gap-3 text-slate-700">
              <span class="text-base" aria-hidden="true">🔒</span>
              <div class="min-w-0">
                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Privacidad</span>
                <p class="font-bold text-slate-800 truncate">Solo tú podrás verlo</p>
              </div>
            </div>
          </div>
        </div>

        <%# Guardar Carta Button (Deep Violet block) %>
        <div class="flex justify-end pt-2">
          <%= f.submit "Guardar carta",
              class: "btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-3 px-8 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] min-h-[44px]" %>
        </div>
      </div>

    </div>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Character counter
    const textarea = document.getElementById("letter_content_area");
    const counter  = document.getElementById("char_counter");
    if (textarea && counter) {
      const updateCounter = () => {
        counter.innerText = `${textarea.value.length}/2000`;
      };
      textarea.addEventListener("input", updateCounter);
      updateCounter();
    }

    // Set default target to 365 days from now
    const dateInput = document.getElementById("deliver_at_new_form");
    if (dateInput && !dateInput.value) {
      const d = new Date();
      d.setDate(d.getDate() + 365);
      dateInput.value = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    }

    updateSummaryInfo();
  });

  function updateSummaryInfo() {
    const dateInput       = document.getElementById("deliver_at_new_form");
    const summaryDate     = document.getElementById("summary_delivery_date");
    const summaryCountdown = document.getElementById("summary_countdown");

    if (dateInput && summaryDate && summaryCountdown) {
      if (!dateInput.value) {
        summaryDate.innerText     = "No configurada";
        summaryCountdown.innerText = "N/A";
        return;
      }

      const selected = new Date(dateInput.value);
      selected.setHours(0, 0, 0, 0);
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Match layout format: "15 de mayo de 2026"
      summaryDate.innerText     = selected.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
      const diffDays            = Math.ceil((selected - today) / (1000 * 60 * 60 * 24));
      summaryCountdown.innerText = diffDays <= 0 ? "Mañana" : `${diffDays} días`;
    }
  }
</script>
