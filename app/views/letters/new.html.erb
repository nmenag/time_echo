<div class="relative max-w-7xl mx-auto py-6 group font-sans animate-fade-in">
  <%= form_with model: @letter_form, url: letters_path, local: true, class: "space-y-6" do |f| %>

    <% if @letter_form.errors.any? %>
      <div class="bg-error/5 border border-error/20 rounded-2xl p-5 max-w-7xl mx-auto text-base-content animate-fade-in shadow-2xs" role="alert" aria-live="polite">
        <div class="flex flex-col gap-2">
          <span class="font-serif italic text-lg font-semibold flex items-center gap-2 text-error">
            <span aria-hidden="true">⚠️</span> <%= t('flash.errors_title') %>
          </span>
          <ul class="list-disc list-inside pl-1 space-y-1 text-xs leading-relaxed text-base-content/80 font-sans">
            <% @letter_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6">
      <div class="space-y-1">
        <h1 class="font-serif text-3xl font-normal text-base-content tracking-tight"><%= t('letters.form_step_title') %></h1>
        <p class="text-sm text-base-content/50"><%= t('letters.form_step_subtitle') %></p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <span class="text-xs font-semibold text-base-content/50"><%= t('letters.deliver_date_prefix') %></span>
        <div class="flex items-center gap-2 bg-base-200/20 border border-base-200 px-4 py-2.5 rounded-xl shadow-2xs hover:border-base-300 transition-colors">
          <%= f.text_field :deliver_at,
              id: "deliver_at_new_form",
              value: @letter_form.deliver_at&.strftime("%Y-%m-%d"),
              min: (Date.current + 1.day).to_s,
              class: "bg-transparent text-sm font-bold text-base-content/85 border-none outline-none focus:ring-0 p-0 cursor-pointer w-38",
              required: true,
              onchange: "updateSummaryInfo()",
              data: { controller: "date-picker", date_picker_locale_value: I18n.locale } %>
          <span class="text-base-content/30">📅</span>
        </div>
      </div>
    </div>

    <%# ── Main 3-Column Layout ── %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <div class="lg:col-span-4 bg-base-100 border border-base-200 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
        <h2 class="font-serif text-xl font-normal text-base-content"><%= t('letters.form_letter_heading') %></h2>

        <div class="space-y-2">
          <%= f.label :title, t('letters.title_label'), class: "text-sm font-bold text-base-content/85 block" %>
          <%= f.text_field :title,
              placeholder: t('letters.title_placeholder'),
              class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]",
              required: true,
              "aria-required": "true" %>
        </div>

        <div class="space-y-2 relative">
          <%= f.label :content, t('letters.content_label'), class: "text-sm font-bold text-base-content/85 block" %>
          <%= f.text_area :content,
              id: "letter_content_area",
              placeholder: t('letters.content_placeholder_form'),
              rows: 14,
              maxlength: 2000,
              class: "textarea textarea-bordered w-full p-6 focus:border-primary focus:ring-2 focus:ring-primary/10 focus:outline-none rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 transition-all shadow-inner",
              required: true,
              "aria-required": "true",
              "aria-describedby": "char_counter" %>
          <div class="flex justify-end text-[10px] text-base-content/30 font-mono mt-1" aria-live="polite" aria-atomic="true">
            <span id="char_counter">0 / 2000</span>
          </div>
        </div>

        <% unless user_signed_in? %>
          <div class="space-y-2 border-t border-base-200 pt-5">
            <%= f.label :email, t('letters.label_email'), class: "text-sm font-bold text-base-content/85 block" %>
            <%= f.email_field :email,
                placeholder: t('letters.email_placeholder_form'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]",
                required: true,
                "aria-required": "true" %>
          </div>
        <% else %>
          <%= f.hidden_field :email, value: current_user_email %>
        <% end %>
      </div>

      <div class="lg:col-span-5 bg-base-100 border border-base-200 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
        <div class="space-y-1">
          <h2 class="font-serif text-xl font-normal text-base-content"><%= t('letters.predictions_heading') %></h2>
          <p class="text-xs text-base-content/50"><%= t('letters.predictions_subtitle_form') %></p>
        </div>

        <div class="space-y-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                🏠
              </div>
              <%= f.label :prediction_city, t('letters.prediction_city_label'), class: "text-sm font-bold text-base-content/85" %>
             </div>
             <%= f.text_field :prediction_city,
                 placeholder: t('letters.prediction_placeholder'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]" %>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                💼
              </div>
              <%= f.label :prediction_career, t('letters.prediction_work_label'), class: "text-sm font-bold text-base-content/85" %>
             </div>
             <%= f.text_field :prediction_career,
                 placeholder: t('letters.prediction_placeholder'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]" %>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                💵
              </div>
              <%= f.label :prediction_salary, t('letters.prediction_income_label_form'), class: "text-sm font-bold text-base-content/85" %>
             </div>
             <%= f.text_field :prediction_salary,
                 placeholder: t('letters.prediction_placeholder'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]" %>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                💖
              </div>
              <%= f.label :prediction_relationship, t('letters.prediction_relationship_label_form'), class: "text-sm font-bold text-base-content/85" %>
             </div>
             <%= f.text_field :prediction_relationship,
                 placeholder: t('letters.prediction_placeholder'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]" %>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                🏆
              </div>
              <%= f.label :prediction_achievement, t('letters.prediction_achievement_label_form'), class: "text-sm font-bold text-base-content/85" %>
             </div>
             <%= f.text_field :prediction_achievement,
                 placeholder: t('letters.prediction_placeholder'),
                class: "input input-bordered w-full rounded-2xl bg-white text-base-content/85 border-slate-200 placeholder:text-base-content/30 text-sm hover:border-base-300 focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]" %>
          </div>

          <div class="space-y-2 pt-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/5 text-primary flex items-center justify-center shrink-0 font-sans text-sm">
                😆
              </div>
              <%= f.label :prediction_happiness, t('letters.prediction_happiness_label_form'), class: "text-sm font-bold text-base-content/85" %>
            </div>
            <div class="flex items-center gap-4">
              <%= f.range_field :prediction_happiness,
                  min: 1, max: 10,
                  class: "range range-xs cursor-pointer w-full accent-primary",
                  oninput: "document.getElementById('pred_happiness_val').innerText = this.value + ' / 10'" %>
              <span id="pred_happiness_val" class="text-xs font-bold text-base-content/70 w-12 text-right font-sans" aria-live="polite">7 / 10</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-3 space-y-6">

        <div class="bg-base-100 border border-base-200 rounded-3xl p-6 shadow-2xs space-y-6">
          <div class="space-y-1">
            <h2 class="font-serif text-xl font-normal text-base-content"><%= t('letters.emotional_snapshot_heading') %></h2>
            <p class="text-xs text-base-content/50"><%= t('letters.feeling_now_short') %></p>
          </div>

          <div class="space-y-5">
            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">😆</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-base-content/80 block"><%= t('letters.emotion_happiness') %></span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :happiness_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-primary",
                      oninput: "document.getElementById('happiness_val').innerText = this.value + ' / 10'" %>
                  <span id="happiness_val" class="text-xs font-bold text-base-content/70 font-sans shrink-0 w-8 text-right" aria-live="polite">6 / 10</span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">🥺</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-base-content/80 block"><%= t('letters.emotion_anxiety') %></span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :anxiety_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-primary",
                      oninput: "document.getElementById('anxiety_val').innerText = this.value + ' / 10'" %>
                  <span id="anxiety_val" class="text-xs font-bold text-base-content/70 font-sans shrink-0 w-8 text-right" aria-live="polite">4 / 10</span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-2xl shrink-0">⭐</span>
              <div class="flex-grow space-y-1">
                <span class="text-xs font-bold text-base-content/80 block"><%= t('letters.emotion_motivation') %></span>
                <div class="flex items-center gap-3">
                  <%= f.range_field :motivation_level,
                      min: 1, max: 10,
                      class: "range range-xs cursor-pointer w-full accent-primary",
                      oninput: "document.getElementById('motivation_val').innerText = this.value + ' / 10'" %>
                  <span id="motivation_val" class="text-xs font-bold text-base-content/70 font-sans shrink-0 w-8 text-right" aria-live="polite">7 / 10</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-primary/5 border border-primary/10 rounded-3xl p-6 space-y-4 shadow-2xs text-xs">
           <h3 class="font-extrabold text-base-content/85 text-sm"><%= t('letters.summary_heading') %></h3>

          <div class="space-y-3 pt-1">
            <div class="flex items-center gap-3 text-base-content/80">
              <span class="text-base" aria-hidden="true">📅</span>
              <div class="min-w-0">
                <span class="text-[10px] text-base-content/30 font-bold uppercase tracking-wider block"><%= t('letters.summary_opening_label') %></span>
                <p id="summary_delivery_date" class="font-bold text-base-content/85 truncate"><%= t('letters.summary_loading') %></p>
              </div>
            </div>

            <div class="flex items-center gap-3 text-base-content/80">
              <span class="text-base" aria-hidden="true">🕒</span>
              <div class="min-w-0">
                <span class="text-[10px] text-base-content/30 font-bold uppercase tracking-wider block"><%= t('letters.summary_time_label') %></span>
                <p id="summary_countdown" class="font-bold text-base-content/85 truncate"><%= t('letters.summary_loading') %></p>
              </div>
            </div>

            <div class="flex items-center gap-3 text-base-content/80">
              <span class="text-base" aria-hidden="true">🔒</span>
              <div class="min-w-0">
                <span class="text-[10px] text-base-content/30 font-bold uppercase tracking-wider block"><%= t('letters.summary_privacy_label') %></span>
                <p class="font-bold text-base-content/85 truncate"><%= t('letters.only_you_can_see') %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <%= f.submit t('letters.btn_save_letter'),
              class: "btn btn-primary text-primary-content rounded-2xl py-3 px-8 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] min-h-[44px]" %>
        </div>
      </div>

    </div>
  <% end %>
</div>

<script>
  function initCharCounter() {
    const textarea = document.getElementById("letter_content_area");
    const counter  = document.getElementById("char_counter");
    if (textarea && counter) {
      const updateCounter = () => {
        counter.innerText = `${textarea.value.length}/2000`;
      };
      textarea.removeEventListener("input", updateCounter);
      textarea.addEventListener("input", updateCounter);
      updateCounter();
    }
  }

  document.addEventListener("turbo:load", initCharCounter);
  window.addEventListener("pageshow", initCharCounter);
  document.addEventListener("DOMContentLoaded", initCharCounter);

  function updateSummaryInfo() {
    const dateInput       = document.getElementById("deliver_at_new_form");
    const summaryDate     = document.getElementById("summary_delivery_date");
    const summaryCountdown = document.getElementById("summary_countdown");

    if (dateInput && summaryDate && summaryCountdown) {
      if (!dateInput.value) {
        summaryDate.innerText     = "<%= j t('letters.summary_not_configured') %>";
        summaryCountdown.innerText = "<%= j t('letters.summary_na') %>";
        return;
      }

      const selected = new Date(dateInput.value);
      selected.setHours(0, 0, 0, 0);
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      summaryDate.innerText     = selected.toLocaleDateString("<%= j I18n.locale.to_s %>", { day: "numeric", month: "long", year: "numeric" });
      const diffDays            = Math.ceil((selected - today) / (1000 * 60 * 60 * 24));
      summaryCountdown.innerText = diffDays <= 0 ? "<%= j t('letters.summary_tomorrow') %>" : `${diffDays} <%= j t('letters.days_word') %>`;
    }
  }
</script>
