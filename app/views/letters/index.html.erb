<div class="space-y-12 max-w-5xl mx-auto py-6">
  <!-- Header & Vault Actions -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-base-200">
    <div class="space-y-1.5">
      <h1 class="font-serif italic text-4xl text-primary font-normal"><%= t('dashboard.title') %></h1>
      <p class="text-sm text-base-content/50"><%= t('dashboard.subtitle') %></p>
    </div>
    <div class="flex gap-3">
      <a href="<%= analytics_path %>" class="btn btn-outline btn-md border-base-300 hover:bg-base-200 hover:text-primary rounded-xl px-5 text-xs font-semibold uppercase tracking-wider">
        📊 <%= t('navigation.analytics') %>
      </a>
      <a href="<%= new_letter_path %>" class="btn btn-primary btn-md rounded-xl px-5 shadow-xs font-semibold text-xs tracking-wider uppercase">
        ✏️ <%= t('dashboard.btn_write') %>
      </a>
    </div>
  </div>

  <!-- Premium DaisyUI Stats Grid -->
  <div class="stats stats-vertical md:stats-horizontal border border-base-200 w-full rounded-box bg-base-100 shadow-xs divide-y md:divide-y-0 md:divide-x divide-base-200">
    <!-- Stat 1 -->
    <div class="stat p-6">
      <div class="stat-title text-[10px] font-semibold text-base-content/40 uppercase tracking-wider"><%= t('dashboard.stat_total') %></div>
      <div class="stat-value font-serif text-4xl text-primary font-normal mt-1"><%= @letters.count %></div>
      <div class="stat-desc text-[11px] text-base-content/40 mt-1"><%= t('dashboard.stat_total_sub') %></div>
    </div>

    <!-- Stat 2 -->
    <div class="stat p-6">
      <div class="stat-title text-[10px] font-semibold text-base-content/40 uppercase tracking-wider"><%= t('dashboard.stat_delivered') %></div>
      <div class="stat-value font-serif text-4xl text-success font-normal mt-1"><%= @letters.delivered.count %></div>
      <div class="stat-desc text-[11px] text-base-content/40 mt-1"><%= t('dashboard.stat_delivered_sub') %></div>
    </div>

    <!-- Stat 3 -->
    <div class="stat p-6">
      <div class="stat-title text-[10px] font-semibold text-base-content/40 uppercase tracking-wider"><%= t('dashboard.stat_sealed') %></div>
      <div class="stat-value font-serif text-4xl text-warning font-normal mt-1"><%= @letters.pending.count %></div>
      <div class="stat-desc text-[11px] text-base-content/40 mt-1"><%= t('dashboard.stat_sealed_sub') %></div>
    </div>

    <!-- Stat 4 -->
    <div class="stat p-6">
      <div class="stat-title text-[10px] font-semibold text-base-content/40 uppercase tracking-wider"><%= t('dashboard.stat_reads') %></div>
      <div class="stat-value font-serif text-4xl text-primary font-normal mt-1"><%= @letters.sum(:open_count) %></div>
      <div class="stat-desc text-[11px] text-base-content/40 mt-1"><%= t('dashboard.stat_reads_sub') %></div>
    </div>
  </div>

  <!-- Vault Timeline -->
  <% if @letters.any? %>
    <div class="relative pl-8 border-l-2 border-base-200 space-y-12">
      <% @letters.each do |letter| %>
        <div class="relative">
          <!-- Dot node in timeline -->
          <% if letter.delivered? %>
            <% if letter.reveal_happiness.nil? %>
              <div class="absolute -left-[41px] top-3 w-5 h-5 bg-accent border-4 border-base-100 rounded-full shadow-xs animate-pulse"></div>
            <% else %>
              <div class="absolute -left-[41px] top-3 w-5 h-5 bg-success border-4 border-base-100 rounded-full shadow-xs"></div>
            <% end %>
          <% else %>
            <div class="absolute -left-[41px] top-3 w-5 h-5 bg-warning border-4 border-base-100 rounded-full shadow-xs"></div>
          <% end %>

          <!-- Timeline Card using DaisyUI Card styling -->
          <div class="card card-bordered border-base-200 bg-base-100 rounded-box card-hover-effect p-6 sm:p-8 space-y-5 shadow-xs">
            <!-- Card Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-base-200 pb-4">
              <div class="space-y-1">
                <span class="text-[10px] font-bold text-base-content/40 uppercase tracking-wider block">
                  <% if letter.delivered? %>
                    <%= letter.reveal_happiness.nil? ? "Needs Reflection / Reality Update" : t('dashboard.delivered_tag') %>
                  <% else %>
                    <%= t('dashboard.sealed_tag') %>
                  <% end %>
                </span>
                <h3 class="font-serif italic text-xl text-primary font-normal">
                  <%= letter.title %>
                  <span class="text-xs font-sans text-base-content/40 font-normal ml-1">
                    <% if letter.delivered? %>
                      (Opened <%= letter.delivered_at.strftime('%m/%d/%Y') %>)
                    <% else %>
                      (Opening <%= letter.deliver_at.strftime('%m/%d/%Y') %>)
                    <% end %>
                  </span>
                </h3>
              </div>

              <!-- Pill Badges -->
              <div class="flex flex-wrap gap-2 items-center">
                <% if letter.public? %>
                  <span class="badge badge-secondary py-2.5 px-3 text-[9px] font-bold uppercase tracking-wider border border-accent">
                    <%= t('dashboard.public_badge') %>
                  </span>
                <% else %>
                  <span class="badge badge-outline border-base-300 py-2.5 px-3 text-[9px] font-bold uppercase tracking-wider text-base-content/50">
                    <%= t('dashboard.private_badge') %>
                  </span>
                <% end %>



                <% if letter.predictions.any? %>
                  <span class="badge badge-primary py-2.5 px-3 text-[9px] font-bold uppercase tracking-wider flex items-center gap-1">
                    🔮 <%= letter.predictions.size %> predictions
                  </span>
                <% end %>

                <% if letter.emotional_snapshot.present? %>
                  <span class="badge badge-accent py-2.5 px-3 text-[9px] font-bold uppercase tracking-wider flex items-center gap-1">
                    🧠 Snapshot
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Content Preview & Differentiator Summaries -->
            <% if letter.delivered? %>
              <div class="space-y-4">
                <p class="text-sm font-serif italic text-base-content/80 leading-relaxed line-clamp-3">
                  "<%= letter.content %>"
                </p>

                <!-- Differentiators summary inline -->
                <div class="grid md:grid-cols-2 gap-4 bg-base-200/20 p-4 rounded-xl border border-base-200/50">
                  <!-- Emotional Evolution Summary -->
                  <% if letter.emotional_snapshot.present? %>
                    <div class="space-y-2">
                      <p class="text-[10px] font-bold text-primary uppercase tracking-wider">🧠 Emotional Baseline delta</p>
                      <div class="flex flex-wrap gap-3 text-xs">
                        <div>
                          <span class="text-base-content/50">Happiness:</span> 
                          <span class="font-semibold text-primary">
                            <%= letter.emotional_snapshot.happiness_level %> 
                            <% if letter.reveal_happiness.present? %>
                              &rarr; <%= letter.reveal_happiness %>
                            <% end %>
                          </span>
                        </div>
                        <div>
                          <span class="text-base-content/50">Anxiety:</span> 
                          <span class="font-semibold text-secondary">
                            <%= letter.emotional_snapshot.anxiety_level %> 
                            <% if letter.reveal_anxiety.present? %>
                              &rarr; <%= letter.reveal_anxiety %>
                            <% end %>
                          </span>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <!-- Predictions matched summary -->
                  <% if letter.predictions.any? %>
                    <div class="space-y-2">
                      <p class="text-[10px] font-bold text-primary uppercase tracking-wider">🔮 Predictions vs Reality</p>
                      <% if letter.reveal_happiness.nil? %>
                        <p class="text-xs text-accent italic font-semibold">🔒 Unrevealed - Open to record your reality!</p>
                      <% else %>
                        <% matched_count = letter.predictions.matched.count %>
                        <% total_count = letter.predictions.count %>
                        <div class="flex items-center gap-2">
                          <div class="radial-progress text-primary font-bold text-[10px]" style="--value:<%= (matched_count.to_f / total_count * 100).round %>; --size:2.2rem; --thickness: 4px;" role="progressbar">
                            <%= matched_count %>/<%= total_count %>
                          </div>
                          <span class="text-xs text-base-content/60"><%= matched_count %> out of <%= total_count %> prediction categories matched!</span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
                  <div class="text-[11px] text-base-content/40 flex items-center gap-3 font-sans">
                    <span>👁️ <%= letter.open_count == 1 ? t('letters.show_read_count', count: 1) : t('letters.show_read_count_plural', count: letter.open_count) %></span>
                    <% if letter.opened_at.present? %>
                      <span><%= t('letters.show_delivered') %>: <%= letter.opened_at.strftime('%m/%d/%Y') %></span>
                    <% end %>
                  </div>
                  
                  <% if letter.reveal_happiness.nil? %>
                    <a href="<%= letter_path(letter) %>" class="btn btn-accent btn-sm rounded-xl text-xs font-semibold uppercase tracking-wider w-full sm:w-auto shadow-xs">
                      ⚡ Complete & Reveal Reality
                    </a>
                  <% else %>
                    <a href="<%= letter_path(letter) %>" class="btn btn-outline btn-sm border-base-300 hover:bg-base-200 hover:text-primary rounded-xl text-xs font-semibold uppercase tracking-wider w-full sm:w-auto shadow-xs">
                      <%= t('dashboard.btn_open').html_safe %>
                    </a>
                  <% end %>
                </div>
              </div>
            <% else %>
              <!-- Countdown Badge / Sealed State -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-base-200/40 p-4 rounded-xl border border-base-200/50">
                <div class="flex items-center gap-3 text-sm text-primary">
                  <span class="text-2xl select-none">⏳</span>
                  <div>
                    <p class="font-semibold text-sm">Sealed Capsule in Travel</p>
                    <p class="text-xs text-base-content/50">
                      <% details = [] %>
                      <% details << "#{letter.predictions.count} Predictions" if letter.predictions.any? %>
                      <% details << "Emotional snapshot" if letter.emotional_snapshot.present? %>
                      This capsule contains: <%= details.join(' & ') %> (hidden until delivery date).
                    </p>
                  </div>
                </div>

                <% days_left = (letter.deliver_at.to_date - Date.current).to_i %>
                <div class="badge badge-accent py-3.5 px-4 text-[10px] font-bold tracking-wider uppercase border-0 self-start sm:self-auto shadow-xs">
                  <% if days_left == 1 %>
                    <%= t('dashboard.opening_in', count: 1) %>
                  <% else %>
                    <%= t('dashboard.opening_in_plural', count: days_left) %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty Vault State -->
    <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-12 rounded-3xl text-center max-w-xl mx-auto space-y-6 shadow-xs">
      <div class="w-16 h-16 bg-base-200/50 text-base-content/30 rounded-full flex items-center justify-center text-2xl mx-auto select-none border border-base-200">
        📭
      </div>
      <div class="space-y-2">
        <h3 class="font-serif italic text-2xl text-primary font-normal"><%= t('dashboard.empty_title') %></h3>
        <p class="text-sm text-base-content/50 leading-relaxed max-w-sm mx-auto font-sans">
          <%= t('dashboard.empty_desc') %>
        </p>
      </div>
      <a href="<%= new_letter_path %>" class="btn btn-primary rounded-xl px-6 font-semibold text-xs tracking-wider uppercase shadow-xs">
        <%= t('dashboard.empty_btn') %>
      </a>
    </div>
  <% end %>
</div>
