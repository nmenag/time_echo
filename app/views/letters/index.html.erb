<% if params[:timeline] %>
  <div class="space-y-8 max-w-4xl mx-auto py-4 font-ui animate-fade-in text-base-content">
    <div class="border-b border-[#D8D2C2] dark:border-[#2D3340] pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="space-y-1">
        <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight"><%= t('navigation.timeline') %></h1>
        <p class="text-xs font-letter text-base-content/60 tracking-wider"><%= t('timeline.subtitle') %></p>
      </div>
      <div class="flex gap-3 shrink-0 items-center">
        <a href="<%= dashboard_path %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs text-xs font-medium uppercase tracking-wider px-4 min-h-[40px] font-letter inline-flex items-center gap-1.5">
          <%= tabler_icon("file-text", size: 15) %>
          <span><%= t('letters.my_letters_title') %></span>
        </a>
        <a href="<%= new_letter_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-2 px-5 text-xs font-medium border-none cursor-pointer tracking-wider uppercase font-letter inline-flex items-center gap-2 shadow-xs">
          <%= tabler_icon("plus", size: 15) %>
          <span><%= t('letters.write_letter') %></span>
        </a>
      </div>
    </div>

    <% if @letters.any? %>
      <div class="relative border-l-2 border-[#D8D2C2] dark:border-[#2D3340] pl-6 sm:pl-8 ml-3 sm:ml-5 space-y-8 select-none">
        <% @letters.order(deliver_at: :desc).each do |letter| %>
          <% letter = LetterDecorator.new(letter) %>
          <div class="relative">
            <div class="absolute -left-[31px] sm:-left-[39px] top-4 w-4 h-4 rounded-full border-2 border-base-100 shadow-xs <%= letter.delivered? ? (letter.reveal_happiness.nil? ? 'bg-amber-600' : 'bg-[#2C485E] dark:bg-[#77A3C4]') : 'bg-[#8E2818]' %>"></div>

            <div class="paper-sheet rounded-xs p-5 sm:p-7 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-3 text-xs">
                <div class="flex items-center gap-2">
                  <span class="font-letter text-xs text-base-content/60 font-semibold tracking-wider">№ TE-<%= letter.id.to_s.rjust(5, '0') %></span>
                  <span class="postmark-stamp text-[11px] py-0.5 px-2">
                    <% if letter.delivered? %>
                      <%= tabler_icon("lock-open", size: 13, class: "mr-1") %>
                      <span><%= letter.reveal_happiness.nil? ? t('letters.pending_revelation') : t('letters.revealed_and_compared') %></span>
                    <% else %>
                      <%= tabler_icon("lock", size: 13, class: "mr-1") %>
                      <span><%= t('letters.sealed_capsule') %></span>
                    <% end %>
                  </span>
                </div>
                <span class="font-letter text-xs text-base-content/60 inline-flex items-center gap-1.5">
                  <%= tabler_icon("calendar", size: 13) %>
                  <span><%= t('letters.created_on') %>: <%= letter.formatted_created_at %></span>
                </span>
              </div>

              <div class="space-y-1">
                <h2 class="font-serif-editorial text-xl font-semibold text-base-content">
                  <%= letter.display_title %>
                </h2>
                <p class="font-letter text-xs text-base-content/60">
                  <% if letter.delivered? %>
                    <%= t('letters.delivered_on') %> <%= letter.formatted_delivered_at %>
                  <% else %>
                    <%= t('letters.will_open_on') %> <%= letter.formatted_deliver_at %>
                  <% end %>
                </p>
              </div>

              <% if letter.delivered? %>
                <p class="font-letter text-sm text-base-content/85 leading-relaxed pl-4 border-l-2 border-[#2C485E]/30 dark:border-[#77A3C4]/30 italic">
                  "<%= letter.content %>"
                </p>

                <% if letter.emotional_snapshot.present? || letter.predictions.any? %>
                  <div class="archival-folder rounded-xs p-4 text-xs font-letter space-y-2 text-base-content/80">
                    <% if letter.emotional_snapshot.present? %>
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                        <span class="font-semibold text-base-content/90 uppercase text-[10px] tracking-wider"><%= t('letters.emotional_evolution') %>:</span>
                        <span><%= t('letters.happiness') %>: <strong><%= letter.emotional_snapshot.happiness_level %></strong> &rarr; <strong><%= letter.reveal_happiness || '?' %></strong></span>
                        <span><%= t('letters.anxiety') %>: <strong><%= letter.emotional_snapshot.anxiety_level %></strong> &rarr; <strong><%= letter.reveal_anxiety || '?' %></strong></span>
                      </div>
                    <% end %>

                    <% if letter.predictions.any? %>
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-[#D5CEBD] dark:border-[#2D3342] pt-2">
                        <span class="font-semibold text-base-content/90 uppercase text-[10px] tracking-wider"><%= t('letters.predictions_badge_short') %>:</span>
                        <% if letter.reveal_happiness.nil? %>
                          <span class="italic text-amber-700 dark:text-amber-400"><%= t('letters.waiting_for_reality') %></span>
                        <% else %>
                          <% matched_count = letter.predictions.matched.count %>
                          <% total_count = letter.predictions.count %>
                          <span><%= t('letters.matched_predictions_count', matched: matched_count, total: total_count, pct: (matched_count.to_f / total_count * 100).round) %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <div class="flex justify-end pt-1">
                  <a href="<%= letter_path(letter) %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs px-4 py-1.5 text-xs font-medium uppercase tracking-wider font-letter inline-flex items-center gap-1.5 min-h-[36px]">
                    <%= tabler_icon("eye", size: 14) %>
                    <span><%= letter.reveal_happiness.nil? ? t('letters.complete_comparison') : t('letters.view_full_comparison') %></span>
                  </a>
                </div>
              <% else %>
                <div class="archival-folder rounded-xs p-4 text-xs font-letter flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-base-content/80">
                  <div class="space-y-1">
                    <p class="font-semibold uppercase tracking-wider text-[10px]"><%= t('letters.time_capsule_sealed') %></p>
                    <p class="text-base-content/60"><%= t('letters.sealed_desc', days: letter.days_left) %></p>
                  </div>
                  <a href="<%= letter_path(letter) %>" class="postmark-stamp self-start sm:self-center text-[11px] py-1 px-3 hover:bg-base-200/40">
                    <span><%= t('letters.opens_in_days', days: letter.days_left) %></span>
                  </a>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="paper-sheet rounded-xs p-12 text-center max-w-lg mx-auto space-y-5">
        <div class="text-[#2C485E] dark:text-[#77A3C4] flex justify-center"><%= tabler_icon("mailbox", size: 40) %></div>
        <h2 class="font-serif-editorial text-2xl font-semibold text-base-content"><%= t('letters.timeline_empty_title') %></h2>
        <p class="text-xs font-letter text-base-content/60 leading-relaxed max-w-sm mx-auto"><%= t('letters.timeline_empty_desc') %></p>
        <a href="<%= new_letter_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-2 px-6 text-xs font-medium border-none cursor-pointer tracking-wider uppercase font-letter inline-flex items-center gap-2 shadow-xs">
          <%= tabler_icon("plus", size: 15) %>
          <span><%= t('letters.btn_start_writing') %></span>
        </a>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="space-y-8 max-w-6xl mx-auto py-4 font-ui animate-fade-in text-base-content">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-6">
      <div class="space-y-1">
        <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight"><%= t('letters.my_letters_title') %></h1>
        <p class="text-xs font-letter text-base-content/60 tracking-wider"><%= t('letters.my_letters_subtitle') %></p>
      </div>
      <div class="flex gap-3 shrink-0 items-center">
        <a href="<%= dashboard_path(timeline: true) %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs text-xs font-medium uppercase tracking-wider px-4 min-h-[40px] font-letter inline-flex items-center gap-1.5">
          <%= tabler_icon("calendar", size: 15) %>
          <span><%= t('letters.btn_view_timeline') %></span>
        </a>
        <a href="<%= new_letter_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-2.5 px-5 text-xs font-medium border-none cursor-pointer tracking-wider uppercase font-letter inline-flex items-center gap-2 shadow-xs">
          <%= tabler_icon("plus", size: 15) %>
          <span><%= t('letters.write_letter') %></span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="paper-sheet rounded-xs p-5 space-y-1 border border-[#D8D2C2] dark:border-[#2D3340]">
        <span class="text-[10px] font-semibold text-base-content/60 uppercase tracking-widest block font-letter"><%= t('letters.stat_total_capsules') %></span>
        <span class="font-serif-editorial text-3xl font-semibold text-base-content block"><%= @letters.count %></span>
        <span class="text-[11px] font-letter text-base-content/60 pt-1 block"><%= t('letters.stat_future_messages') %></span>
      </div>

      <div class="paper-sheet rounded-xs p-5 space-y-1 border border-[#D8D2C2] dark:border-[#2D3340]">
        <span class="text-[10px] font-semibold text-base-content/60 uppercase tracking-widest block font-letter"><%= t('letters.stat_delivered_label') %></span>
        <span class="font-serif-editorial text-3xl font-semibold text-[#2C485E] dark:text-[#77A3C4] block"><%= @letters.delivered.count %></span>
        <span class="text-[11px] font-letter text-base-content/60 pt-1 block"><%= t('letters.stat_ready_to_compare') %></span>
      </div>

      <div class="paper-sheet rounded-xs p-5 space-y-1 border border-[#D8D2C2] dark:border-[#2D3340]">
        <span class="text-[10px] font-semibold text-base-content/60 uppercase tracking-widest block font-letter"><%= t('letters.stat_sealed_in_time') %></span>
        <span class="font-serif-editorial text-3xl font-semibold text-[#8E2818] block"><%= @letters.scheduled.count %></span>
        <span class="text-[11px] font-letter text-base-content/60 pt-1 block"><%= t('letters.stat_in_transit') %></span>
      </div>
    </div>

    <% if @letters.any? %>
      <div class="space-y-5">
        <% @letters.each do |letter| %>
          <% letter = LetterDecorator.new(letter) %>
          <div class="paper-sheet rounded-xs p-6 sm:p-7 space-y-4 border border-[#D8D2C2] dark:border-[#2D3340]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-3">
              <div class="flex items-center gap-3">
                <span class="font-letter text-xs text-base-content/60 font-semibold tracking-wider">№ TE-<%= letter.id.to_s.rjust(5, '0') %></span>
                <span class="postmark-stamp text-[11px] py-0.5 px-2">
                  <% if letter.delivered? %>
                    <%= tabler_icon("lock-open", size: 13, class: "mr-1") %>
                    <span><%= letter.reveal_happiness.nil? ? t('letters.pending_revelation') : t('letters.revealed_and_compared') %></span>
                  <% else %>
                    <%= tabler_icon("lock", size: 13, class: "mr-1") %>
                    <span><%= t('letters.in_transit_to_future') %></span>
                  <% end %>
                </span>
              </div>
              <span class="font-letter text-xs text-base-content/60 inline-flex items-center gap-1.5">
                <%= tabler_icon("calendar", size: 13) %>
                <span><%= t('letters.created_on') %>: <%= letter.formatted_created_at %></span>
              </span>
            </div>

            <div class="space-y-1">
              <h2 class="font-serif-editorial text-2xl font-semibold text-base-content">
                <%= letter.display_title %>
              </h2>
              <p class="font-letter text-xs text-base-content/60">
                <% if letter.delivered? %>
                  <%= t('letters.delivered_on') %> <%= letter.formatted_delivered_at %>
                <% else %>
                  <%= t('letters.show_opening_in') %> <%= letter.formatted_deliver_at %>
                <% end %>
              </p>
            </div>

            <% if letter.delivered? %>
              <div class="space-y-4">
                <p class="font-letter text-sm text-base-content/85 leading-relaxed pl-4 border-l-2 border-[#2C485E]/30 dark:border-[#77A3C4]/30 line-clamp-3 italic">
                  "<%= letter.content %>"
                </p>

                <% if letter.emotional_snapshot.present? || letter.predictions.any? %>
                  <div class="archival-folder rounded-xs p-4 text-xs font-letter space-y-2 text-base-content/80">
                    <% if letter.emotional_snapshot.present? %>
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                        <span class="font-semibold text-base-content/90 uppercase text-[10px] tracking-wider"><%= t('letters.emotional_snapshot') %>:</span>
                        <span><%= t('letters.happiness') %>: <strong><%= letter.emotional_snapshot.happiness_level %></strong></span>
                        <span><%= t('letters.anxiety') %>: <strong><%= letter.emotional_snapshot.anxiety_level %></strong></span>
                        <span><%= t('letters.motivation') %>: <strong><%= letter.emotional_snapshot.motivation_level %></strong></span>
                      </div>
                    <% end %>

                    <% if letter.predictions.any? %>
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-[#D5CEBD] dark:border-[#2D3342] pt-2">
                        <span class="font-semibold text-base-content/90 uppercase text-[10px] tracking-wider"><%= t('letters.predictions_badge_short') %>:</span>
                        <span><%= letter.reveal_happiness.nil? ? t('letters.predictions_sealed_pending', count: letter.predictions.size) : t('letters.predictions_sealed_completed', count: letter.predictions.size) %></span>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
                  <% if letter.reveal_happiness.nil? %>
                    <a href="<%= letter_path(letter) %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-2 px-5 text-xs font-medium tracking-wider uppercase cursor-pointer min-h-[38px] font-letter inline-flex items-center gap-1.5 shadow-xs">
                      <%= tabler_icon("lock-open", size: 14) %>
                      <span><%= t('letters.complete_revelation') %></span>
                    </a>
                  <% else %>
                    <a href="<%= letter_path(letter) %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs py-2 px-5 text-xs font-medium tracking-wider uppercase cursor-pointer min-h-[38px] font-letter inline-flex items-center gap-1.5">
                      <%= tabler_icon("eye", size: 14) %>
                      <span><%= t('letters.btn_view_predictions') %></span>
                    </a>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="archival-folder rounded-xs p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-letter">
                <div class="flex items-center gap-3">
                  <span class="text-[#8E2818]"><%= tabler_icon("lock", size: 18) %></span>
                  <div class="space-y-0.5">
                    <p class="font-semibold text-base-content/90 uppercase tracking-wider text-[10px]"><%= t('letters.time_capsule_sealed') %></p>
                    <p class="text-base-content/60"><%= t('letters.sealed_desc', days: letter.days_left) %></p>
                  </div>
                </div>

                <a href="<%= letter_path(letter) %>" class="postmark-stamp self-start sm:self-center text-[11px] py-1 px-3 hover:bg-base-200/40">
                  <span><%= t('letters.opens_in_days', days: letter.days_left) %></span>
                </a>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="paper-sheet rounded-xs p-12 text-center max-w-xl mx-auto space-y-5">
        <div class="text-[#2C485E] dark:text-[#77A3C4] flex justify-center"><%= tabler_icon("mail", size: 40) %></div>
        <h2 class="font-serif-editorial text-2xl font-semibold text-base-content"><%= t('letters.empty_title') %></h2>
        <p class="text-xs font-letter text-base-content/60 leading-relaxed max-w-sm mx-auto"><%= t('letters.empty_desc') %></p>
        <a href="<%= new_letter_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs py-2.5 px-6 text-xs font-medium border-none cursor-pointer tracking-wider uppercase font-letter inline-flex items-center gap-2 shadow-xs">
          <%= tabler_icon("plus", size: 15) %>
          <span><%= t('letters.write_first_letter') %></span>
        </a>
      </div>
    <% end %>
  </div>
<% end %>
