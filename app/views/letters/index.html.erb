<% if params[:timeline] %>
  <%# ── LINEA DE TIEMPO VIEW ── %>
  <div class="space-y-8 max-w-4xl mx-auto py-4 font-sans animate-fade-in">
    <%# Header %>
    <div class="border-b border-slate-100 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="space-y-1">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Línea de tiempo</h1>
        <p class="text-sm text-slate-500">Tu evolución, momentos emocionales y hitos de predicción ordenados cronológicamente.</p>
      </div>
      <a href="<%= new_letter_path %>" class="btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-3 px-6 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm shrink-0">
        ✏️ Escribir carta
      </a>
    </div>

    <% if @letters.any? %>
      <% # Elegant Vertical Line %>
      <div class="relative border-l-2 border-[#2e1065]/10 pl-8 ml-4 sm:ml-6 space-y-10 select-none">
        <% @letters.order(deliver_at: :desc).each do |letter| %>
          <div class="relative group">
            <%# Decorative timeline node %>
            <% if letter.delivered? %>
              <% if letter.reveal_happiness.nil? %>
                <div class="absolute -left-[41px] sm:-left-[43px] top-2 w-5 h-5 bg-amber-500 border-4 border-white rounded-full shadow-md animate-pulse"></div>
              <% else %>
                <div class="absolute -left-[41px] sm:-left-[43px] top-2 w-5 h-5 bg-emerald-500 border-4 border-white rounded-full shadow-md"></div>
              <% end %>
            <% else %>
              <div class="absolute -left-[41px] sm:-left-[43px] top-2 w-5 h-5 bg-violet-600 border-4 border-white rounded-full shadow-md"></div>
            <% end %>

            <%# Event Card %>
            <div class="bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-2xs transition-all duration-300 hover:-translate-y-0.5 hover:border-slate-200 space-y-5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-400 border-b border-slate-100 pb-3">
                <span class="font-bold tracking-wider uppercase text-violet-600">
                  <%= letter.delivered? ? (letter.reveal_happiness.nil? ? 'Pendiente por revelación' : 'Revelada & Comparada') : 'Cápsula Sellada' %>
                </span>
                <span>
                  Creado: <%= I18n.l(letter.created_at.to_date, format: :long) %>
                </span>
              </div>

              <%# Title %>
              <h3 class="text-xl font-bold text-slate-900">
                <%= letter.title %>
                <span class="text-xs font-normal text-slate-400 block sm:inline sm:ml-2">
                  <% if letter.delivered? %>
                    (Abierta el <%= I18n.l(letter.delivered_at.to_date, format: :long) %>)
                  <% else %>
                    (Se abrirá el <%= I18n.l(letter.deliver_at.to_date, format: :long) %>)
                  <% end %>
                </span>
              </h3>

              <%# Snapshot and predictions summary logs %>
              <% if letter.delivered? %>
                <p class="text-sm text-slate-600 leading-relaxed max-w-3xl font-serif italic">
                  "<%= letter.content %>"
                </p>

                <%# Predictions comparison delta box %>
                <div class="grid md:grid-cols-2 gap-4 bg-violet-50/50 p-5 rounded-2xl border border-violet-100/30 text-xs">
                  <%# Emotional shifts %>
                  <% if letter.emotional_snapshot.present? %>
                    <div class="space-y-1.5">
                      <p class="font-bold text-slate-800 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
                        <span>🧠</span> Evolución Emocional
                      </p>
                      <div class="space-y-1 text-slate-500 font-sans">
                        <p>Felicidad: <span class="font-bold text-violet-600"><%= letter.emotional_snapshot.happiness_level %></span> &rarr; <span class="font-bold text-violet-800"><%= letter.reveal_happiness || '?' %></span></p>
                        <p>Ansiedad: <span class="font-bold text-violet-600"><%= letter.emotional_snapshot.anxiety_level %></span> &rarr; <span class="font-bold text-violet-800"><%= letter.reveal_anxiety || '?' %></span></p>
                      </div>
                    </div>
                  <% end %>

                  <%# Predictions delta summary %>
                  <% if letter.predictions.any? %>
                    <div class="space-y-1.5">
                      <p class="font-bold text-slate-800 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
                        <span>🔮</span> Resumen de Predicciones
                      </p>
                      <% if letter.reveal_happiness.nil? %>
                        <p class="text-xs text-violet-600 italic font-medium">Espera revelación de la realidad.</p>
                      <% else %>
                        <% matched_count = letter.predictions.matched.count %>
                        <% total_count = letter.predictions.count %>
                        <p class="text-slate-500">Acertaste <span class="font-bold text-violet-600"><%= matched_count %></span> de <span class="font-bold text-slate-700"><%= total_count %></span> predicciones (<%= (matched_count.to_f / total_count * 100).round %>%).</p>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <%# Open CTA %>
                <div class="flex justify-end pt-2">
                  <a href="<%= letter_path(letter) %>" class="btn btn-outline border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-2xl px-5 text-xs font-bold uppercase tracking-wider cursor-pointer min-h-[38px]">
                    <%= letter.reveal_happiness.nil? ? 'Completar comparación' : 'Ver comparación completa' %>
                  </a>
                </div>
              <% else %>
                <%# Sealed state details %>
                <div class="bg-slate-50 p-5 rounded-2xl text-xs space-y-2 border border-slate-100">
                  <div class="flex items-center gap-2 text-violet-600 font-bold">
                    <span>⏳</span>
                    <span>Cápsula del tiempo sellada</span>
                  </div>
                  <p class="text-slate-500">Esta carta viaja de forma privada y encriptada hacia el futuro. Quedan aproximadamente <strong><%= (letter.deliver_at.to_date - Date.current).to_i %> días</strong> para su entrega.</p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty timeline %>
      <div class="bg-white border border-slate-100 p-12 rounded-3xl text-center max-w-lg mx-auto space-y-6 shadow-2xs">
        <p class="text-4xl">🕒</p>
        <h3 class="text-xl font-bold text-slate-900">Tu línea de tiempo está vacía</h3>
        <p class="text-xs text-slate-500 leading-relaxed max-w-sm mx-auto">Escribe tu primera carta al futuro para comenzar a graficar tu historia de crecimiento.</p>
        <a href="<%= new_letter_path %>" class="btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-3 px-6 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm">Comenzar a escribir</a>
      </div>
    <% end %>
  </div>
<% else %>
  <%# ── MIS CARTAS DEFAULT VIEW ── %>
  <div class="space-y-8 max-w-6xl mx-auto py-4 font-sans animate-fade-in">
    <%# Header %>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-slate-100 pb-6">
      <div class="space-y-1">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Mis cartas</h1>
        <p class="text-sm text-slate-500">Administra tus cápsulas del tiempo digital, estados emocionales y predicciones.</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <a href="<%= dashboard_path(timeline: true) %>" class="btn btn-outline border-slate-200 text-slate-700 hover:bg-slate-50 rounded-2xl text-xs font-bold uppercase tracking-wider px-5 min-h-[44px]">
          🕒 Ver línea de tiempo
        </a>
        <a href="<%= new_letter_path %>" class="btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-3 px-6 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm">
          ✏️ Escribir carta
        </a>
      </div>
    </div>

    <%# Premium Stat Widgets Grid %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <%# Total letters %>
      <div class="bg-white border border-slate-100 p-5 rounded-3xl shadow-2xs space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Cápsulas totales</span>
        <span class="text-3xl font-extrabold text-slate-900 block"><%= @letters.count %></span>
        <span class="text-[10px] text-slate-400 pt-1 block">Mensajes al futuro</span>
      </div>

      <%# Delivered %>
      <div class="bg-white border border-slate-100 p-5 rounded-3xl shadow-2xs space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Abiertas</span>
        <span class="text-3xl font-extrabold text-emerald-600 block"><%= @letters.delivered.count %></span>
        <span class="text-[10px] text-slate-400 pt-1 block">Listas para comparar</span>
      </div>

      <%# Sealed %>
      <div class="bg-white border border-slate-100 p-5 rounded-3xl shadow-2xs space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">En tránsito</span>
        <span class="text-3xl font-extrabold text-amber-500 block"><%= @letters.pending.count %></span>
        <span class="text-[10px] text-slate-400 pt-1 block">Selladas en el tiempo</span>
      </div>

      <%# Opens %>
      <div class="bg-white border border-slate-100 p-5 rounded-3xl shadow-2xs space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Lecturas</span>
        <span class="text-3xl font-extrabold text-violet-600 block"><%= @letters.sum(:open_count) %></span>
        <span class="text-[10px] text-slate-400 pt-1 block">Veces consultadas</span>
      </div>
    </div>

    <%# Letter cards list %>
    <% if @letters.any? %>
      <div class="space-y-6">
        <% @letters.each do |letter| %>
          <div class="bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-2xs transition-all duration-300 hover:-translate-y-0.5 hover:border-slate-200 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <div class="space-y-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-violet-600 block">
                  <%= letter.delivered? ? (letter.reveal_happiness.nil? ? 'Requiere revelación' : 'Entregada & Evaluada') : 'En tránsito al futuro' %>
                </span>
                <h3 class="text-xl font-bold text-slate-900">
                  <%= letter.title %>
                  <span class="text-xs font-normal text-slate-400 ml-1">
                    <% if letter.delivered? %>
                      (Abierta el <%= I18n.l(letter.delivered_at.to_date, format: :long) %>)
                    <% else %>
                      (Se abre el <%= I18n.l(letter.deliver_at.to_date, format: :long) %>)
                    <% end %>
                  </span>
                </h3>
              </div>

              <%# Badges %>
              <div class="flex flex-wrap gap-2">
                <% if letter.public? %>
                  <span class="bg-violet-50 text-violet-700 border border-violet-100 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg">Pública</span>
                <% else %>
                  <span class="bg-slate-50 text-slate-500 border border-slate-100 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg">Privada</span>
                <% end %>
              </div>
            </div>

            <%# Content preview / Countdown %>
            <% if letter.delivered? %>
              <div class="space-y-4">
                <p class="text-sm text-slate-600 leading-relaxed max-w-4xl line-clamp-3 font-serif italic">
                  "<%= letter.content %>"
                </p>

                <%# Custom small statistics %>
                <div class="grid md:grid-cols-2 gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-100 text-xs">
                  <% if letter.emotional_snapshot.present? %>
                    <div class="space-y-1">
                      <p class="font-bold text-slate-800 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
                        <span>🧠</span> snapshot emocional
                      </p>
                      <p class="text-slate-500">Felicidad: <span class="font-bold text-slate-700"><%= letter.emotional_snapshot.happiness_level %></span> | Ansiedad: <span class="font-bold text-slate-700"><%= letter.emotional_snapshot.anxiety_level %></span> | Motivación: <span class="font-bold text-slate-700"><%= letter.emotional_snapshot.motivation_level %></span></p>
                    </div>
                  <% end %>

                  <% if letter.predictions.any? %>
                    <div class="space-y-1">
                      <p class="font-bold text-slate-800 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
                        <span>🔮</span> predicciones hechas
                      </p>
                      <p class="text-slate-500"><%= letter.predictions.size %> predicciones selladas. <%= letter.reveal_happiness.nil? ? 'Pendiente por comparar' : 'Comparación completada' %>.</p>
                    </div>
                  <% end %>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
                  <span class="text-[10px] text-slate-400">👁️ consultada <%= letter.open_count %> veces</span>
                  
                  <% if letter.reveal_happiness.nil? %>
                    <a href="<%= letter_path(letter) %>" class="btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-2 px-5 text-xs font-bold uppercase tracking-wider cursor-pointer min-h-[38px] shadow-sm">Completar revelación</a>
                  <% else %>
                    <a href="<%= letter_path(letter) %>" class="btn btn-outline border-slate-200 text-slate-700 hover:bg-slate-50 rounded-2xl py-2 px-5 text-xs font-bold uppercase tracking-wider cursor-pointer min-h-[38px]">Ver predicciones vs realidad</a>
                  <% end %>
                </div>
              </div>
            <% else %>
              <%# Countdown status for pending letter %>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50 p-5 rounded-2xl border border-slate-100 text-xs">
                <div class="flex items-center gap-3">
                  <span class="text-xl">⏳</span>
                  <div class="space-y-0.5">
                    <p class="font-bold text-slate-800">Cápsula en tránsito</p>
                    <p class="text-slate-500">Se encuentra resguardada de forma privada en tu baúl temporal.</p>
                  </div>
                </div>

                <% days_left = (letter.deliver_at.to_date - Date.current).to_i %>
                <span class="bg-violet-50 text-violet-700 border border-violet-100 py-2.5 px-4 text-[10px] font-bold uppercase tracking-wider rounded-xl shadow-2xs">
                  Se abre en <%= days_left %> días
                </span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty state %>
      <div class="bg-white border border-slate-100 p-12 rounded-3xl text-center max-w-xl mx-auto space-y-6 shadow-2xs">
        <span class="text-4xl block">📭</span>
        <h3 class="text-xl font-bold text-slate-900">Tu baúl está vacío</h3>
        <p class="text-xs text-slate-500 leading-relaxed max-w-sm mx-auto">No has escrito ninguna carta todavía. Las cartas al futuro te ayudan a reflexionar y comparar tus predicciones con la realidad.</p>
        <a href="<%= new_letter_path %>" class="btn bg-[#2e1065] hover:bg-[#1e0a45] text-white rounded-2xl py-3 px-6 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm">Escribir mi primera carta</a>
      </div>
    <% end %>
  </div>
<% end %>
