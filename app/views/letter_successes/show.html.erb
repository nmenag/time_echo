<div class="max-w-md mx-auto py-12 font-ui select-none animate-fade-in text-center text-base-content">
  <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-8 sm:p-10 space-y-8 relative overflow-hidden shadow-xs">
    <div class="space-y-4 relative">
      <h1 class="font-serif-editorial text-3xl font-semibold text-base-content leading-tight"><%= t('letters.success_header') %></h1>
      <p class="text-xs font-letter text-base-content/70 leading-relaxed">
        <%= t('letters.success_sub').html_safe %>
      </p>

      <div class="relative max-w-[280px] mx-auto border-2 border-dashed border-[#2C485E]/30 dark:border-[#77A3C4]/35 p-4 rounded-xs font-letter text-[9px] tracking-widest text-[#2C485E] dark:text-[#77A3C4] uppercase select-none space-y-1.5 shadow-3xs bg-[#2C485E]/5 dark:bg-[#77A3C4]/10 overflow-hidden">
        <div class="flex justify-between items-center px-1">
          <span><%= t('letters.success_seal') %>: <%= @seal_date_display %></span>
        </div>
        <div class="border-t border-dashed border-[#2C485E]/20 dark:border-[#77A3C4]/20 pt-1.5 flex justify-between items-center px-1 font-serif-editorial italic text-xs tracking-normal text-[#2C485E] dark:text-[#77A3C4]">
          <span><%= t('letters.success_opening') %>:</span>
          <span class="font-semibold font-letter not-italic tracking-tight text-base-content"><%= @deliver_at_display %></span>
        </div>

        <div class="absolute -right-3 -top-2 opacity-15 pointer-events-none text-[#2C485E] dark:text-[#77A3C4] transform rotate-6">
          <svg class="w-20 h-10" fill="none" viewBox="0 0 100 30" stroke="currentColor" stroke-width="1.5">
            <path d="M 0,5 Q 25,12 50,5 T 100,5" />
            <path d="M 0,12 Q 25,19 50,12 T 100,12" />
            <path d="M 0,19 Q 25,26 50,19 T 100,19" />
          </svg>
        </div>
      </div>
    </div>

    <div class="archival-folder rounded-xs p-4 space-y-1.5 border border-[#D5CEBD] dark:border-[#2D3342] text-left font-letter">
      <p class="text-[10px] font-semibold text-[#2C485E] dark:text-[#77A3C4] uppercase tracking-wider"><%= t('letters.success_next_title') %></p>
      <p class="text-xs text-base-content/70 leading-relaxed">
        <%= @next_steps_description %>
      </p>
    </div>

    <div class="pt-6 border-t border-[#D8D2C2] dark:border-[#2D3340] space-y-4 font-letter relative">
      <% if user_signed_in? %>
        <a href="<%= dashboard_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] w-full rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase shadow-xs border-none cursor-pointer font-letter min-h-[44px] flex items-center justify-center">
          <%= t('letters.success_btn_dashboard') %>
        </a>
      <% else %>
        <a href="<%= login_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] w-full rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase shadow-xs border-none cursor-pointer font-letter min-h-[44px] flex items-center justify-center">
          <%= t('letters.success_btn_signin') %>
        </a>
        <p class="text-[11px] text-base-content/50"><%= t('letters.success_signin_help') %></p>
      <% end %>

      <a href="<%= root_path %>" class="text-[10px] font-semibold text-base-content/50 hover:text-base-content transition-colors uppercase tracking-widest flex items-center justify-center gap-1.5 pt-2">
        <%= tabler_icon("arrow-left", size: 12) %>
        <span><%= t('letters.success_btn_home') %></span>
      </a>
    </div>
  </div>
</div>
