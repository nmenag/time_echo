<div class="max-w-md mx-auto py-12 font-sans select-none animate-fade-in text-center text-base-content">
  <div class="bg-base-100 border border-base-200 p-8 sm:p-12 rounded-3xl shadow-sm space-y-8 relative overflow-hidden">
    <!-- Dynamic subtle backing glow in Postmark Ink Indigo -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-[#2C485E]/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="space-y-4 relative">
      <h1 class="font-serif text-3xl font-normal text-base-content leading-tight"><%= t('letters.success_header') %></h1>
      <p class="text-xs text-base-content/60 leading-relaxed font-medium">
        <%= t('letters.success_sub').html_safe %>
      </p>

      <!-- Nostalgic Postmark Stamp Display in Postmark Ink Indigo -->
      <div class="relative max-w-[280px] mx-auto border-2 border-dashed border-[#2C485E]/25 dark:border-[#77A3C4]/30 p-4 rounded-xl font-mono text-[9px] tracking-widest text-[#2C485E] dark:text-[#77A3C4] uppercase select-none space-y-1.5 shadow-3xs bg-[#2C485E]/5 dark:bg-[#77A3C4]/10 overflow-hidden">
        <div class="flex justify-between items-center px-1">
          <span><%= t('letters.success_seal') %>: <%= @seal_date_display %></span>
        </div>
        <div class="border-t border-dashed border-[#2C485E]/20 dark:border-[#77A3C4]/20 pt-1.5 flex justify-between items-center px-1 font-serif italic text-xs tracking-normal text-[#2C485E] dark:text-[#77A3C4]">
          <span><%= t('letters.success_opening') %>:</span>
          <span class="font-bold font-sans not-italic tracking-tight text-base-content"><%= @deliver_at_display %></span>
        </div>

        <!-- Postmark wavy cancellation lines overlay -->
        <div class="absolute -right-3 -top-2 opacity-15 pointer-events-none text-[#2C485E] dark:text-[#77A3C4] transform rotate-6">
          <svg class="w-20 h-10" fill="none" viewBox="0 0 100 30" stroke="currentColor" stroke-width="1.5">
            <path d="M 0,5 Q 25,12 50,5 T 100,5" />
            <path d="M 0,12 Q 25,19 50,12 T 100,12" />
            <path d="M 0,19 Q 25,26 50,19 T 100,19" />
          </svg>
        </div>
      </div>
    </div>

    <div class="p-4 bg-base-200/30 rounded-2xl space-y-2 border border-base-200/50 text-left font-sans shadow-3xs">
      <p class="text-xs font-bold text-[#2C485E] dark:text-[#77A3C4] uppercase tracking-wider"><%= t('letters.success_next_title') %></p>
      <p class="text-xs text-base-content/60 leading-relaxed font-semibold">
        <%= t('letters.success_next_desc', email: @email) %>
      </p>
    </div>

    <div class="pt-6 border-t border-base-200/80 space-y-4 font-sans relative">
      <% if user_signed_in? %>
        <a href="<%= dashboard_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] w-full rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase shadow-xs border-none cursor-pointer font-letter min-h-[44px] flex items-center justify-center">
          <%= t('letters.success_btn_dashboard') %>
        </a>
      <% else %>
        <a href="<%= login_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] w-full rounded-xs py-3.5 px-6 text-xs font-semibold tracking-widest uppercase shadow-xs border-none cursor-pointer font-letter min-h-[44px] flex items-center justify-center">
          <%= t('letters.success_btn_signin') %>
        </a>
        <p class="text-xs text-base-content/40 font-semibold"><%= t('letters.success_signin_help') %></p>
      <% end %>

      <a href="<%= root_path %>" class="text-[10px] font-bold text-base-content/40 hover:text-primary transition-colors duration-200 uppercase tracking-widest flex items-center justify-center gap-1 pt-2">
        <span>&larr;</span> <%= t('letters.success_btn_home') %>
      </a>
    </div>
  </div>
</div>
