<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #f7f4ee;
        color: #2c2a29;
        margin: 0;
        padding: 40px 20px;
        -webkit-font-smoothing: antialiased;
      }
      .letter-container {
        max-width: 600px;
        margin: 0 auto;
        background: #fdfcf9;
        padding: 50px 40px;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(124, 114, 103, 0.08);
        border: 1px solid #e8e2d5;
      }
      .date {
        font-family: -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 13px;
        color: #8c8279;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 30px;
      }
      h1 {
        font-family: "Instrument Serif", Georgia, serif;
        font-size: 28px;
        font-weight: normal;
        font-style: italic;
        line-height: 1.3;
        margin-bottom: 25px;
        color: #1a1a1a;
        border-bottom: 1px solid #f2ece0;
        padding-bottom: 15px;
      }
      .content {
        font-family: Georgia, serif;
        font-size: 16px;
        line-height: 1.8;
        color: #3d3b3a;
        white-space: pre-wrap;
        margin-bottom: 40px;
      }
      .attachment-notice {
        background-color: #f5efe4;
        border: 1px dashed #d1c6b5;
        border-radius: 8px;
        padding: 15px;
        font-size: 14px;
        color: #615a54;
        margin-bottom: 30px;
      }
      .btn {
        display: inline-block;
        background-color: #7c7267;
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 14px;
        transition: background-color 0.2s;
      }
      .footer {
        margin-top: 50px;
        padding-top: 30px;
        border-top: 1px solid #f2ece0;
        font-size: 12px;
        color: #a3998f;
        text-align: center;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="letter-container">
      <div class="date">Written on <%= @letter.created_at.strftime('%B %d, %Y') %></div>
      <h1>A Message from Your Past Self</h1>
      
      <div class="content"><%= @letter.content %></div>

      <% if @letter.attachments.attached? %>
        <div class="attachment-notice">
          <strong>📎 Multimedia Attached:</strong> This letter includes <%= pluralize(@letter.attachments.size, "multimedia file") %>. We have attached them to this email. You can also view them in your secure digital vault.
        </div>
      <% end %>

      <div style="text-align: center; margin-top: 35px;">
        <a class="btn" href="<%= Rails.application.routes.url_helpers.letter_url(@letter.signed_id, host: ENV.fetch('APP_HOST') { 'localhost:3000' }) %>">
          Open in Digital Time Capsule
        </a>
      </div>

      <div class="footer">
        You wrote this letter to yourself via TimeEcho.<br>
        <em>"Sent with hope, received with nostalgia."</em>
      </div>
    </div>
  </body>
</html>
