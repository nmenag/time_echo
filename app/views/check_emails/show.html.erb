<div class="max-w-md mx-auto py-12 font-ui text-center text-base-content animate-fade-in">
  <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-8 sm:p-10 space-y-6 shadow-xs">
    <div class="wax-seal w-16 h-16 rounded-full mx-auto flex items-center justify-center text-[#FAF9F5] select-none shadow-xs">
      <%= tabler_icon("mail", size: 28) %>
    </div>

    <div class="space-y-2">
      <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight">
        <%= t('sessions.check_email_title') %>
      </h1>
      <p class="text-xs font-letter text-base-content/70 leading-relaxed max-w-sm mx-auto">
        <%= t('sessions.check_email_subtitle') %><br>
        <strong class="text-base-content font-semibold"><%= @email %></strong>
      </p>
    </div>

    <div class="archival-folder rounded-xs p-3.5 text-xs font-letter text-base-content/60 leading-relaxed border border-[#D5CEBD] dark:border-[#2D3342]">
      <%= t('sessions.check_email_spam_notice') %>
    </div>

    <div class="pt-3 border-t border-[#D8D2C2] dark:border-[#2D3340]">
      <a href="<%= login_path %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs text-xs font-semibold uppercase tracking-wider font-letter inline-flex items-center gap-1.5 min-h-[44px] px-5 cursor-pointer">
        <%= tabler_icon("arrow-left", size: 14) %>
        <span><%= t('sessions.try_another_email').html_safe %></span>
      </a>
    </div>
  </div>
</div>

