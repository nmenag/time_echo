<div class="max-w-md mx-auto py-12 text-center">
  <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-10 rounded-box shadow-xs space-y-6">
    <div class="w-16 h-16 bg-secondary border border-accent text-primary rounded-full flex items-center justify-center text-3xl mx-auto animate-pulse">
      ✉️
    </div>

    <div class="space-y-3">
      <h1 class="font-serif italic text-3xl text-primary font-normal"><%= t('sessions.check_email_title') %></h1>
      <p class="text-sm text-base-content/60 leading-relaxed font-sans">
        <%= t('sessions.check_email_subtitle') %><br>
        <strong class="text-primary"><%= @email %></strong>.
      </p>
    </div>

    <p class="text-xs text-base-content/40 max-w-xs mx-auto leading-relaxed font-sans">
      <%= t('sessions.check_email_spam_notice') %>
    </p>

    <div class="pt-4 border-t border-base-200 space-y-3">
      <a href="<%= login_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral font-semibold no-underline">
        <%= t('sessions.try_another_email').html_safe %>
      </a>
    </div>
  </div>
</div>

