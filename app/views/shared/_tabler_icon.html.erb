<% icon_name = local_assigns[:name] %>
<% icon_size = local_assigns[:size] || 16 %>
<% icon_class = local_assigns[:class] %>
<i class="ti ti-<%= icon_name %> <%= icon_class %>" style="font-size: <%= icon_size %>px; line-height: 1; display: inline-flex; align-items: center; justify-content: center;" aria-hidden="true"></i>

