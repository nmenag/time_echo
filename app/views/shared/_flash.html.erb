<div id="flash-container">
  <% if flash[:notice].present? %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-2xl shadow-xs flex items-center gap-3.5 py-3.5 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-emerald-950 w-full">
      <span class="text-base shrink-0">✨</span>
      <span class="text-xs font-semibold leading-relaxed"><%= flash[:notice] %></span>
    </div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="bg-rose-50 border border-rose-200 rounded-2xl shadow-xs flex items-center gap-3.5 py-3.5 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-rose-950 w-full">
      <span class="text-base shrink-0">⚠️</span>
      <span class="text-xs font-semibold leading-relaxed"><%= flash[:alert] %></span>
    </div>
  <% end %>
</div>
