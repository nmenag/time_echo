<div id="flash-container">
  <% if flash[:notice].present? %>
    <div class="bg-success/15 border border-success/30 rounded-2xl shadow-xs flex items-center gap-3.5 py-3.5 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-success w-full font-sans">
      <span class="text-base shrink-0">✨</span>
      <span class="text-xs font-semibold leading-relaxed"><%= flash[:notice] %> ✨</span>
    </div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="bg-error/15 border border-error/30 rounded-2xl shadow-xs flex items-center gap-3.5 py-3.5 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-error w-full font-sans">
      <span class="text-base shrink-0">⚠️</span>
      <span class="text-xs font-semibold leading-relaxed"><%= flash[:alert] %></span>
    </div>
  <% end %>
</div>
