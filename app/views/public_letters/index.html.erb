<div class="space-y-12 animate-fade-in">
  <!-- Feed Header -->
  <div class="text-center max-w-2xl mx-auto space-y-4 py-4">
    <div class="badge badge-secondary py-3 px-4 border border-accent text-xs font-semibold tracking-wider uppercase flex gap-1.5 items-center justify-center mx-auto">
      <%= t('public_feed.badge') %>
    </div>
    <h1 class="font-serif italic text-4xl text-primary font-normal tracking-tight"><%= t('public_feed.title') %></h1>
    <p class="text-sm text-base-content/50 leading-relaxed max-w-lg mx-auto">
      <%= t('public_feed.subtitle') %>
    </p>
  </div>

  <!-- Stories Grid -->
  <% if @letters && @letters.any? %>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @letters.each do |letter| %>
        <div class="card card-bordered border-base-200 bg-base-100 p-6 rounded-box card-hover-effect flex flex-col justify-between gap-5">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-[10px] text-base-content/40 font-semibold uppercase tracking-wider">
              <span><%= t('public_feed.written', date: letter.created_at.strftime('%m/%d/%Y')) %></span>
              <span><%= t('public_feed.opened', date: letter.delivered_at.strftime('%m/%d/%Y')) %></span>
            </div>
            
            <p class="text-sm sm:text-base font-serif italic text-base-content/80 leading-relaxed line-clamp-5">
              "<%= letter.content %>"
            </p>
          </div>

          <div class="pt-4 border-t border-base-200 flex justify-between items-center text-xs">
            <span class="flex items-center gap-1.5 text-base-content/50">
              <span>👤</span> <%= t('public_feed.anonymous_traveler') %>
            </span>
            <a href="<%= letter_path(letter) %>" class="btn btn-link btn-xs text-primary p-0 min-h-0 h-auto hover:underline font-semibold">
              <%= t('public_feed.btn_read').html_safe %>
            </a>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty Feed State -->
    <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-12 rounded-3xl text-center max-w-xl mx-auto space-y-6 shadow-xs">
      <div class="w-16 h-16 bg-base-200/50 text-base-content/30 rounded-full flex items-center justify-center text-2xl mx-auto select-none border border-base-200">
        🌍
      </div>
      <div class="space-y-2">
        <h3 class="font-serif italic text-2xl text-primary font-normal"><%= t('public_feed.empty_title') %></h3>
        <p class="text-sm text-base-content/50 leading-relaxed max-w-sm mx-auto font-sans">
          <%= t('public_feed.empty_desc') %>
        </p>
      </div>
      <a href="<%= new_letter_path %>" class="btn btn-primary rounded-xl px-6 font-semibold text-xs tracking-wider uppercase shadow-xs">
        <%= t('public_feed.empty_btn') %>
      </a>
    </div>
  <% end %>

  <!-- Bottom CTA Banner -->
  <div class="card card-bordered border-base-200 bg-base-200/40 p-8 sm:p-10 rounded-2xl text-center space-y-5 max-w-3xl mx-auto mt-12">
    <h3 class="font-serif text-2xl text-primary font-normal"><%= t('public_feed.cta_title') %></h3>
    <p class="text-sm text-base-content/50 max-w-md mx-auto leading-relaxed"><%= t('public_feed.cta_desc') %></p>
    <div class="pt-2">
      <a href="<%= new_letter_path %>" class="btn btn-primary rounded-xl px-6 font-semibold text-xs tracking-wider uppercase shadow-xs">
        <%= t('public_feed.empty_btn') %>
      </a>
    </div>
  </div>
</div>
