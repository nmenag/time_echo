<div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
  <div class="text-center mb-12">
    <h1 class="font-serif italic text-4xl sm:text-5xl text-primary font-normal mb-4">
      <%= t('pages.privacy.title') %>
    </h1>
    <p class="text-sm text-base-content/60">
      <%= t('pages.privacy.last_updated') %>
    </p>
  </div>

  <div class="prose prose-base max-w-none space-y-8">
    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.privacy.sections.intro.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.privacy.sections.intro.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.privacy.sections.collect.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.privacy.sections.collect.description') %>
      </p>
      <ul class="list-disc list-inside text-sm text-base-content/80 space-y-2 ml-4">
        <li><%= t('pages.privacy.sections.collect.item_email') %></li>
        <li><%= t('pages.privacy.sections.collect.item_letters') %></li>
        <li><%= t('pages.privacy.sections.collect.item_predictions') %></li>
        <li><%= t('pages.privacy.sections.collect.item_emotional') %></li>
        <li><%= t('pages.privacy.sections.collect.item_preferences') %></li>
        <li><%= t('pages.privacy.sections.collect.item_technical') %></li>
      </ul>
