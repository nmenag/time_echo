<div class="max-w-3xl mx-auto px-4 py-12 sm:py-16 font-ui animate-fade-in text-base-content">
  <div class="text-center mb-12 space-y-3">
    <h1 class="font-serif-editorial text-4xl sm:text-5xl text-base-content font-semibold tracking-tight">
      <%= t('pages.about.title') %>
    </h1>
    <p class="text-xs sm:text-sm text-base-content/70 font-letter max-w-xl mx-auto leading-relaxed">
      <%= t('pages.about.subtitle') %>
    </p>
  </div>

  <div class="space-y-10">
    <section class="space-y-3 paper-sheet rounded-xs p-6 sm:p-8 border border-[#D8D2C2] dark:border-[#2D3340]">
      <h2 class="font-serif-editorial text-2xl text-base-content font-semibold"><%= t('pages.about.sections.what_is.title') %></h2>
      <p class="text-xs font-letter text-base-content/70 leading-relaxed">
        <%= t('pages.about.sections.what_is.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <div class="border-b border-[#D8D2C2] dark:border-[#2D3340] pb-2">
        <h2 class="font-serif-editorial text-2xl text-base-content font-semibold"><%= t('pages.about.sections.how_works.title') %></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-letter">
        <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="postmark-stamp text-[10px] py-0.5 px-2 inline-flex items-center gap-1">
              <%= tabler_icon("pencil", size: 12) %>
              <span>№ 01</span>
            </span>
          </div>
          <h3 class="font-serif-editorial font-semibold text-sm text-base-content"><%= t('pages.about.sections.how_works.step_write_title') %></h3>
          <p class="text-xs text-base-content/70 leading-relaxed"><%= t('pages.about.sections.how_works.step_write_desc') %></p>
        </div>
        <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="postmark-stamp text-[10px] py-0.5 px-2 inline-flex items-center gap-1">
              <%= tabler_icon("lock", size: 12) %>
              <span>№ 02</span>
            </span>
          </div>
          <h3 class="font-serif-editorial font-semibold text-sm text-base-content"><%= t('pages.about.sections.how_works.step_seal_title') %></h3>
          <p class="text-xs text-base-content/70 leading-relaxed"><%= t('pages.about.sections.how_works.step_seal_desc') %></p>
        </div>
        <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="postmark-stamp text-[10px] py-0.5 px-2 inline-flex items-center gap-1">
              <%= tabler_icon("clock", size: 12) %>
              <span>№ 03</span>
            </span>
          </div>
          <h3 class="font-serif-editorial font-semibold text-sm text-base-content"><%= t('pages.about.sections.how_works.step_wait_title') %></h3>
          <p class="text-xs text-base-content/70 leading-relaxed"><%= t('pages.about.sections.how_works.step_wait_desc') %></p>
        </div>
        <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="postmark-stamp text-[10px] py-0.5 px-2 inline-flex items-center gap-1">
              <%= tabler_icon("mail", size: 12) %>
              <span>№ 04</span>
            </span>
          </div>
          <h3 class="font-serif-editorial font-semibold text-sm text-base-content"><%= t('pages.about.sections.how_works.step_receive_title') %></h3>
          <p class="text-xs text-base-content/70 leading-relaxed"><%= t('pages.about.sections.how_works.step_receive_desc') %></p>
        </div>
      </div>
    </section>

    <section class="space-y-3 paper-sheet rounded-xs p-6 sm:p-8 border border-[#D8D2C2] dark:border-[#2D3340]">
      <h2 class="font-serif-editorial text-2xl text-base-content font-semibold"><%= t('pages.about.sections.why_exists.title') %></h2>
      <p class="text-xs font-letter text-base-content/70 leading-relaxed">
        <%= t('pages.about.sections.why_exists.description') %>
      </p>
    </section>

    <section class="space-y-3 paper-sheet rounded-xs p-6 sm:p-8 border border-[#D8D2C2] dark:border-[#2D3340]">
      <h2 class="font-serif-editorial text-2xl text-base-content font-semibold"><%= t('pages.about.sections.philosophy.title') %></h2>
      <p class="text-xs font-letter text-base-content/70 leading-relaxed">
        <%= t('pages.about.sections.philosophy.description') %>
      </p>
    </section>
  </div>
</div>
