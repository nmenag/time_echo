<div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
  <div class="text-center mb-12">
    <h1 class="font-serif italic text-4xl sm:text-5xl text-primary font-normal mb-4">
      <%= t('pages.terms.title') %>
    </h1>
    <p class="text-sm text-base-content/60">
      <%= t('pages.terms.last_updated') %>
    </p>
  </div>

  <div class="prose prose-base max-w-none space-y-8">
    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.acceptance.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.acceptance.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.about.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.about.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.accounts.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.accounts.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.creating.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.creating.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.delivery.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.delivery.description') %>
      </p>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.delivery.disclaimer') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.responsibilities.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.responsibilities.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.content.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.content.description') %>
      </p>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.content.license') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.prohibited.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.prohibited.description') %>
      </p>
      <ul class="list-disc list-inside text-sm text-base-content/80 space-y-2 ml-4">
        <li><%= t('pages.terms.sections.prohibited.item_spam') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_harassment') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_threats') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_fraud') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_impersonation') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_illegal') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_malware') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_abuse') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_unauthorized') %></li>
        <li><%= t('pages.terms.sections.prohibited.item_infringement') %></li>
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.recipient.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.recipient.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.intellectual.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.intellectual.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.availability.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.availability.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.termination.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.termination.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.liability.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.liability.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.changes.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.changes.description') %>
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-2xl text-base-content font-normal"><%= t('pages.terms.sections.contact.title') %></h2>
      <p class="text-sm text-base-content/80 leading-relaxed">
        <%= t('pages.terms.sections.contact.description') %>
      </p>
    </section>
  </div>
</div>
