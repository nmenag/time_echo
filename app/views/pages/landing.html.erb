<script>
  document.addEventListener("DOMContentLoaded", () => {
    const textarea = document.getElementById("landing_content_area");
    const counter = document.getElementById("landing_char_counter");
    if (textarea && counter) {
      const updateCounter = () => {
        const length = textarea.value.length;
        counter.innerText = `${length} / 2000`;
      };
      textarea.addEventListener("input", updateCounter);
      updateCounter();
    }

    // Set default preset on load (1 year)
    const defaultBtn = document.getElementById('default-date-btn');
    if (defaultBtn) {
      setPresetDate(defaultBtn, 365);
    }
  });

  // Calculate & Set hidden delivery date
  function setPresetDate(button, days) {
    document.getElementById('custom-date-container').classList.add('hidden');
    
    const targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + days);
    const y = targetDate.getFullYear();
    const m = String(targetDate.getMonth() + 1).padStart(2, '0');
    const d = String(targetDate.getDate()).padStart(2, '0');
    
    document.getElementById('letter_deliver_at_hidden').value = `${y}-${m}-${d}`;
    
    // Toggle active state classes
    const buttons = button.parentNode.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.className = "border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all font-semibold cursor-pointer";
    });
    button.className = "border border-[#5b21b6]/40 bg-[#5b21b6]/5 text-[#5b21b6] py-2.5 rounded-xl font-bold transition-all cursor-pointer";
  }

  function toggleCustomDate(button) {
    const container = document.getElementById('custom-date-container');
    container.classList.remove('hidden');
    
    const buttons = button.parentNode.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.className = "border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all font-semibold cursor-pointer";
    });
    button.className = "border border-[#5b21b6]/40 bg-[#5b21b6]/5 text-[#5b21b6] py-2.5 rounded-xl font-bold transition-all cursor-pointer";
    
    const customInput = document.getElementById('custom-date-input');
    if (customInput.value) {
      setCustomDate(customInput.value);
    }
  }

  function setCustomDate(val) {
    if (val) {
      document.getElementById('letter_deliver_at_hidden').value = val;
    }
  }
</script>
