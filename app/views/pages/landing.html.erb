<div class="space-y-28 max-w-6xl mx-auto -mt-6 font-sans">
  
  <!-- Hero Section -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pt-4">
    
    <!-- Left Column: Branding, Value Props & Cliff Photo -->
    <div class="lg:col-span-5 space-y-8 lg:sticky lg:top-24">
      <div class="space-y-6">
        <!-- Elegant Serif Headline -->
        <h1 class="font-serif text-5xl sm:text-6xl font-normal text-base-content leading-tight">
          Escribe hoy.<br>Descubre mañana.
        </h1>

        <!-- Subheadline -->
        <p class="text-sm sm:text-base text-base-content/60 leading-relaxed max-w-xl">
          Escribe una carta a tu futuro, haz predicciones y descubre cómo realmente evolucionas con el tiempo.
        </p>
      </div>

      <!-- Value Props List -->
      <div class="space-y-5 pt-2">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#5b21b6]/5 flex items-center justify-center text-lg text-[#5b21b6] shrink-0 border border-[#5b21b6]/10">
            🔒
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider">Privado y seguro</h4>
            <p class="text-xs text-base-content/50 leading-relaxed">Solo tú puedes abrir tu carta cuando llegue el momento.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#5b21b6]/5 flex items-center justify-center text-lg text-[#5b21b6] shrink-0 border border-[#5b21b6]/10">
            🕒
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider">Entregado a tiempo</h4>
            <p class="text-xs text-base-content/50 leading-relaxed">Tu carta será guardada y te la enviaremos en la fecha que elijas.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#5b21b6]/5 flex items-center justify-center text-lg text-[#5b21b6] shrink-0 border border-[#5b21b6]/10">
            💜
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider">Conecta contigo</h4>
            <p class="text-xs text-base-content/50 leading-relaxed">Compara tus predicciones con tu realidad y reflexiona sobre tu evolución.</p>
          </div>
        </div>
      </div>

      <!-- Young Man Sunset Cliff Image Mockup with hand-written overlay -->
      <div class="relative overflow-hidden rounded-3xl border border-base-200/80 shadow-md max-w-md group">
        <img src="/images/hero_cliff.png" class="w-full h-80 object-cover hover:scale-105 transition-transform duration-700" alt="Reflexión sobre el futuro">
        
        <!-- Interactive Hand-drawn handwriting note & arrow absolute overlay -->
        <div class="absolute bottom-16 right-10 flex flex-col items-center select-none pointer-events-none transform rotate-3">
          <span class="font-handwritten text-xl sm:text-2xl text-[#5b21b6] bg-white/70 backdrop-blur-xs px-3 py-1 rounded-xl shadow-2xs">
            💜 Para ti, desde hoy
          </span>
          <!-- Hand-drawn SVG curved arrow pointing from text to horizon -->
          <svg class="w-16 h-12 text-[#5b21b6] mt-1 drop-shadow-sm" fill="none" viewBox="0 0 50 40" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10,5 Q20,30 40,25" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M35,20 L40,25 L34,30" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Right Column: Premium Interactive Writing Form Card -->
    <div class="lg:col-span-7 bg-white border border-base-200 p-6 sm:p-8 rounded-3xl shadow-sm space-y-6">
      
      <!-- Card Title & Progress segment bar matching the image -->
      <div class="border-b border-base-100 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h2 class="font-serif text-2xl text-base-content font-semibold flex items-center gap-2">
            <span>✍️</span> Escribe tu carta a tu futuro <span class="text-[#5b21b6]">✨</span>
          </h2>
        </div>
        
        <!-- Multi-segment Onboarding Steps bar (1 de 4) -->
        <div class="flex items-center gap-2 shrink-0 select-none text-[11px] font-bold text-base-content/40">
          <span>1 de 4</span>
          <div class="flex items-center gap-1">
            <span class="w-8 h-1.5 rounded-full bg-[#5b21b6]"></span>
            <span class="w-8 h-1.5 rounded-full bg-base-200"></span>
            <span class="w-8 h-1.5 rounded-full bg-base-200"></span>
            <span class="w-8 h-1.5 rounded-full bg-base-200"></span>
          </div>
        </div>
      </div>

      <!-- Form submissions direct to letters_path -->
      <%= form_with model: LetterForm.new, url: letters_path, local: true, class: "space-y-6" do |f| %>
        <%= f.hidden_field :title, value: "Mi carta al futuro" %>
        <%= f.hidden_field :deliver_at, id: "letter_deliver_at_hidden" %>

        <!-- Tu carta textarea block -->
        <div class="space-y-3">
          <label class="text-xs font-bold text-[#111827] uppercase tracking-wider block">Tu carta</label>
          <%= f.text_area :content, id: "landing_content_area", placeholder: "Querido yo del futuro...", rows: 8, class: "textarea w-full p-4 border border-base-200 focus:border-[#5b21b6]/40 focus:outline-none rounded-2xl font-brand-serif text-sm sm:text-base leading-relaxed placeholder:font-brand-sans placeholder:text-xs placeholder:text-base-content/30 resize-y bg-white shadow-3xs", required: true %>
          <!-- Character count indicator -->
          <div class="flex justify-end text-[10px] text-base-content/30 font-mono">
            <span id="landing_char_counter">0 / 2000</span>
          </div>
        </div>

        <!-- ¿Cuándo quieres recibirla? buttons -->
        <div class="space-y-3">
          <label class="text-xs font-bold text-[#111827] uppercase tracking-wider block">¿Cuándo quieres recibirla?</label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-[11px] font-semibold">
            <button type="button" onclick="setPresetDate(this, 180)" class="border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all cursor-pointer">6 meses</button>
            <button type="button" id="default-date-btn" onclick="setPresetDate(this, 365)" class="border border-[#5b21b6]/40 bg-[#5b21b6]/5 text-[#5b21b6] py-2.5 rounded-xl font-bold transition-all cursor-pointer">1 año</button>
            <button type="button" onclick="setPresetDate(this, 1095)" class="border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all cursor-pointer">3 años</button>
            <button type="button" onclick="setPresetDate(this, 1825)" class="border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all cursor-pointer">5 años</button>
            <button type="button" onclick="toggleCustomDate(this)" class="col-span-2 sm:col-span-1 border border-base-200 py-2.5 rounded-xl hover:bg-base-200/40 transition-all flex items-center justify-center gap-1 cursor-pointer">
              <span>Fecha personalizada</span>
              <span>📅</span>
            </button>
          </div>
          <!-- Custom Date Input container (collapsible) -->
          <div id="custom-date-container" class="hidden animate-fade-in">
            <div class="bg-base-200/30 border border-base-200 p-3 rounded-2xl">
              <label class="text-[10px] text-base-content/40 font-bold uppercase tracking-wider block mb-1">Elige una fecha específica</label>
              <input type="date" id="custom-date-input" min="<%= (Date.current + 1.day).to_s %>" onchange="setCustomDate(this.value)" class="input input-bordered w-full rounded-xl bg-white text-slate-900 border-slate-200/80 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12 px-4">
            </div>
          </div>
        </div>

        <!-- Tus predicciones (opcional) grid -->
        <div class="space-y-4">
          <div class="flex justify-between items-center border-b border-base-100 pb-1">
            <label class="text-xs font-bold text-[#111827] uppercase tracking-wider block">Tus predicciones (opcional)</label>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-medium">
            <!-- Where will you live -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm text-[#5b21b6]">📍</span>
              <%= f.text_field :prediction_city, placeholder: "¿Dónde crees que vivirás?", class: "input input-bordered w-full pl-9 rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12" %>
            </div>

            <!-- What will you do -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm text-[#5b21b6]">💼</span>
              <%= f.text_field :prediction_career, placeholder: "¿A qué te dedicarás?", class: "input input-bordered w-full pl-9 rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12" %>
            </div>

            <!-- How much will you earn -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm text-[#5b21b6]">💵</span>
              <%= f.text_field :prediction_salary, placeholder: "¿Cuánto dinero crees que ganarás?", class: "input input-bordered w-full pl-9 rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12" %>
            </div>

            <!-- Relationship status -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm text-[#5b21b6]">💜</span>
              <%= f.text_field :prediction_relationship, placeholder: "¿Cómo será tu relación sentimental?", class: "input input-bordered w-full pl-9 rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12" %>
            </div>

            <!-- Biggest achievement -->
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-sm text-[#5b21b6]">⭐️</span>
              <%= f.text_field :prediction_achievement, placeholder: "¿Cuál será tu mayor logro?", class: "input input-bordered w-full pl-9 rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-xs hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12" %>
            </div>

            <!-- Happiness prediction slider card (h-12 offset matching mockup) -->
            <div class="bg-white border border-slate-200/80 p-2.5 px-3 rounded-xl shadow-2xs space-y-1 relative pl-10 flex flex-col justify-center h-12">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-[#5b21b6]">🤖</span>
              <div class="flex justify-between items-center text-[10px] font-bold text-slate-700 uppercase tracking-wide leading-none">
                <span>¿Qué tan feliz serás?</span>
                <span id="landing_pred_happiness_val" class="font-extrabold text-[#5b21b6] font-mono">5 / 10</span>
              </div>
              <input type="range" name="letter_form[prediction_happiness]" value="5" min="1" max="10" class="w-full accent-[#5b21b6] cursor-pointer h-3" oninput="document.getElementById('landing_pred_happiness_val').innerText = this.value + ' / 10'">
            </div>
          </div>
        </div>

        <!-- ¿Cómo te sientes hoy? sliders grid -->
        <div class="space-y-3">
          <label class="text-xs font-bold text-[#111827] uppercase tracking-wider block">¿Cómo te sientes hoy?</label>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
            <!-- Felicidad -->
            <div class="bg-base-200/30 border border-base-200/50 p-3.5 rounded-2xl space-y-2">
              <div class="flex justify-between items-center text-primary font-semibold">
                <span class="flex items-center gap-1.5">😃 Felicidad</span>
                <span id="landing_happiness_val" class="font-bold text-[#5b21b6] font-mono">6 / 10</span>
              </div>
              <input type="range" name="letter_form[happiness_level]" value="6" min="1" max="10" class="w-full accent-[#5b21b6] cursor-pointer" oninput="document.getElementById('landing_happiness_val').innerText = this.value + ' / 10'">
            </div>

            <!-- Ansiedad -->
            <div class="bg-base-200/30 border border-base-200/50 p-3.5 rounded-2xl space-y-2">
              <div class="flex justify-between items-center text-primary font-semibold">
                <span class="flex items-center gap-1.5">😩 Ansiedad</span>
                <span id="landing_anxiety_val" class="font-bold text-[#5b21b6] font-mono">4 / 10</span>
              </div>
              <input type="range" name="letter_form[anxiety_level]" value="4" min="1" max="10" class="w-full accent-[#5b21b6] cursor-pointer" oninput="document.getElementById('landing_anxiety_val').innerText = this.value + ' / 10'">
            </div>

            <!-- Motivacion -->
            <div class="bg-base-200/30 border border-base-200/50 p-3.5 rounded-2xl space-y-2">
              <div class="flex justify-between items-center text-primary font-semibold">
                <span class="flex items-center gap-1.5">⭐️ Motivación</span>
                <span id="landing_motivation_val" class="font-bold text-[#5b21b6] font-mono">7 / 10</span>
              </div>
              <input type="range" name="letter_form[motivation_level]" value="7" min="1" max="10" class="w-full accent-[#5b21b6] cursor-pointer" oninput="document.getElementById('landing_motivation_val').innerText = this.value + ' / 10'">
            </div>
          </div>
        </div>

        <!-- ¿A dónde te enviamos tu carta? email field & purple CTA -->
        <div class="space-y-3 pt-2">
          <label class="text-xs font-bold text-[#111827] uppercase tracking-wider block">¿A dónde te enviamos tu carta?</label>
          <div class="flex flex-col sm:flex-row gap-2.5">
            <%= f.email_field :email, placeholder: "tu@email.com", class: "input input-bordered w-full rounded-xl bg-white text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-sm hover:border-slate-300 focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-2xs h-12 px-4 font-sans", required: true %>
            <button type="submit" class="btn bg-[#5b21b6] hover:bg-[#4c1d95] text-white rounded-2xl px-7 text-xs font-bold tracking-wider uppercase shadow-md transition-all duration-300 cursor-pointer flex items-center justify-center gap-1.5 shrink-0 py-3.5 border-none font-sans">
              <span>Enviar a mi yo futuro</span>
              <span>🚀</span>
            </button>
          </div>
        </div>

        <!-- Secure Badge footer -->
        <div class="flex items-center justify-center gap-1.5 text-[10px] text-base-content/40 pt-2 border-t border-base-100">
          <span>🔒</span>
          <span>Tu carta es 100% privada y segura.</span>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Así se verá cuando abras tu carta section -->
  <section class="space-y-12">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-4xl text-base-content font-semibold">Así se verá cuando abras tu carta</h2>
      <p class="text-xs text-base-content/40 max-w-md mx-auto leading-relaxed">
        Compara tus predicciones con tu realidad y reflexiona sobre tu evolución.
      </p>
    </div>

    <!-- Beautiful Browser Mockup Panel -->
    <div class="bg-white border border-base-200 rounded-3xl shadow-md overflow-hidden max-w-5xl mx-auto font-sans relative">
      <!-- Browser Top Bar -->
      <div class="bg-base-200/50 px-5 py-3 border-b border-base-200/70 flex items-center justify-between">
        <!-- Control dots -->
        <div class="flex items-center gap-1.5 select-none">
          <span class="w-3 h-3 rounded-full bg-[#cf8a8a] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#ebdcb9] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#a3b899] inline-block"></span>
        </div>
        <div class="bg-white/80 border border-base-200 rounded-xl px-8 py-1.5 text-[10px] font-medium text-base-content/40 font-mono tracking-wide w-72 text-center truncate select-none shadow-3xs">
          https://app.timeecho.com/letters/revealed
        </div>
        <div class="w-12"></div>
      </div>

      <!-- App Inside content grid -->
      <div class="grid grid-cols-1 md:grid-cols-12 min-h-[500px]">
        <!-- Left Sidebar Navigation Mock -->
        <aside class="md:col-span-3 bg-[#fafaf9] border-r border-base-200/80 p-6 flex flex-col justify-between space-y-8 select-none">
          <div class="space-y-8">
            <!-- Brand -->
            <div class="space-y-1 text-primary">
              <span class="flex items-center gap-1 text-lg font-brand-serif italic font-semibold text-[#111827]">
                TimeEcho
                <span class="text-[#5b21b6] text-xs font-sans relative -top-1 font-bold">+</span>
              </span>
            </div>

            <!-- Sidebar links -->
            <nav class="space-y-1.5 text-[12px] font-semibold text-base-content/70">
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-white text-[#5b21b6] border border-base-200/70 shadow-3xs font-bold">
                <span class="text-sm">📝</span>
                <span>Mis cartas</span>
              </div>
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl hover:bg-base-200/50 cursor-pointer transition-colors">
                <span class="text-sm">🕒</span>
                <span>Línea de tiempo</span>
              </div>
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl hover:bg-base-200/50 cursor-pointer transition-colors">
                <span class="text-sm">💡</span>
                <span>Recuerdos</span>
              </div>
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl hover:bg-base-200/50 cursor-pointer transition-colors">
                <span class="text-sm">📊</span>
                <span>Estadísticas</span>
              </div>
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl hover:bg-base-200/50 cursor-pointer transition-colors">
                <span class="text-sm">⚙️</span>
                <span>Ajustes</span>
              </div>
            </nav>
          </div>

          <!-- Bottom inspirational card -->
          <div class="space-y-3 border-t border-base-200/80 pt-4">
            <p class="text-[10px] font-brand-serif italic text-primary/80 leading-relaxed font-semibold">
              "El futuro no es algo que llega, es algo que creas. 🪄"
            </p>
            <div class="text-[10px] text-[#5b21b6] font-bold">✦</div>
          </div>
        </aside>

        <!-- Main Workspace mock -->
        <main class="md:col-span-9 p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-white">
          
          <!-- Predicción vs Realidad Matrix Comparison Card -->
          <div class="lg:col-span-7 space-y-4">
            <div class="border-b border-base-100 pb-3">
              <h3 class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-1.5">
                Predicción vs Realidad <span class="text-[#5b21b6]">✨</span>
              </h3>
            </div>

            <!-- Real comparisons matching user's image exactly -->
            <div class="space-y-3 text-xs">
              
              <!-- Item 1: City -->
              <div class="bg-base-200/20 border border-base-200/50 p-3.5 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-semibold text-base-content/80 shadow-3xs">
                <div class="flex items-center gap-3">
                  <span class="text-base text-[#5b21b6] shrink-0">📍</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Predicción</p>
                    <p class="text-primary font-bold">Viviré en Barcelona</p>
                  </div>
                  <span class="text-base-content/30 hidden sm:inline">&rarr;</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Realidad</p>
                    <p class="text-primary font-bold">Vivo en Medellín</p>
                  </div>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-600 border border-amber-200/40 text-[9px] font-extrabold uppercase tracking-wide self-start sm:self-auto shrink-0">Parcialmente</span>
              </div>

              <!-- Item 2: Career -->
              <div class="bg-base-200/20 border border-base-200/50 p-3.5 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-semibold text-base-content/80 shadow-3xs">
                <div class="flex items-center gap-3">
                  <span class="text-base text-[#5b21b6] shrink-0">💼</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Predicción</p>
                    <p class="text-primary font-bold">Seré diseñadora freelance</p>
                  </div>
                  <span class="text-base-content/30 hidden sm:inline">&rarr;</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Realidad</p>
                    <p class="text-primary font-bold">Soy Product Designer</p>
                  </div>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200/40 text-[9px] font-extrabold uppercase tracking-wide self-start sm:self-auto shrink-0">¡Acertaste!</span>
              </div>

              <!-- Item 3: Salary -->
              <div class="bg-base-200/20 border border-base-200/50 p-3.5 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-semibold text-base-content/80 shadow-3xs">
                <div class="flex items-center gap-3">
                  <span class="text-base text-[#5b21b6] shrink-0">💵</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Predicción</p>
                    <p class="text-primary font-bold">Ganaré $5.000.000 COP</p>
                  </div>
                  <span class="text-base-content/30 hidden sm:inline">&rarr;</span>
                  <div class="space-y-0.5">
                    <p class="text-[9px] text-base-content/40 font-bold uppercase">Realidad</p>
                    <p class="text-primary font-bold">Gano $7.200.000 COP</p>
                  </div>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/40 text-[9px] font-extrabold uppercase tracking-wide self-start sm:self-auto shrink-0">¡Superaste! 🚀</span>
