      <span><%= t('brand') %></span>
    </div>
    <p class="text-xs font-letter text-base-content/50 leading-relaxed">
      <%= t('footer_copy') %>
    </p>
  </footer>
</div>

<script>
  function initLandingCharCounter() {
    const textarea = document.getElementById("landing_content_area");
    const counter = document.getElementById("landing_char_counter");
    if (textarea && counter) {
      const updateCounter = () => {
        const len = textarea.value.length;
        if (len < 80) {
          const templateMin = counter.dataset.templateMin || `${len} / 80 min (2000 max)`;
          counter.innerText = templateMin.replace("__COUNT__", len);
          counter.classList.add("text-[#8E2818]", "opacity-80");
          counter.classList.remove("text-base-content/50");
        } else {
          counter.innerText = `${len} / 2000`;
          counter.classList.remove("text-[#8E2818]", "opacity-80");
          counter.classList.add("text-base-content/50");
        }
      };
      textarea.removeEventListener("input", updateCounter);
      textarea.addEventListener("input", updateCounter);
      updateCounter();
    }
  }

  function initLandingTimezone() {
    const tzInput = document.getElementById("landing_timezone_input");
    if (tzInput) {
      const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (userTz) tzInput.value = userTz;
    }
  }

  function initLandingDefaultDate() {
    const defaultBtn = document.getElementById('default-date-btn');
    if (defaultBtn) {
      setPresetDate(defaultBtn, 365);
    }
  }

  document.addEventListener("turbo:load", () => {
    initLandingCharCounter();
    initLandingTimezone();
    initLandingDefaultDate();
  });
  window.addEventListener("pageshow", () => {
    initLandingCharCounter();
    initLandingTimezone();
    initLandingDefaultDate();
  });
  document.addEventListener("DOMContentLoaded", () => {
    initLandingCharCounter();
    initLandingTimezone();
    initLandingDefaultDate();
  });
  initLandingTimezone();
  initLandingCharCounter();
  initLandingDefaultDate();

  function setPresetDate(button, days) {
    const customContainer = document.getElementById('custom-date-container');
    if (customContainer) customContainer.classList.add('hidden');

    const targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + days);
    const y = targetDate.getFullYear();
    const m = String(targetDate.getMonth() + 1).padStart(2, '0');
    const d = String(targetDate.getDate()).padStart(2, '0');

    const hiddenField = document.getElementById('letter_deliver_at_hidden');
    if (hiddenField) hiddenField.value = `${y}-${m}-${d}`;

    const buttons = button.parentNode.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.className = "border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer";
    });
    button.className = "border border-[#8E2818] bg-[#8E2818] text-[#FAF9F5] py-2 rounded-xs font-semibold font-letter text-xs uppercase tracking-wider transition-all cursor-pointer";
  }

  function toggleCustomDate(button) {
    const container = document.getElementById('custom-date-container');
    if (container) container.classList.remove('hidden');

    const buttons = button.parentNode.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.className = "border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer";
    });
    button.className = "border border-[#8E2818] bg-[#8E2818] text-[#FAF9F5] py-2 rounded-xs font-semibold font-letter text-xs uppercase tracking-wider transition-all cursor-pointer";

    const customInput = document.getElementById('custom-date-input');
    if (customInput && customInput.value) {
      setCustomDate(customInput.value);
    }
  }

  function setCustomDate(val) {
    const hiddenField = document.getElementById('letter_deliver_at_hidden');
    if (hiddenField && val) {
      hiddenField.value = val;
    }
  }
</script>
