<div class="space-y-24">
  <!-- Hero Section -->
  <section class="text-center max-w-3xl mx-auto py-12 space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-warm-gray-200/50 border border-warm-gray-200 text-warm-gray-800 text-xs font-medium rounded-full tracking-wider uppercase">
      ⏳ TimeEcho Digital Capsule
    </div>
    
    <h1 class="font-serif italic text-5xl sm:text-6xl text-warm-gray-900 tracking-tight leading-tight">
      Write a letter to your<br>
      <span class="text-warm-gray-900 underline decoration-warm-gray-200 decoration-wavy underline-offset-8">future self</span>.
    </h1>
    
    <p class="text-lg text-warm-gray-500 font-sans max-w-xl mx-auto leading-relaxed">
      TimeEcho lets you capture your present thoughts, hopes, and memories, sealing them away in a secure digital vault until the perfect day in the future.
    </p>

    <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="<%= new_letter_path %>" class="px-8 py-4 bg-warm-gray-800 text-white rounded-xl hover:bg-warm-gray-900 transition-all font-semibold shadow-md hover:shadow-lg hover:-translate-y-0.5 text-base duration-200">
        Write Your Capsule Letter
      </a>
      <a href="#how-it-works" class="px-6 py-4 bg-white border border-warm-gray-200 text-warm-gray-800 rounded-xl hover:bg-warm-gray-50 transition-all font-semibold text-base duration-200">
        How It Works
      </a>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="space-y-12 scroll-mt-24">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-3xl text-warm-gray-900">Simple & Significant</h2>
      <p class="text-sm text-warm-gray-500 max-w-md mx-auto">Three simple steps to connect your present mind with your future self.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Step 1 -->
      <div class="bg-white border border-warm-gray-200/60 p-8 rounded-2xl space-y-4 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-warm-gray-200/50 text-warm-gray-800 rounded-xl flex items-center justify-center font-bold text-lg">1</div>
        <h3 class="font-semibold text-lg text-warm-gray-900">Pour Your Heart Out</h3>
        <p class="text-sm text-warm-gray-500 leading-relaxed">
          Write freely about your hopes, fears, current habits, or raw feelings. You can securely upload photos, audio logs, or documents.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-white border border-warm-gray-200/60 p-8 rounded-2xl space-y-4 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-warm-gray-200/50 text-warm-gray-800 rounded-xl flex items-center justify-center font-bold text-lg">2</div>
        <h3 class="font-semibold text-lg text-warm-gray-900">Choose the Delivery</h3>
        <p class="text-sm text-warm-gray-500 leading-relaxed">
          Pick a target delivery date. It could be in 6 months, on your next birthday, 5 years from now, or a decade down the line.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-white border border-warm-gray-200/60 p-8 rounded-2xl space-y-4 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-warm-gray-200/50 text-warm-gray-800 rounded-xl flex items-center justify-center font-bold text-lg">3</div>
        <h3 class="font-semibold text-lg text-warm-gray-900">Receive an Echo</h3>
        <p class="text-sm text-warm-gray-500 leading-relaxed">
          On the chosen morning, the capsule opens, sending your letter back to your inbox as a nostalgic, emotional echo from the past.
        </p>
      </div>
    </div>
  </section>

  <!-- Community Public Stories Feed Preview -->
  <% if @public_letters.any? %>
    <section class="space-y-12">
      <div class="flex items-end justify-between border-b border-warm-gray-200/60 pb-4">
        <div class="space-y-2">
          <h2 class="font-serif text-3xl text-warm-gray-900">Shared Memories</h2>
          <p class="text-sm text-warm-gray-500">Publicly shared letters from users whose capsules have opened.</p>
        </div>
        <a href="<%= public_feed_letters_path %>" class="text-sm font-semibold text-warm-gray-800 hover:underline">
          View all public stories &rarr;
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <% @public_letters.each do |letter| %>
          <div class="bg-white border border-warm-gray-200/60 p-6 rounded-2xl flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <span class="text-xs text-warm-gray-500">
                Opened <%= letter.delivered_at.strftime('%B %d, %Y') %>
              </span>
              <p class="text-sm text-warm-gray-800 font-serif italic line-clamp-4 leading-relaxed">
                "<%= letter.content %>"
              </p>
            </div>
            <div class="pt-6 border-t border-warm-gray-100 flex justify-between items-center text-xs text-warm-gray-500">
              <span>By Anonymous</span>
              <a href="<%= letter_path(letter) %>" class="font-semibold text-warm-gray-800 hover:underline">
                Read Letter &rarr;
              </a>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Premium Emotional Quote / Testimonial -->
  <section class="bg-white border border-warm-gray-200/60 p-12 rounded-3xl text-center max-w-4xl mx-auto space-y-6 shadow-sm">
    <p class="font-serif italic text-2xl text-warm-gray-800 leading-relaxed">
      "Receiving a letter I wrote to myself five years ago was like meeting an old friend I didn't know I missed. It reminded me how much I've grown, and what truly matters."
    </p>
    <div class="space-y-1">
      <h4 class="font-semibold text-sm text-warm-gray-900">Sarah Jenkins</h4>
      <p class="text-xs text-warm-gray-500">TimeEcho user since 2021</p>
    </div>
  </section>
</div>
