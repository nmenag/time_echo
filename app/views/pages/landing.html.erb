<div class="space-y-24 max-w-6xl mx-auto -mt-4 font-ui animate-fade-in text-base-content">

  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pt-2">

    <div class="lg:col-span-5 space-y-7 lg:sticky lg:top-24">
      <div class="space-y-4">
        <h1 class="font-serif-editorial text-4xl sm:text-6xl font-normal text-base-content leading-tight tracking-tight">
          <%= t('landing.headline').html_safe %>
        </h1>

        <p class="font-letter text-xs sm:text-sm text-base-content/70 leading-relaxed max-w-xl">
          <%= t('landing.subtitle') %>
        </p>
      </div>

      <div class="space-y-3 pt-2">
        <div class="paper-sheet rounded-xs p-4 border border-[#D8D2C2] dark:border-[#2D3340] flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xs bg-[#8E2818]/10 text-[#8E2818] dark:bg-[#8E2818]/20 flex items-center justify-center shrink-0 border border-[#8E2818]/20">
            <%= tabler_icon("lock", size: 16) %>
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-letter font-semibold uppercase tracking-wider text-base-content"><%= t('landing.private_and_secure') %></h4>
            <p class="text-xs font-letter text-base-content/60 leading-relaxed"><%= t('landing.private_desc') %></p>
          </div>
        </div>

        <div class="paper-sheet rounded-xs p-4 border border-[#D8D2C2] dark:border-[#2D3340] flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xs bg-[#2C485E]/10 text-[#2C485E] dark:bg-[#77A3C4]/20 dark:text-[#77A3C4] flex items-center justify-center shrink-0 border border-[#2C485E]/20">
            <%= tabler_icon("clock", size: 16) %>
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-letter font-semibold uppercase tracking-wider text-base-content"><%= t('landing.delivered_on_time') %></h4>
            <p class="text-xs font-letter text-base-content/60 leading-relaxed"><%= t('landing.delivery_desc') %></p>
          </div>
        </div>

        <div class="paper-sheet rounded-xs p-4 border border-[#D8D2C2] dark:border-[#2D3340] flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xs bg-amber-600/10 text-amber-700 dark:text-amber-400 flex items-center justify-center shrink-0 border border-amber-600/20">
            <%= tabler_icon("sparkles", size: 16) %>
          </div>
          <div class="space-y-0.5">
            <h4 class="text-xs font-letter font-semibold uppercase tracking-wider text-base-content"><%= t('landing.connect_with_yourself') %></h4>
            <p class="text-xs font-letter text-base-content/60 leading-relaxed"><%= t('landing.compare_desc') %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 paper-sheet rounded-xs p-6 sm:p-8 space-y-6 border border-[#D8D2C2] dark:border-[#2D3340]">
      <div class="flex items-center justify-between border-b border-[#D8D2C2] dark:border-[#2D3340] pb-4">
        <div>
          <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('letters.form_step_title') %></span>
          <h2 class="font-serif-editorial text-2xl text-base-content font-semibold mt-0.5">
            <%= t('landing.write_card_title') %>
          </h2>
        </div>
        <span class="postmark-stamp text-[10px] py-0.5 px-2.5">
          <%= I18n.l(Date.current, format: :long) %>
        </span>
      </div>

      <%= form_with model: LetterForm.new, url: letters_path, local: true, class: "space-y-6" do |f| %>
        <%= f.hidden_field :title, value: t('landing.your_letter') %>
        <%= f.hidden_field :deliver_at, id: "letter_deliver_at_hidden" %>
        <%= f.hidden_field :timezone, id: "landing_timezone_input" %>

        <div class="space-y-2">
          <label class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider block"><%= t('landing.your_letter') %></label>
          <%= f.text_area :content, id: "landing_content_area", placeholder: t('landing.dear_future_self'), rows: 7, minlength: 80, maxlength: 2000, class: "w-full p-4 sm:p-5 border border-[#D8D2C2] dark:border-[#2D3340] rounded-xs font-letter text-sm leading-loose text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none transition-all shadow-inner bg-transparent", required: true %>
          <div class="flex justify-between items-center text-[11px] font-letter text-base-content/50 pt-1">
            <span class="italic"><%= t('letters.only_you_can_see') %></span>
            <span id="landing_char_counter" data-template-min="<%= t('letters.min_chars_progress', count: '__COUNT__') %>">0 / 2000</span>
          </div>
        </div>

        <div class="space-y-2.5">
          <label class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider block"><%= t('landing.when_do_you_want_it') %></label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs font-letter">
            <button type="button" onclick="setPresetDate(this, 180)" class="border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer"><%= t('landing.six_months') %></button>
            <button type="button" id="default-date-btn" onclick="setPresetDate(this, 365)" class="border border-[#8E2818] bg-[#8E2818] text-[#FAF9F5] py-2 rounded-xs font-semibold font-letter text-xs uppercase tracking-wider transition-all cursor-pointer"><%= t('landing.one_year') %></button>
            <button type="button" onclick="setPresetDate(this, 1095)" class="border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer"><%= t('landing.three_years') %></button>
            <button type="button" onclick="setPresetDate(this, 1825)" class="border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer"><%= t('landing.five_years') %></button>
            <button type="button" onclick="toggleCustomDate(this)" class="col-span-2 sm:col-span-1 border border-[#D8D2C2] dark:border-[#2D3340] py-2 rounded-xs hover:bg-base-200/40 text-base-content font-letter text-xs uppercase tracking-wider transition-all cursor-pointer"><%= t('landing.custom_date') %></button>
          </div>

          <div id="custom-date-container" class="hidden animate-fade-in pt-1">
            <div class="archival-folder rounded-xs p-3 border border-[#D5CEBD] dark:border-[#2D3342]">
              <label for="custom-date-input" class="text-[10px] text-base-content/70 font-letter uppercase tracking-wider block mb-1 font-semibold"><%= t('landing.choose_specific_date') %></label>
              <input type="text" id="custom-date-input" min="<%= (Date.current + 1.day).to_s %>" onchange="setCustomDate(this.value)" data-controller="date-picker" data-date-picker-locale-value="<%= I18n.locale %>" class="w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content focus:border-[#8E2818] focus:outline-none">
            </div>
          </div>
        </div>

        <div class="archival-folder rounded-xs p-4 sm:p-5 space-y-4 border border-[#D5CEBD] dark:border-[#2D3342]">
          <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-2">
            <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('landing.predictions_annex') %></span>
            <label class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider block mt-0.5"><%= t('landing.your_predictions_optional') %></label>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs font-letter">
            <div class="space-y-1">
              <label class="text-[10px] font-semibold text-base-content/70 flex items-center gap-1">
                <span class="text-base-content/40">01.</span>
                <span><%= t('landing.where_will_you_live') %></span>
              </label>
              <%= f.text_field :prediction_city, placeholder: t('letters.prediction_placeholder'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] font-semibold text-base-content/70 flex items-center gap-1">
                <span class="text-base-content/40">02.</span>
                <span><%= t('landing.what_work_will_you_do') %></span>
              </label>
              <%= f.text_field :prediction_career, placeholder: t('letters.prediction_placeholder'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] font-semibold text-base-content/70 flex items-center gap-1">
                <span class="text-base-content/40">03.</span>
                <span><%= t('landing.how_much_money_will_you_earn') %></span>
              </label>
              <%= f.text_field :prediction_salary, placeholder: t('letters.prediction_placeholder'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] font-semibold text-base-content/70 flex items-center gap-1">
                <span class="text-base-content/40">04.</span>
                <span><%= t('landing.how_will_your_relationship_be') %></span>
              </label>
              <%= f.text_field :prediction_relationship, placeholder: t('letters.prediction_placeholder'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>

            <div class="space-y-1 md:col-span-2">
              <label class="text-[10px] font-semibold text-base-content/70 flex items-center gap-1">
                <span class="text-base-content/40">05.</span>
                <span><%= t('landing.what_will_be_your_achievement') %></span>
              </label>
              <%= f.text_field :prediction_achievement, placeholder: t('letters.prediction_placeholder'), class: "w-full paper-sheet rounded-xs px-3 py-2 text-xs border border-[#D8D2C2] dark:border-[#2D3340] font-letter text-base-content placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none" %>
            </div>
          </div>
        </div>

        <div class="archival-folder rounded-xs p-4 sm:p-5 space-y-3 border border-[#D5CEBD] dark:border-[#2D3342]">
          <div class="border-b border-[#D5CEBD] dark:border-[#2D3342] pb-1.5">
            <span class="text-[10px] font-letter uppercase tracking-widest text-base-content/50 block"><%= t('landing.current_emotional_state') %></span>
            <label class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider block mt-0.5"><%= t('landing.how_do_you_feel_today') %></label>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs font-letter">
            <div class="paper-sheet rounded-xs p-3 border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('landing.happiness') %></span>
                <span id="landing_happiness_val">6 / 10</span>
              </div>
              <input type="range" name="letter_form[happiness_level]" id="landing_happiness_input" value="6" min="1" max="10" class="w-full accent-[#8E2818] cursor-pointer" aria-label="<%= t('landing.happiness') %>" aria-valuemin="1" aria-valuemax="10" aria-valuenow="6" oninput="document.getElementById('landing_happiness_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);">
            </div>

            <div class="paper-sheet rounded-xs p-3 border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('landing.anxiety') %></span>
                <span id="landing_anxiety_val">4 / 10</span>
              </div>
              <input type="range" name="letter_form[anxiety_level]" id="landing_anxiety_input" value="4" min="1" max="10" class="w-full accent-[#8E2818] cursor-pointer" aria-label="<%= t('landing.anxiety') %>" aria-valuemin="1" aria-valuemax="10" aria-valuenow="4" oninput="document.getElementById('landing_anxiety_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);">
            </div>

            <div class="paper-sheet rounded-xs p-3 border border-[#D8D2C2] dark:border-[#2D3340] space-y-1.5">
              <div class="flex justify-between items-center font-semibold text-base-content/80">
                <span><%= t('landing.motivation') %></span>
                <span id="landing_motivation_val">7 / 10</span>
              </div>
              <input type="range" name="letter_form[motivation_level]" id="landing_motivation_input" value="7" min="1" max="10" class="w-full accent-[#8E2818] cursor-pointer" aria-label="<%= t('landing.motivation') %>" aria-valuemin="1" aria-valuemax="10" aria-valuenow="7" oninput="document.getElementById('landing_motivation_val').innerText = this.value + ' / 10'; this.setAttribute('aria-valuenow', this.value);">
            </div>
          </div>
        </div>

        <div class="space-y-2.5 pt-1">
          <label class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider block"><%= t('landing.where_do_we_send_letter') %></label>
          <div class="flex flex-col sm:flex-row gap-2.5">
            <%= f.email_field :email, placeholder: t('landing.email_placeholder'), class: "w-full paper-sheet rounded-xs px-3.5 py-2.5 text-xs font-letter text-base-content border border-[#D8D2C2] dark:border-[#2D3340] placeholder:text-base-content/40 focus:border-[#8E2818] focus:outline-none min-h-[44px]", required: true %>
            <button type="submit" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs px-6 py-3 text-xs font-semibold tracking-widest uppercase font-letter inline-flex items-center justify-center gap-2 border-none shadow-xs shrink-0 min-h-[44px] cursor-pointer">
              <span><%= t('landing.send_to_future_self') %></span>
              <%= tabler_icon("mail", size: 15) %>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-center gap-2 text-[11px] font-letter text-base-content/50 pt-2 border-t border-[#D8D2C2] dark:border-[#2D3340]">
          <%= tabler_icon("shield-check", size: 14) %>
          <span><%= t('landing.private_and_secure_badge') %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="space-y-10">
    <div class="text-center space-y-2">
      <h2 class="font-serif-editorial text-3xl sm:text-4xl text-base-content font-semibold"><%= t('landing.how_it_looks') %></h2>
      <p class="text-xs font-letter text-base-content/60 max-w-md mx-auto leading-relaxed">
        <%= t('landing.compare_reflect_desc') %>
      </p>
    </div>

    <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] shadow-sm overflow-hidden max-w-5xl mx-auto font-ui relative">
      <div class="bg-base-200/50 px-5 py-3 border-b border-[#D8D2C2] dark:border-[#2D3340] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#8E2818] inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#2C485E] inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#D8D2C2] inline-block"></span>
        </div>
        <div class="font-letter text-[11px] text-base-content/60 tracking-wider">
          <%= t('landing.dossier_revealed') %>
        </div>
        <div class="w-8"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 min-h-[460px]">
        <aside class="md:col-span-3 archival-folder border-r border-[#D8D2C2] dark:border-[#2D3340] p-6 flex flex-col justify-between space-y-6 select-none">
          <div class="space-y-6">
            <div class="flex items-center gap-2">
              <span class="postmark-stamp text-[10px] py-0.5 px-2">
                <%= t('brand') %>
              </span>
            </div>

            <nav class="space-y-1 text-xs font-letter">
              <div class="flex items-center gap-2.5 px-3 py-2 rounded-xs paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] font-semibold text-base-content">
                <%= tabler_icon("file-text", size: 15) %>
                <span><%= t('navigation.vault') %></span>
              </div>
              <div class="flex items-center gap-2.5 px-3 py-2 text-base-content/60">
                <%= tabler_icon("calendar", size: 15) %>
                <span><%= t('navigation.timeline') %></span>
              </div>
              <div class="flex items-center gap-2.5 px-3 py-2 text-base-content/60">
                <%= tabler_icon("chart-bar", size: 15) %>
                <span><%= t('navigation.analytics') %></span>
              </div>
            </nav>
          </div>

          <div class="border-t border-[#D5CEBD] dark:border-[#2D3342] pt-4">
            <p class="text-[11px] font-letter italic text-base-content/70 leading-relaxed">
              "<%= t('navigation.quote') %>"
            </p>
          </div>
        </aside>

        <main class="md:col-span-9 p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-transparent">

          <div class="lg:col-span-7 space-y-4">
            <div class="border-b border-[#D8D2C2] dark:border-[#2D3340] pb-2.5 flex items-center justify-between">
              <h3 class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider">
                <%= t('landing.prediction_vs_reality').html_safe %>
              </h3>
              <span class="postmark-stamp text-[10px] py-0.5 px-2"><%= t('letters.revealed_and_compared') %></span>
            </div>

            <div class="space-y-2.5 text-xs font-letter">
              <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-3 rounded-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2 text-base-content/60">
                    <span class="uppercase text-[9px] font-semibold tracking-wider"><%= t('letters.prediction') %>:</span>
                    <span class="italic text-base-content/80"><%= t('landing.mock_prediction_city') %></span>
                  </div>
                  <div class="flex items-center gap-2 text-base-content font-semibold">
                    <span class="uppercase text-[9px] tracking-wider text-base-content/60"><%= t('letters.reality') %>:</span>
                    <span><%= t('landing.mock_reality_city') %></span>
                  </div>
                </div>
                <span class="postmark-stamp text-[10px] py-0.5 px-2 self-start sm:self-auto shrink-0"><%= t('letters.partially') %></span>
              </div>

              <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-3 rounded-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2 text-base-content/60">
                    <span class="uppercase text-[9px] font-semibold tracking-wider"><%= t('letters.prediction') %>:</span>
                    <span class="italic text-base-content/80"><%= t('landing.mock_prediction_career') %></span>
                  </div>
                  <div class="flex items-center gap-2 text-base-content font-semibold">
                    <span class="uppercase text-[9px] tracking-wider text-base-content/60"><%= t('letters.reality') %>:</span>
                    <span><%= t('landing.mock_reality_career') %></span>
                  </div>
                </div>
                <span class="postmark-stamp text-[10px] py-0.5 px-2 self-start sm:self-auto shrink-0"><%= t('letters.you_did_it') %></span>
              </div>

              <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-3 rounded-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2 text-base-content/60">
                    <span class="uppercase text-[9px] font-semibold tracking-wider"><%= t('letters.prediction') %>:</span>
                    <span class="italic text-base-content/80"><%= t('landing.mock_prediction_salary') %></span>
                  </div>
                  <div class="flex items-center gap-2 text-base-content font-semibold">
                    <span class="uppercase text-[9px] tracking-wider text-base-content/60"><%= t('letters.reality') %>:</span>
                    <span><%= t('landing.mock_reality_salary') %></span>
                  </div>
                </div>
                <span class="postmark-stamp text-[10px] py-0.5 px-2 self-start sm:self-auto shrink-0"><%= t('letters.superaste') %></span>
              </div>

              <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-3 rounded-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2 text-base-content/60">
                    <span class="uppercase text-[9px] font-semibold tracking-wider"><%= t('letters.prediction') %>:</span>
                    <span class="italic text-base-content/80"><%= t('landing.mock_prediction_happiness') %></span>
                  </div>
                  <div class="flex items-center gap-2 text-base-content font-semibold">
                    <span class="uppercase text-[9px] tracking-wider text-base-content/60"><%= t('letters.reality') %>:</span>
                    <span><%= t('landing.mock_reality_happiness') %></span>
                  </div>
                </div>
                <span class="postmark-stamp text-[10px] py-0.5 px-2 self-start sm:self-auto shrink-0"><%= t('letters.very_close') %></span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 space-y-4">
            <div class="archival-folder rounded-xs p-4 border border-[#D5CEBD] dark:border-[#2D3342] space-y-3">
              <div>
                <h4 class="text-[10px] font-letter font-semibold uppercase tracking-widest text-base-content/60"><%= t('letters.emotional_evolution') %></h4>
                <div class="flex gap-4 text-[10px] font-letter text-base-content/60 mt-1 select-none">
                  <span class="flex items-center gap-1">
                    <span class="border-b border-dashed border-base-content/60 w-3 inline-block"></span> <%= t('landing.one_year_ago') %>
                  </span>
