<div class="space-y-24 max-w-5xl mx-auto">
  <!-- Peaceful & Nostalgic Hero Section -->
  <section class="hero min-h-[40vh] flex items-center justify-center text-center py-6">
    <div class="hero-content max-w-3xl flex-col gap-8">
      <!-- Muted Soft Pill Badge -->
      <div class="badge badge-secondary py-3 px-4 border border-accent text-xs font-semibold tracking-wider uppercase flex gap-1.5 items-center">
        <%= t('landing.badge') %>
      </div>
      
      <div class="space-y-4">
        <!-- Main title using elegant serif headings -->
        <h1 class="font-serif italic text-5xl sm:text-7xl font-light text-primary leading-tight font-serif">
          <%= t('landing.title_html') %>
        </h1>
        <p class="text-base sm:text-lg text-base-content/60 font-sans max-w-xl mx-auto leading-relaxed pt-2">
          <%= t('landing.subtitle') %>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <a href="<%= new_letter_path %>" class="btn btn-primary btn-lg rounded-xl px-8 shadow-sm hover:shadow-md transition-all duration-300 w-full sm:w-auto text-sm tracking-wide uppercase font-semibold">
          <%= t('landing.write_first') %>
        </a>
        <a href="#how-it-works" class="btn btn-outline btn-lg border-base-300 hover:bg-base-200 hover:text-base-content rounded-xl px-8 transition-all duration-300 w-full sm:w-auto text-sm tracking-wide uppercase font-semibold">
          <%= t('landing.how_it_works') %>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works Section using Muted Clean Cards -->
  <section id="how-it-works" class="space-y-12 scroll-mt-24">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-3xl sm:text-4xl text-primary font-normal"><%= t('landing.steps_title') %></h2>
      <p class="text-sm text-base-content/50 max-w-md mx-auto"><%= t('landing.steps_subtitle') %></p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Step 1 Card -->
      <div class="card card-bordered border-base-200 bg-base-100 p-8 rounded-box card-hover-effect space-y-4">
        <div class="w-10 h-10 bg-secondary border border-accent text-primary rounded-xl flex items-center justify-center font-bold text-lg">1</div>
        <h3 class="font-semibold text-lg text-primary"><%= t('landing.step1_title') %></h3>
        <p class="text-sm text-base-content/60 leading-relaxed font-sans">
          <%= t('landing.step1_desc') %>
        </p>
      </div>

      <!-- Step 2 Card -->
      <div class="card card-bordered border-base-200 bg-base-100 p-8 rounded-box card-hover-effect space-y-4">
        <div class="w-10 h-10 bg-secondary border border-accent text-primary rounded-xl flex items-center justify-center font-bold text-lg">2</div>
        <h3 class="font-semibold text-lg text-primary"><%= t('landing.step2_title') %></h3>
        <p class="text-sm text-base-content/60 leading-relaxed font-sans">
          <%= t('landing.step2_desc') %>
        </p>
      </div>

      <!-- Step 3 Card -->
      <div class="card card-bordered border-base-200 bg-base-100 p-8 rounded-box card-hover-effect space-y-4">
        <div class="w-10 h-10 bg-secondary border border-accent text-primary rounded-xl flex items-center justify-center font-bold text-lg">3</div>
        <h3 class="font-semibold text-lg text-primary"><%= t('landing.step3_title') %></h3>
        <p class="text-sm text-base-content/60 leading-relaxed font-sans">
          <%= t('landing.step3_desc') %>
        </p>
      </div>
    </div>
  </section>

  <!-- Community Public Stories Feed Preview -->
  <% if @public_letters && @public_letters.any? %>
    <section class="space-y-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-base-200 pb-4 gap-4">
        <div class="space-y-2">
          <h2 class="font-serif text-3xl sm:text-4xl text-primary font-normal"><%= t('landing.stories_title') %></h2>
          <p class="text-sm text-base-content/50"><%= t('landing.stories_subtitle') %></p>
        </div>
        <a href="<%= public_feed_letters_path %>" class="btn btn-link btn-sm text-primary hover:text-neutral p-0 font-semibold self-start sm:self-auto">
          <%= t('landing.stories_all').html_safe %>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <% @public_letters.each do |letter| %>
          <div class="card card-bordered border-base-200 bg-base-100 rounded-box card-hover-effect flex flex-col justify-between p-6">
            <div class="space-y-4">
              <span class="badge badge-secondary badge-sm text-[10px] uppercase font-semibold px-2.5 py-1.5 border border-accent">
                <%= t('landing.stories_opened', date: letter.delivered_at.strftime('%B %d, %Y')) %>
              </span>
              <p class="text-sm text-base-content/80 font-serif italic line-clamp-4 leading-relaxed">
                "<%= letter.content %>"
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-base-200 flex justify-between items-center text-xs text-base-content/50">
              <span class="flex items-center gap-1">👤 <%= t('navigation.anonymous') %></span>
              <a href="<%= letter_path(letter) %>" class="btn btn-link btn-xs text-primary p-0 min-h-0 h-auto hover:underline font-semibold">
                <%= t('landing.stories_read_more').html_safe %>
              </a>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Premium Muted Pricing Section -->
  <section class="space-y-12 bg-base-200/40 p-8 sm:p-12 rounded-3xl border border-base-200/50">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-3xl sm:text-4xl text-primary font-normal"><%= t('landing.pricing_title') %></h2>
      <p class="text-sm text-base-content/50 max-w-md mx-auto"><%= t('landing.pricing_subtitle') %></p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <!-- Free Tier Card -->
      <div class="card card-bordered border-base-200 bg-base-100 p-8 rounded-box flex flex-col justify-between gap-6 card-hover-effect">
        <div class="space-y-4">
          <span class="badge badge-outline border-base-300 text-xs font-semibold px-2.5 py-1.5 uppercase"><%= t('landing.pricing_free') %></span>
          <h3 class="font-serif text-2xl text-primary font-medium"><%= t('landing.pricing_free_name') %></h3>
          <p class="text-sm text-base-content/60 font-sans"><%= t('landing.pricing_free_desc') %></p>
          <div class="pt-2">
            <span class="text-4xl font-serif text-primary font-bold"><%= t('landing.pricing_free_price') %></span>
            <span class="text-xs text-base-content/40"><%= t('landing.pricing_free_price_desc') %></span>
          </div>
          <ul class="space-y-2 pt-2 text-xs text-base-content/70">
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_free_feature1') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_free_feature2') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_free_feature3') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_free_feature4') %></li>
          </ul>
        </div>
        <a href="<%= new_letter_path %>" class="btn btn-outline border-base-300 hover:bg-base-200 hover:text-primary rounded-xl w-full text-xs font-semibold uppercase tracking-wider">
          <%= t('landing.pricing_free_btn') %>
        </a>
      </div>

      <!-- Paid Tier Card -->
      <div class="card card-bordered border-accent bg-secondary/30 p-8 rounded-box flex flex-col justify-between gap-6 card-hover-effect relative overflow-hidden">
        <div class="absolute top-0 right-0">
          <div class="badge badge-accent rounded-bl-xl rounded-tr-none px-3 py-2 text-[10px] font-semibold uppercase tracking-wider border-0"><%= t('landing.pricing_paid_popular') %></div>
        </div>
        <div class="space-y-4">
          <span class="badge badge-accent text-xs font-semibold px-2.5 py-1.5 uppercase border-0"><%= t('landing.pricing_paid') %></span>
          <h3 class="font-serif text-2xl text-primary font-medium"><%= t('landing.pricing_paid_name') %></h3>
          <p class="text-sm text-base-content/60 font-sans"><%= t('landing.pricing_paid_desc') %></p>
          <div class="pt-2">
            <span class="text-4xl font-serif text-primary font-bold"><%= t('landing.pricing_paid_price') %></span>
            <span class="text-xs text-base-content/40"><%= t('landing.pricing_paid_price_desc') %></span>
          </div>
          <ul class="space-y-2 pt-2 text-xs text-base-content/70">
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_paid_feature1') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_paid_feature2') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_paid_feature3') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_paid_feature4') %></li>
            <li class="flex items-center gap-2">✓ <%= t('landing.pricing_paid_feature5') %></li>
          </ul>
        </div>
        <a href="<%= new_letter_path %>" class="btn btn-primary rounded-xl w-full text-xs font-semibold uppercase tracking-wider shadow-xs">
          <%= t('landing.pricing_paid_btn') %>
        </a>
      </div>
    </div>
  </section>

  <!-- Premium Emotional Quote / Testimonial -->
  <section class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-12 rounded-3xl text-center max-w-4xl mx-auto space-y-6 shadow-xs">
    <p class="font-serif italic text-xl sm:text-2xl text-primary leading-relaxed max-w-3xl mx-auto">
      "<%= t('landing.quote') %>"
    </p>
    <div class="space-y-1">
      <h4 class="font-semibold text-sm text-primary"><%= t('landing.quote_author') %></h4>
      <p class="text-xs text-base-content/50"><%= t('landing.quote_author_sub') %></p>
    </div>
  </section>
</div>
