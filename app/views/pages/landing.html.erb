        </div>
        <div class="space-y-1">
          <h3 class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider"><%= t('landing.step1_title') %></h3>
          <p class="text-xs font-letter text-base-content/60 leading-relaxed">
            <%= t('landing.step1_desc') %>
          </p>
        </div>
      </div>

      <div class="paper-sheet rounded-xs p-6 border border-[#D8D2C2] dark:border-[#2D3340] space-y-3 text-center">
        <div class="wax-seal w-12 h-12 rounded-full mx-auto flex items-center justify-center text-[#FAF9F5] font-letter font-bold text-sm select-none">
          02
        </div>
        <div class="space-y-1">
          <h3 class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider"><%= t('landing.step2_title') %></h3>
          <p class="text-xs font-letter text-base-content/60 leading-relaxed">
            <%= t('landing.step2_desc') %>
          </p>
        </div>
      </div>

      <div class="paper-sheet rounded-xs p-6 border border-[#D8D2C2] dark:border-[#2D3340] space-y-3 text-center">
        <div class="wax-seal w-12 h-12 rounded-full mx-auto flex items-center justify-center text-[#FAF9F5] font-letter font-bold text-sm select-none">
          03
        </div>
        <div class="space-y-1">
          <h3 class="text-xs font-letter font-semibold text-base-content uppercase tracking-wider"><%= t('landing.step3_title') %></h3>
