<div class="max-w-2xl mx-auto space-y-8 font-sans pb-16 animate-fade-in">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-base-200 pb-6">
    <div class="space-y-1">
      <h1 class="font-serif text-3xl font-normal text-base-content tracking-tight">
        Ajustes de cuenta
      </h1>
      <p class="text-sm text-base-content/50">
        Administra la dirección de correo electrónico asociada a tu baúl y gestiona tu sesión.
      </p>
    </div>
  </div>

  <div class="bg-white border border-base-200 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-base-200 pb-3.5">
      <h2 class="font-serif text-xl font-normal text-base-content flex items-center gap-2">
        <span aria-hidden="true">✉️</span> Cambiar correo electrónico
      </h2>
    </div>

    <%= form_with model: @user_preference, url: settings_path, method: :patch, class: "space-y-6" do |f| %>
      <div class="space-y-2">
        <%= f.label :email, "Nueva dirección de correo electrónico", class: "text-xs font-bold text-base-content/80 block" %>
        <%= f.email_field :email,
            value: current_user_email,
            class: "input input-bordered w-full rounded-2xl bg-base-200/20 text-base-content border-base-200 placeholder:text-base-content/30 text-sm focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all px-4 min-h-[44px]",
            placeholder: "ejemplo@correo.com",
            required: true %>
        <p class="text-xs text-base-content/30 leading-relaxed">
          Nota: Al cambiar tu correo, todas tus cartas futuras y predicciones guardadas se vincularán automáticamente a la nueva dirección.
        </p>
      </div>

      <%= f.submit "Actualizar dirección de correo",
          class: "btn w-full btn-primary text-primary-content rounded-2xl py-3 px-8 text-sm font-bold border-none cursor-pointer transition-all hover:scale-[1.02] active:scale-[0.98] min-h-[44px] shadow-sm" %>
    <% end %>
  </div>

  <div class="bg-base-100 border border-error/20 rounded-3xl p-6 sm:p-8 shadow-2xs space-y-6">
    <div class="flex items-center gap-2 border-b border-error/20 pb-3 text-error">
      <span aria-hidden="true">⚠️</span>
      <h2 class="font-serif text-xl font-normal text-error">Zona de Peligro</h2>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-error/90 font-sans">Borrar cuenta de forma permanente</h4>
        <p class="text-xs text-base-content/50 leading-relaxed max-w-lg">
          Esto eliminará inmediatamente todas tus cartas selladas, predicciones y estado emocional. Esta acción es totalmente irreversible.
        </p>
      </div>

      <%= button_to settings_path,
          method: :delete,
          class: "btn btn-outline border-error/30 text-error hover:bg-error/10 hover:border-error/40 btn-sm rounded-2xl cursor-pointer shrink-0 font-bold font-sans tracking-normal transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] min-h-[40px] px-5 whitespace-nowrap",
          data: { turbo_confirm: "¿Estás completamente seguro de que deseas borrar permanentemente tu baúl y todas tus cartas? Todos tus recuerdos y predicciones guardados se perderán para siempre." } do %>
        Eliminar mi baúl
      <% end %>
    </div>
  </div>

</div>
