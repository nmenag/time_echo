<div class="max-w-2xl mx-auto space-y-12 font-sans pb-16 animate-fade-in">
  
  <!-- Calming Header Section (Matches Dashboard & Timeline headers exactly) -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 border-b border-base-200 pb-6">
    <div class="space-y-1">
      <h1 class="font-serif italic text-4xl sm:text-5xl text-primary font-normal leading-tight">
        Ajustes de cuenta
      </h1>
      <p class="text-sm text-base-content/50">
        Administra la dirección de correo electrónico asociada a tu baúl y gestiona tu sesión.
      </p>
    </div>
  </div>

  <!-- 1. Email Management Section Card -->
  <div class="card card-bordered border-base-200 bg-base-100 rounded-2xl p-6 sm:p-8 shadow-xs card-hover-effect space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-base-200 pb-3">
      <h3 class="font-serif italic text-2xl text-primary font-normal flex items-center gap-2">
        <span class="font-sans not-italic text-base" aria-hidden="true">✉️</span> Cambiar correo electrónico
      </h3>
      <span class="badge badge-success bg-success/10 text-success border border-success/20 py-2 px-3 text-[10px] font-bold uppercase tracking-wider self-start sm:self-auto">Verificado</span>
    </div>

    <%= form_with model: @user_preference, url: settings_path, method: :patch, class: "space-y-6" do |f| %>
      <div class="space-y-2">
        <%= f.label :email, "Nueva dirección de correo electrónico", class: "text-[10px] font-semibold text-base-content/40 uppercase tracking-wider block" %>
        <%= f.email_field :email, value: current_user_email, class: "input input-bordered w-full rounded-xl font-sans text-sm focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand min-h-[44px] bg-base-200/20", placeholder: "ejemplo@correo.com", required: true %>
        <p class="text-xs text-base-content/40 leading-relaxed">
          Nota: Al cambiar tu correo, todas tus cartas futuras y predicciones guardadas se vincularán automáticamente a la nueva dirección.
        </p>
      </div>

      <%= f.submit "Actualizar dirección de correo", class: "btn w-full text-white rounded-xl px-5 text-xs font-semibold uppercase tracking-wider border-none cursor-pointer transition-all duration-200 hover:scale-[1.01] active:scale-[0.99]", style: "background-color: oklch(40% 0.22 290); --btn-color: oklch(40% 0.22 290);" %>
    <% end %>
  </div>


  <!-- 3. Danger Zone Card -->
  <div class="card card-bordered border-error/20 bg-base-100 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6">
    <div class="flex items-center gap-2 border-b border-error/10 pb-3 text-error">
      <span aria-hidden="true">⚠️</span>
      <h3 class="font-serif italic text-2xl text-error font-normal">Zona de Peligro</h3>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1.5">
        <h4 class="text-sm font-semibold text-error/90 font-sans">Borrar cuenta de forma permanente</h4>
        <p class="text-xs text-base-content/50 leading-relaxed max-w-lg">
          Esto eliminará inmediatamente todas tus cartas selladas, predicciones y estado emocional. Esta acción es totalmente irreversible.
        </p>
      </div>

      <%= button_to settings_path, method: :delete, class: "btn btn-outline border-error/35 text-error hover:bg-error hover:text-white hover:border-error btn-sm rounded-xl cursor-pointer shrink-0 font-semibold font-sans tracking-normal transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] min-h-[36px] whitespace-nowrap", data: { turbo_confirm: "¿Estás completamente seguro de que deseas borrar permanentemente tu baúl y todas tus cartas? Todos tus recuerdos y predicciones guardados se perderán para siempre." } do %>
        Eliminar mi baúl
      <% end %>
    </div>
  </div>

</div>
