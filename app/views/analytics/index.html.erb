<div class="space-y-8 max-w-6xl mx-auto py-4 font-ui animate-fade-in text-base-content">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-[#D8D2C2] dark:border-[#2D3340]">
    <div class="space-y-1">
      <h1 class="font-serif-editorial text-3xl font-semibold text-base-content tracking-tight"><%= t('analytics.title') %></h1>
      <p class="text-xs font-letter text-base-content/60 tracking-wider"><%= t('analytics.subtitle') %></p>
    </div>
    <div class="shrink-0">
      <a href="<%= dashboard_path %>" class="btn btn-outline border-[#D8D2C2] dark:border-[#2D3340] text-base-content hover:bg-base-200/50 rounded-xs px-4 text-xs font-medium uppercase tracking-wider font-letter inline-flex items-center gap-1.5 min-h-[40px] cursor-pointer">
        <%= tabler_icon("arrow-left", size: 14) %>
        <span><%= t('analytics.back_to_vault') %></span>
      </a>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 font-letter">
    <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-5 rounded-xs text-center shadow-xs">
      <p class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider"><%= t('analytics.total_capsules') %></p>
      <p class="text-2xl font-bold text-base-content mt-1"><%= @total_letters %></p>
    </div>
    <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-5 rounded-xs text-center shadow-xs">
      <p class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider"><%= t('analytics.delivered') %></p>
      <p class="text-2xl font-bold text-[#2C485E] dark:text-[#77A3C4] mt-1"><%= @delivered_letters %></p>
    </div>
    <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-5 rounded-xs text-center shadow-xs col-span-2 md:col-span-1">
      <p class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider"><%= t('analytics.in_transit') %></p>
      <p class="text-2xl font-bold text-amber-700 dark:text-amber-400 mt-1"><%= @scheduled_letters %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-6 sm:p-8 rounded-xs shadow-xs space-y-6">
      <div class="flex items-center gap-2.5 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-3.5">
        <%= tabler_icon("brain", size: 20, class: "text-[#2C485E] dark:text-[#77A3C4]") %>
        <h2 class="font-serif-editorial text-xl font-semibold text-base-content"><%= t('analytics.emotional_evolution_title') %></h2>
      </div>
      <p class="text-xs font-letter text-base-content/60 leading-relaxed">
        <%= t('analytics.emotional_evolution_desc') %>
      </p>

      <div class="space-y-6 pt-2 font-letter">
        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-base-content/85 uppercase text-[10px] tracking-wider"><%= t('analytics.happiness_index') %></span>
            <span class="text-base-content/70">
              <%= @avg_initial_happiness %> &rarr; <%= @avg_reveal_happiness %>
            </span>
          </div>
          <div class="relative bg-base-200/60 h-2.5 rounded-xs overflow-hidden border border-[#D8D2C2]/50 dark:border-[#2D3340]"
               role="progressbar"
               aria-label="<%= t('analytics.happiness_index') %>"
               aria-valuenow="<%= @avg_reveal_happiness %>"
               aria-valuemin="1"
               aria-valuemax="10">
            <div class="bg-[#8E2818]/25 absolute top-0 left-0 h-full rounded-xs" style="width: <%= @avg_initial_happiness * 10 %>%"></div>
            <div class="bg-[#8E2818] absolute top-0 left-0 h-full rounded-xs opacity-85" style="width: <%= @avg_reveal_happiness * 10 %>%"></div>
          </div>
          <div class="flex justify-between text-[9px] font-semibold text-base-content/60 uppercase tracking-wider">
            <span><%= t('analytics.your_past') %></span>
            <span><%= t('analytics.your_present') %></span>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-base-content/85 uppercase text-[10px] tracking-wider"><%= t('analytics.anxiety_index') %></span>
            <span class="text-base-content/70">
              <%= @avg_initial_anxiety %> &rarr; <%= @avg_reveal_anxiety %>
            </span>
          </div>
          <div class="relative bg-base-200/60 h-2.5 rounded-xs overflow-hidden border border-[#D8D2C2]/50 dark:border-[#2D3340]"
               role="progressbar"
               aria-label="<%= t('analytics.anxiety_index') %>"
               aria-valuenow="<%= @avg_reveal_anxiety %>"
               aria-valuemin="1"
               aria-valuemax="10">
            <div class="bg-[#2C485E]/25 absolute top-0 left-0 h-full rounded-xs" style="width: <%= @avg_initial_anxiety * 10 %>%"></div>
            <div class="bg-[#2C485E] dark:bg-[#77A3C4] absolute top-0 left-0 h-full rounded-xs opacity-85" style="width: <%= @avg_reveal_anxiety * 10 %>%"></div>
          </div>
          <div class="flex justify-between text-[9px] font-semibold text-base-content/60 uppercase tracking-wider">
            <span><%= t('analytics.your_past') %></span>
            <span><%= t('analytics.your_present') %></span>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-semibold text-base-content/85 uppercase text-[10px] tracking-wider"><%= t('analytics.motivation_index') %></span>
            <span class="text-base-content/70">
              <%= @avg_initial_motivation %> &rarr; <%= @avg_reveal_motivation %>
            </span>
          </div>
          <div class="relative bg-base-200/60 h-2.5 rounded-xs overflow-hidden border border-[#D8D2C2]/50 dark:border-[#2D3340]"
               role="progressbar"
               aria-label="<%= t('analytics.motivation_index') %>"
               aria-valuenow="<%= @avg_reveal_motivation %>"
               aria-valuemin="1"
               aria-valuemax="10">
            <div class="bg-amber-600/25 absolute top-0 left-0 h-full rounded-xs" style="width: <%= @avg_initial_motivation * 10 %>%"></div>
            <div class="bg-amber-700 dark:bg-amber-400 absolute top-0 left-0 h-full rounded-xs opacity-85" style="width: <%= @avg_reveal_motivation * 10 %>%"></div>
          </div>
          <div class="flex justify-between text-[9px] font-semibold text-base-content/60 uppercase tracking-wider">
            <span><%= t('analytics.your_past') %></span>
            <span><%= t('analytics.your_present') %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="paper-sheet border border-[#D8D2C2] dark:border-[#2D3340] p-6 sm:p-8 rounded-xs shadow-xs space-y-6">
      <div class="flex items-center gap-2.5 border-b border-[#D8D2C2] dark:border-[#2D3340] pb-3.5">
        <%= tabler_icon("sparkles", size: 20, class: "text-[#2C485E] dark:text-[#77A3C4]") %>
        <h2 class="font-serif-editorial text-xl font-semibold text-base-content"><%= t('analytics.predictions_reality_title') %></h2>
      </div>
      <p class="text-xs font-letter text-base-content/60 leading-relaxed">
        <%= t('analytics.predictions_reality_desc') %>
      </p>

      <div class="flex flex-col items-center justify-center py-4 space-y-5 font-letter">
        <div class="radial-progress text-[#2C485E] dark:text-[#77A3C4] text-3xl font-bold"
             style="--value:<%= @prediction_match_rate %>; --size:8.5rem; --thickness: 8px;"
             role="progressbar"
             aria-valuenow="<%= @prediction_match_rate %>"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-label="<%= t('analytics.match_rate_label') %>: <%= @prediction_match_rate %>%">
          <%= @prediction_match_rate %>%
        </div>

        <div class="text-center space-y-1">
          <p class="text-[10px] font-semibold text-base-content/70 uppercase tracking-wider"><%= t('analytics.match_rate_label') %></p>
          <p class="text-xs text-base-content/60 leading-relaxed max-w-xs">
            <%= t('analytics.match_summary', matched: @matched_predictions, completed: @completed_predictions, total: @total_predictions - @completed_predictions) %>
          </p>
        </div>
    </div>
  </div>
</div>
