<div class="max-w-md mx-auto py-12 font-sans select-none animate-fade-in">
  <div class="bg-white border border-slate-200 p-8 sm:p-10 rounded-3xl shadow-sm space-y-8 relative overflow-hidden text-slate-900">
    <!-- Dynamic subtle backing glow -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-[#5b21b6]/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-[#2dd4bf]/5 rounded-full blur-2xl pointer-events-none"></div>

    <div class="text-center space-y-3 relative">
      <div class="text-2xl mb-1 select-none">✨</div>
      <h1 class="font-serif text-3xl font-normal text-slate-900 leading-tight"><%= t('sessions.title') %></h1>
      <p class="text-xs text-slate-500 leading-relaxed font-semibold">
        <%= t('sessions.subtitle') %>
      </p>
    </div>

    <%= form_with model: @magic_link_form, url: login_path, local: true, class: "space-y-6 relative" do |f| %>
      <% if @magic_link_form.errors.any? %>
        <!-- Premium Soft Crimson warning banner -->
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-950 text-xs rounded-2xl space-y-1 animate-fade-in font-semibold shadow-3xs">
          <p class="font-bold flex items-center gap-1.5">
            <span>⚠️</span> <%= t('sessions.error_header') || "Error:" %>
          </p>
          <ul class="list-disc list-inside opacity-90 pl-1">
            <% @magic_link_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :email, t('sessions.label_email'), class: "block text-[10px] font-bold text-slate-700 uppercase tracking-wider" %>
        <%= f.email_field :email, placeholder: "you@example.com", class: "input input-bordered w-full rounded-xl bg-slate-50 text-slate-900 border-slate-200/80 placeholder:text-slate-400 text-sm hover:bg-slate-100/30 hover:border-slate-300 focus:bg-white focus:border-[#5b21b6] focus:ring-2 focus:ring-[#5b21b6]/10 focus:outline-none transition-all shadow-sm", required: true %>
      </div>

      <%= f.submit t('sessions.btn_submit'), class: "btn w-full bg-[#5b21b6] hover:bg-[#4c1d95] text-white rounded-2xl py-3.5 px-6 text-xs font-bold tracking-wider uppercase shadow-md transition-all duration-300 cursor-pointer border-none font-sans" %>
    <% end %>

    <div class="text-center pt-2 relative">
      <a href="<%= root_path %>" class="text-[10px] font-bold text-slate-400 hover:text-[#5b21b6] transition-colors duration-200 uppercase tracking-widest flex items-center justify-center gap-1">
        <span>&larr;</span> <%= t('sessions.back_to_landing') || "Volver al inicio" %>
      </a>
    </div>
  </div>
</div>
