<div class="max-w-md mx-auto py-12">
  <div class="bg-white border border-warm-gray-200/60 p-10 rounded-2xl shadow-sm space-y-8">
    <div class="text-center space-y-3">
      <h1 class="font-serif italic text-3xl text-warm-gray-900">Enter your vault</h1>
      <p class="text-sm text-warm-gray-500 leading-relaxed">
        We'll send a secure magic login link directly to your email. No passwords needed.
      </p>
    </div>

    <%= form_with model: @magic_link_form, url: login_path, local: true, class: "space-y-6" do |f| %>
      <% if @magic_link_form.errors.any? %>
        <div class="p-4 bg-rose-50 border border-rose-200/80 text-rose-800 text-xs rounded-xl space-y-1">
          <p class="font-semibold">Could not send link:</p>
          <ul class="list-disc list-inside">
            <% @magic_link_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :email, "Your Email Address", class: "block text-xs font-semibold text-warm-gray-800 uppercase tracking-wider" %>
        <%= f.email_field :email, placeholder: "you@example.com", class: "w-full p-3 bg-warm-gray-50 border border-warm-gray-200 rounded-xl text-sm focus:outline-none focus:border-warm-gray-800 focus:bg-white transition-all", required: true %>
      </div>

      <%= f.submit "Send Magic Link", class: "w-full py-3 bg-warm-gray-800 hover:bg-warm-gray-900 text-white font-semibold rounded-xl text-sm shadow-sm hover:shadow transition-all cursor-pointer" %>
    <% end %>

    <div class="text-center">
      <a href="<%= root_path %>" class="text-xs font-medium text-warm-gray-500 hover:text-warm-gray-800 transition-colors">
        &larr; Back to Landing Page
      </a>
    </div>
  </div>
</div>
