<div class="max-w-md mx-auto py-12 font-ui select-none animate-fade-in text-base-content">
  <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] p-8 sm:p-10 space-y-6 shadow-xs">

    <div class="text-center space-y-3">
      <div class="wax-seal w-14 h-14 rounded-full mx-auto flex items-center justify-center text-[#FAF9F5] select-none shadow-xs">
        <%= tabler_icon("mail", size: 24) %>
      </div>
      <h1 class="font-serif-editorial text-3xl sm:text-4xl text-base-content font-semibold leading-tight">
        <%= t('sessions.title') %>
      </h1>
      <p class="text-xs font-letter text-base-content/60 leading-relaxed">
        <%= t('sessions.subtitle') %>
      </p>
    </div>

    <%= form_with model: @magic_link_form, url: login_path, local: true, class: "space-y-5" do |f| %>
      <% if @magic_link_form.errors.any? %>
        <div class="p-3.5 bg-error/10 border border-error/20 text-error text-xs rounded-xs space-y-1 animate-fade-in font-letter">
          <p class="font-semibold flex items-center gap-1.5">
            <%= tabler_icon("alert-triangle", size: 15) %> <%= t('sessions.error_header') || "Error:" %>
          </p>
          <ul class="list-disc list-inside opacity-90 pl-1">
            <% @magic_link_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-1.5">
        <%= f.label :email, t('sessions.label_email'), class: "text-[10px] font-letter font-semibold text-base-content/60 uppercase tracking-wider block" %>
        <%= f.email_field :email, placeholder: "you@example.com", class: "w-full paper-sheet rounded-xs px-3.5 py-2.5 text-xs font-letter text-base-content border border-[#D8D2C2] dark:border-[#2D3340] placeholder:text-base-content/50 focus:border-[#8E2818] focus:outline-none min-h-[44px]", required: true %>
      </div>

      <%= f.submit t('sessions.btn_submit'), class: "btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] w-full rounded-xs py-3 px-5 text-xs font-semibold tracking-widest uppercase shadow-xs border-none cursor-pointer font-letter min-h-[44px]" %>
    <% end %>

    <div class="text-center pt-2 border-t border-[#D8D2C2] dark:border-[#2D3340]">
      <a href="<%= root_path %>" class="text-xs font-letter font-semibold text-base-content/50 hover:text-base-content transition-colors uppercase tracking-wider inline-flex items-center gap-1.5">
        <%= tabler_icon("arrow-left", size: 13) %>
        <span><%= t('sessions.back_to_landing') %></span>
      </a>
    </div>
  </div>
</div>
