<div class="max-w-md mx-auto py-12">
  <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-10 rounded-box shadow-xs space-y-8">
    <div class="text-center space-y-3">
      <h1 class="font-serif italic text-3xl text-primary font-normal"><%= t('sessions.title') %></h1>
      <p class="text-sm text-base-content/60 leading-relaxed font-sans">
        <%= t('sessions.subtitle') %>
      </p>
    </div>

    <%= form_with model: @magic_link_form, url: login_path, local: true, class: "space-y-6" do |f| %>
      <% if @magic_link_form.errors.any? %>
        <div class="p-4 bg-error/10 border border-error/20 text-error text-xs rounded-xl space-y-1">
          <p class="font-semibold"><%= t('sessions.error_header') %></p>
          <ul class="list-disc list-inside">
            <% @magic_link_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :email, t('sessions.label_email'), class: "block text-xs font-semibold text-primary uppercase tracking-wider" %>
        <%= f.email_field :email, placeholder: "you@example.com", class: "input input-bordered w-full focus:border-primary/50 focus:ring-2 focus:ring-primary/10 hover:border-base-400 focus:outline-none transition-all duration-200 rounded-xl bg-white border-base-300 shadow-2xs font-sans", required: true %>
      </div>

      <%= f.submit t('sessions.btn_submit'), class: "btn btn-primary w-full rounded-xl text-xs font-semibold tracking-wider uppercase shadow-xs py-3.5 cursor-pointer" %>
    <% end %>

    <div class="text-center pt-2">
      <a href="<%= root_path %>" class="btn btn-link btn-xs text-primary hover:text-neutral font-semibold no-underline">
        <%= t('sessions.back_to_landing').html_safe %>
      </a>
    </div>
  </div>
</div>

