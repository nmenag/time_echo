<div class="max-w-md mx-auto py-12 font-sans select-none animate-fade-in">
  <div class="card card-bordered border-base-200 bg-base-100 p-8 sm:p-10 rounded-2xl shadow-xs space-y-8 relative overflow-hidden text-base-content">
    
    <!-- Dynamic subtle backing glow using brand OKLCH tokens -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="text-center space-y-3 relative">
      <div class="text-2xl mb-1 select-none">✨</div>
      <h1 class="font-serif italic text-3xl sm:text-4xl text-primary font-normal leading-tight">
        <%= t('sessions.title') %>
      </h1>
      <p class="text-xs text-base-content/50 leading-relaxed font-semibold font-sans">
        <%= t('sessions.subtitle') %>
      </p>
    </div>

    <%= form_with model: @magic_link_form, url: login_path, local: true, class: "space-y-6 relative" do |f| %>
      <% if @magic_link_form.errors.any? %>
        <!-- Premium Soft Crimson warning banner -->
        <div class="p-4 bg-error/10 border border-error/20 text-error text-xs rounded-xl space-y-1 animate-fade-in font-semibold shadow-3xs">
          <p class="font-bold flex items-center gap-1.5 font-sans">
            <span>⚠️</span> <%= t('sessions.error_header') || "Error:" %>
          </p>
          <ul class="list-disc list-inside opacity-90 pl-1 font-sans">
            <% @magic_link_form.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :email, t('sessions.label_email'), class: "text-[10px] font-semibold text-base-content/40 uppercase tracking-wider block" %>
        <%= f.email_field :email, placeholder: "you@example.com", class: "input input-bordered w-full rounded-xl bg-base-200/20 text-base-content border-base-200 placeholder:text-base-content/30 text-sm hover:bg-base-200/40 hover:border-base-300 focus:bg-base-100 focus:border-brand focus:ring-2 focus:ring-brand/10 focus:outline-none transition-all shadow-xs min-h-[44px]", required: true %>
      </div>

      <%= f.submit t('sessions.btn_submit'), class: "btn w-full text-white rounded-xl py-3 px-5 text-xs font-semibold uppercase tracking-wider shadow-sm transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] border-none cursor-pointer font-sans", style: "background-color: oklch(40% 0.22 290); --btn-color: oklch(40% 0.22 290);" %>
    <% end %>

    <div class="text-center pt-2 relative border-t border-base-200/60">
      <a href="<%= root_path %>" class="text-[10px] font-semibold text-base-content/40 hover:text-brand transition-colors duration-200 uppercase tracking-wider flex items-center justify-center gap-1.5">
        <span>&larr;</span> <%= t('sessions.back_to_landing') || "Volver al inicio" %>
      </a>
    </div>
  </div>
</div>
