<div class="max-w-md mx-auto py-12 text-center">
  <div class="bg-white border border-warm-gray-200/60 p-12 rounded-2xl shadow-sm space-y-6">
    <div class="w-16 h-16 bg-warm-gray-200/40 text-warm-gray-800 rounded-full flex items-center justify-center text-3xl mx-auto animate-pulse">
      ✉️
    </div>

    <div class="space-y-3">
      <h1 class="font-serif italic text-3xl text-warm-gray-900">Check your inbox</h1>
      <p class="text-sm text-warm-gray-500 leading-relaxed">
        We have dispatched a magic login link to<br>
        <strong class="text-warm-gray-800"><%= @email %></strong>.
      </p>
    </div>

    <p class="text-xs text-warm-gray-500 max-w-xs mx-auto leading-relaxed">
      Please check your spam or promotions folder if the email does not arrive in a couple of minutes.
    </p>

    <div class="pt-4 border-t border-warm-gray-100 space-y-3">
      <a href="<%= login_path %>" class="text-xs font-semibold text-warm-gray-800 hover:underline">
        Try another email address &rarr;
      </a>
    </div>
  </div>
</div>
