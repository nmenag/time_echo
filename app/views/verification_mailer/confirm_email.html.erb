<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <span style="display: inline-block; border: 1px dashed #2C485E; color: #2C485E; font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 11px; padding: 4px 10px; text-transform: uppercase; letter-spacing: 0.14em; border-radius: 2px;">
        [ <%= t('mailers.common.email_update_badge') %> ]
      </span>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 18px; padding-bottom: 12px;">
      <h1 style="margin: 0; font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: 600; line-height: 1.35; color: #1A1A1A;">
        <%= t('mailers.confirm_email.header') %>
      </h1>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 8px; padding-bottom: 16px;">
      <p style="margin: 0 0 14px 0; font-family: 'IBM Plex Sans', -apple-system, sans-serif; font-size: 15px; line-height: 1.6; color: #3D3A36;">
        <%= t('mailers.confirm_email.greeting') %>
      </p>
      <p style="margin: 0; font-family: 'IBM Plex Sans', -apple-system, sans-serif; font-size: 15px; line-height: 1.6; color: #3D3A36;">
        <%= t('mailers.confirm_email.body', old_email: @old_email, new_email: @new_email) %>
      </p>
    </td>
  </tr>
  <tr>
    <td>
      <div style="background-color: #EFECE3; border: 1px solid #D8D2C2; border-radius: 4px; padding: 14px 18px; margin: 8px 0 20px 0; font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 13px; color: #2C485E;">
        <span style="color: #7A7268;"><%= @old_email %></span>
        <span style="margin: 0 8px; color: #8E2818;">&rarr;</span>
        <strong><%= @new_email %></strong>
      </div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding-top: 12px; padding-bottom: 24px;">
      <a class="btn-carmine mobile-btn" href="<%= @confirm_url %>">
        <%= t('mailers.confirm_email.btn') %>
      </a>
    </td>
  </tr>
  <tr>
    <td>
      <div style="background-color: #EFECE3; border: 1px dashed #D8D2C2; border-radius: 4px; padding: 14px 18px; font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 12px; line-height: 1.6; color: #6B7280;">
        <%= t('mailers.confirm_email.expiry_help') %>
      </div>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 24px; border-top: 1px solid #D8D2C2; margin-top: 24px;">
      <div style="font-family: 'IBM Plex Sans', -apple-system, sans-serif; font-size: 12px; line-height: 1.5; color: #7A7268; text-align: center;">
        <strong><%= t('brand') %></strong> &middot; <%= t('mailers.magic_link.footer_subtitle') %>
      </div>
    </td>
  </tr>
</table>
